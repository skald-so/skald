# Caddy of the self-host stack, docker-compose.yml, on $SKALD_SITE: the domain, with a certificate
# from Let's Encrypt and HTTP redirected to HTTPS, or plain HTTP behind the admin's proxy
# (docs/self-host.md, "Behind your reverse proxy"). The paths of the OpenAPI spec, api/openapi.json,
# go to the server, HTTPS and WebSocket; every other path to the web app in the stack's directory,
# an unknown one to its index page.
{$SKALD_SITE} {
	@server {
		path /account/anchors /account/devices /account/links /account/links/* /account/master
		path /account/personal-space /account/revocations
		path /account/sessions /account/sessions/end-others /account/sessions/*
		path /account/sign-in-methods /account/sign-in-methods/* /account/usage /account/username
		path /auth/device /auth/github /auth/github/callback /auth/github/link /auth/google
		path /auth/google/callback /auth/google/link /auth/providers /auth/token /device /devices
		path /devices/*/cert /devices/*/challenge /devices/*/key-packages /devices/*/session /health
		path /key-packages /links /links/messages /mailbox/ack
		path /mailbox/events /mailbox/poll /mailbox/send /openapi.json /protocol /server
		path /service-token /session /session/challenge
		path /sign-in-methods /spaces /spaces/*/channels /spaces/*/channels/*/group-info
		path /spaces/*/channels/*/history/entries /spaces/*/channels/*/history/links
		path /spaces/*/channels/*/history/wraps /spaces/*/channels/*/presence /spaces/*/devices
		path /spaces/*/channels/*/queues /spaces/*/channels/*/queues/*
		path /spaces/*/channels/*/queues/*/claims /spaces/*/channels/*/queues/*/tasks
		path /spaces/*/channels/*/queues/*/tasks/* /spaces/*/channels/*/queues/*/tasks/*/*
		path /spaces/*/members
		path /spaces/*/revisions /spaces/*/service-grants /spaces/*/service-tokens
		path /spaces/*/service-tokens/* /spaces/*/usage
		path /ws
	}
	handle @server {
		reverse_proxy skald-server:8080
	}

	# The web app: only its own origin, never in a frame; its pages revalidated, so an upgrade shows
	# at once.
	handle {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
