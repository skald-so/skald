#!/usr/bin/env node
// Tests the build of the website and docs, site/build.mjs, after npm ci in site/:
//   - docs/ builds, with a page for each of its Markdown files, a docs start page at /start that
//     links to every page, the main page at /, and the privacy policy at /privacy with each of its
//     sections and the contact address;
//   - the main page's links: Docs, Get started and Read the docs to the docs start page, GitHub to
//     the repository, Sign in to the cloud's web app, the first point to "The server sees" of the
//     threat model, Security to the threat model, Privacy to the privacy policy, Trademarks to
//     TRADEMARKS.md on GitHub at SKALD_SITE_REF, and the mail address; its only command is the
//     README's npm install; each bundled font's license ships with the build; the docs' title leads
//     to it outside VitePress's router;
//   - on a scratch repository: a README.md is its directory's page; the docs start page links to
//     every page, unless docs/start.md replaces it; a heading gets GitHub's ID, which a link to it
//     from another page resolves to; a link to a file outside docs/ goes to it on GitHub at
//     SKALD_SITE_REF, main by default, a directory as a tree; a file git ignores is not built;
//   - the build fails, naming the link, on a link to a missing page, to a missing heading of a page,
//     to a missing file outside docs/ or a missing heading of one, and to a path outside the
//     repository; and, naming the file, on a page of docs/ at /, where the main page is.
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { reporter } from './lib/report.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const { fail, done } = reporter('site-test');
const tmp = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'site-test.')));
process.on('exit', () => fs.rmSync(tmp, { recursive: true, force: true }));
let builds = 0;

// build <docs> [<env>]: builds <docs> into a new directory; {status, output, out}.
const build = (docs, env = {}) => {
  const out = path.join(tmp, `out-${++builds}`);
  const run = spawnSync('node', [path.join(root, 'site/build.mjs'), out, ...(docs ? [docs] : [])], {
    encoding: 'utf8',
    env: { PATH: process.env.PATH, HOME: process.env.HOME, TMPDIR: tmp, ...env },
  });
  return { status: run.status, output: `${run.stdout}${run.stderr}`, out };
};
const read = (file) => (fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '');

// docs/ itself.
{
  const { status, output, out } = build();
  if (status !== 0) fail(`docs/ does not build: ${output.trim().split('\n').slice(-5).join(' | ')}`);
  else {
    const listed = spawnSync('git', ['ls-files', '--cached', '--others', '--exclude-standard', '--', 'docs/*.md'], { cwd: root, encoding: 'utf8' });
    for (const file of listed.stdout.split('\n').filter(Boolean)) {
      const page = file.replace(/^docs\//, '').replace(/(^|\/)README\.md$/, '$1index.md').replace(/\.md$/, '.html');
      if (!fs.existsSync(path.join(out, page))) fail(`the site has no page ${page} for ${file}`);
    }
    const privacy = read(path.join(out, 'privacy.html'));
    if (privacy === '') fail('the site has no privacy policy at /privacy, privacy.html');
    else {
      const sections = [
        'who-runs-the-cloud',
        'what-the-cloud-keeps',
        'sign-in',
        'github',
        'google',
        'how-the-cloud-uses-it',
        'cookies-and-browser-storage',
        'who-else-processes-data',
        'how-long-the-cloud-keeps-data',
        'legal-basis',
        'transfers',
        'your-rights',
        'deletion-and-other-requests',
        'changes',
      ];
      for (const id of sections) if (!privacy.includes(`id="${id}"`)) fail(`the privacy policy has no section ${id}`);
      if (!privacy.includes('href="mailto:info@skald.so"')) fail('the privacy policy has no link to info@skald.so');
    }
    const start = read(path.join(out, 'start.html'));
    for (const file of listed.stdout.split('\n').filter(Boolean)) {
      const link = `href="./${file.replace(/^docs\//, '').replace(/(^|\/)README\.md$/, '$1').replace(/\.md$/, '')}"`;
      if (!start.includes(link)) fail(`the docs start page, start.html, has no link ${link} to ${file}`);
    }
    mainPage(out, 'main');
    if (!read(path.join(out, 'threat-model.html')).includes('<a class="title" href="/" target="_self"')) {
      fail("a docs page's title does not lead to the main page outside VitePress's router: no target");
    }
  }
}
{
  const { status, output, out } = build(undefined, { SKALD_SITE_REF: 'v1.2.3' });
  if (status !== 0) fail(`docs/ does not build with SKALD_SITE_REF: ${output.trim().split('\n').slice(-3).join(' | ')}`);
  else if (!read(path.join(out, 'index.html')).includes('href="https://github.com/skald-so/skald/blob/v1.2.3/TRADEMARKS.md"')) {
    fail('with SKALD_SITE_REF=v1.2.3, the main page has no Trademarks link at v1.2.3');
  }
}

// mainPage <out> <ref>: checks the main page of the build in <out>, its links to files on GitHub at
// <ref>.
function mainPage(out, ref) {
  const html = read(path.join(out, 'index.html'));
  if (!html.includes('<h1>Encrypted messages and tasks for AI agents</h1>')) fail('index.html is not the main page');
  if (!/<title>Skald[:<]/.test(html) || !/<meta\s+name="description"\s+content="Skald[: ]/.test(html)) {
    fail("the main page's title or description does not name Skald");
  }
  const text = (part) => part.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  const links = [...html.matchAll(/<a\s[^>]*href="([^"]*)"[^>]*>([\s\S]*?)<\/a>/g)].map(([, href, label]) => `${text(label)} -> ${href}`);
  const github = 'https://github.com/skald-so/skald';
  const want = [
    'skald -> /',
    'Docs -> /start',
    `GitHub -> ${github}`,
    'Sign in -> https://app.skald.so',
    'Get started -> /start',
    'Read the docs -> /start',
    'What the server sees -> /threat-model#the-server-sees',
    'Docs -> /start',
    `GitHub -> ${github}`,
    'Security -> /threat-model',
    'Privacy -> /privacy',
    `Trademarks -> ${github}/blob/${ref}/TRADEMARKS.md`,
    'info@skald.so -> mailto:info@skald.so',
  ];
  if (JSON.stringify(links) !== JSON.stringify(want)) fail(`the main page's links are ${JSON.stringify(links)}, not ${JSON.stringify(want)}`);
  if (!fs.existsSync(path.join(root, 'TRADEMARKS.md'))) fail('the Trademarks link leads to no TRADEMARKS.md');
  // The build fails on a link to a missing page or heading, so these resolve: the page itself.
  if (!/<h2 id="the-server-sees"/.test(read(path.join(out, 'threat-model.html')))) fail('the threat model has no heading the-server-sees');

  const commands = [...html.matchAll(/<code>([^<]*)<\/code>/g)].map(([, command]) => command);
  if (JSON.stringify(commands) !== JSON.stringify(['npm install -g skald-so'])) fail(`the main page's commands are ${JSON.stringify(commands)}, not the npm install alone`);
  for (const command of commands) {
    if (!read(path.join(root, 'README.md')).includes(`\n${command}\n`)) fail(`README.md does not give the main page's command ${command}`);
  }

  const assets = fs.readdirSync(path.join(out, 'assets/main'));
  for (const font of ['inter', 'space-grotesk', 'jetbrains-mono']) {
    if (!assets.some((file) => file.startsWith(`${font}-`) && file.endsWith('.woff2'))) fail(`the main page bundles no ${font} font`);
    if (!read(path.join(out, 'fonts', font, 'LICENSE')).includes('SIL Open Font License')) fail(`the build has no license of the ${font} font, fonts/${font}/LICENSE`);
  }
  for (const file of assets.filter((file) => file.endsWith('.woff2'))) {
    if (!['inter', 'space-grotesk', 'jetbrains-mono'].some((font) => file.startsWith(`${font}-`))) fail(`the build has a font without its license: ${file}`);
  }
}

// A scratch repository.
const repo = path.join(tmp, 'repo');
const write = (file, text) => {
  fs.mkdirSync(path.dirname(path.join(repo, file)), { recursive: true });
  fs.writeFileSync(path.join(repo, file), text);
};
write('NOTES.md', '# Notes\n\n## Second part\n');
write('tools/run.sh', 'echo\n');
write('docs/.gitignore', 'private.md\n');
write('docs/private.md', '# Private\n');
write('docs/guide.md', '# Guide\n\n## 1. Install the `client`\n\nText.\n');
write('docs/sub/README.md', '# Sub\n\n[Guide step](../guide.md#1-install-the-client)\n');
write('docs/threat-model.md', '# Threat model\n\n## The server sees\n');
write('docs/privacy.md', '# Privacy policy\n');
const page = (links) => `# Links\n\n${links.map((link) => `- [link](${link})`).join('\n')}\n`;
const good = ['guide.md', 'sub/README.md', 'sub/README.md#sub', '../NOTES.md#second-part', '../tools', '../tools/run.sh', '#links'];
write('docs/links.md', page(good));
spawnSync('git', ['init', '--quiet'], { cwd: repo });
const docs = path.join(repo, 'docs');

{
  const { status, output, out } = build(docs);
  if (status !== 0) fail(`the scratch docs do not build: ${output.trim().split('\n').slice(-5).join(' | ')}`);
  else {
    const links = read(path.join(out, 'links.html'));
    const start = read(path.join(out, 'start.html'));
    for (const want of ['href="./guide"', 'href="./sub/"', 'href="./sub/#sub"']) {
      if (!links.includes(want)) fail(`links.html has no link ${want} to a page`);
    }
    for (const want of [
      'href="https://github.com/skald-so/skald/blob/main/NOTES.md#second-part"',
      'href="https://github.com/skald-so/skald/tree/main/tools"',
      'href="https://github.com/skald-so/skald/blob/main/tools/run.sh"',
    ]) {
      if (!links.includes(want)) fail(`links.html has no link ${want} to a file outside docs/ on GitHub`);
    }
    if (!fs.existsSync(path.join(out, 'sub/index.html'))) fail('sub/README.md is not the page sub/index.html');
    if (!read(path.join(out, 'guide.html')).includes('id="1-install-the-client"')) {
      fail("a heading of guide.html has no GitHub ID, 1-install-the-client");
    }
    for (const want of ['href="./guide"', 'href="./links"', 'href="./sub/"', 'href="./threat-model"']) {
      if (!start.includes(want)) fail(`the docs start page has no link ${want}`);
    }
    if (!read(path.join(out, 'index.html')).includes('<h1>Encrypted messages and tasks for AI agents</h1>')) fail('the scratch build has no main page');
    if (fs.existsSync(path.join(out, 'private.html'))) fail('a file git ignores, private.md, is built');
  }
}
{
  const { status, output, out } = build(docs, { SKALD_SITE_REF: 'v1.2.3' });
  const want = 'href="https://github.com/skald-so/skald/blob/v1.2.3/NOTES.md#second-part"';
  if (status !== 0) fail(`the scratch docs do not build with SKALD_SITE_REF: ${output.trim().split('\n').slice(-3).join(' | ')}`);
  else if (!read(path.join(out, 'links.html')).includes(want)) fail(`with SKALD_SITE_REF=v1.2.3, links.html has no link ${want}`);
}

// A docs/start.md is the docs start page; a page at / fails the build.
write('docs/start.md', '# Quick start\n');
{
  const { status, output, out } = build(docs);
  if (status !== 0) fail(`the scratch docs with start.md do not build: ${output.trim().split('\n').slice(-3).join(' | ')}`);
  else if (!read(path.join(out, 'start.html')).includes('<h1 id="quick-start"')) fail('docs/start.md is not the docs start page');
}
fs.rmSync(path.join(repo, 'docs/start.md'));
for (const file of ['docs/index.md', 'docs/README.md']) {
  write(file, '# Home\n');
  const { status, output } = build(docs);
  if (status === 0) fail(`a page at /, ${file}, builds`);
  else if (!output.includes(file.replace(/^docs\//, ''))) fail(`the build fails on a page at /, ${file}, without naming it: ${output.trim().split('\n').slice(-3).join(' | ')}`);
  fs.rmSync(path.join(repo, file));
}

// Broken links.
for (const link of ['missing.md', 'guide.md#missing', '#missing', 'sub/missing/README.md', '../MISSING.md', '../NOTES.md#missing', '../../outside.md']) {
  write('docs/links.md', page([...good, link]));
  const { status, output } = build(docs);
  if (status === 0) fail(`a link to ${link} builds`);
  else if (![link, link.replace(/\.md(?=#|$)/, ''), link.replace(/README\.md$/, '')].some((name) => output.includes(name))) {
    fail(`the build fails on a link to ${link} without naming it: ${output.trim().split('\n').slice(-3).join(' | ')}`);
  }
}

done();
