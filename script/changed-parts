#!/usr/bin/env bash
# Prints which parts of script/test the changes touch, as `<part>=true|false` lines for
# $GITHUB_OUTPUT. CI checks only those parts of a PR, and script/test with SKALD_TEST_SINCE only
# those of the working tree; script/test alone checks all of them. The paths and their parts:
#   crates/ (with the skald-server image definition), Cargo.toml, Cargo.lock: workspace, wasm,
#     image, repository
#   deny.toml: repository
#   prototypes/mls/, prototypes/agents/, prototypes/edits/: mls, agents and edits, each with
#     repository; prototypes/mls/Cargo.lock also wasm: the crates' WASM tests take its wasm-bindgen
#   any other path in prototypes/: every part of the Rust code, all but tooling and web
#   web/: web; its package.json and package-lock.json also workspace: the server's and the client's
#     sign-in tests drive Chrome with its playwright-core
#   docs/, Markdown files in the root: none
#   any other path: all; the OpenAPI spec, script/, .github/, renovate.json, new top-level paths
# The changes count from where HEAD branched off <base>, their merge base: commits <base> got later
# do not count. Usage, in the repository to check:
#   script/changed-parts <base>          the changes up to HEAD, as CI checks a PR
#   script/changed-parts --since <base>  the changes up to the working tree, uncommitted and
#                                        untracked files included
set -euo pipefail

# --no-renames lists both paths of a moved file. Unusual names stay quoted and check everything.
if [[ $# -eq 1 && $1 != -* ]]; then
  fork=$(git merge-base "$1" HEAD)
  paths=$(git -c core.quotePath=false diff --name-only --no-renames "$fork" HEAD)
elif [[ $# -eq 2 && $1 == --since ]]; then
  fork=$(git merge-base "$2" HEAD)
  paths=$(git -c core.quotePath=false diff --name-only --no-renames "$fork")
  untracked=$(git -c core.quotePath=false ls-files --others --exclude-standard --full-name :/)
  paths+=$'\n'$untracked
else
  echo "usage: $0 [--since] <base>" >&2
  exit 2
fi

parts='workspace wasm image mls agents edits repository tooling web'
for part in $parts; do printf -v "$part" false; done
# mark <part>...: the changes touch these parts.
mark() { for part in "$@"; do printf -v "$part" true; done; }

while IFS= read -r path; do
  if [[ -z $path ]]; then
    continue
  elif [[ $path == web/package.json || $path == web/package-lock.json ]]; then
    mark web workspace
  elif [[ $path == web/* ]]; then
    mark web
  elif [[ $path == crates/* || $path == Cargo.toml || $path == Cargo.lock ]]; then
    mark workspace wasm image repository
  elif [[ $path == deny.toml ]]; then
    mark repository
  elif [[ $path == prototypes/mls/Cargo.lock ]]; then
    mark mls wasm repository
  elif [[ $path == prototypes/mls/* ]]; then
    mark mls repository
  elif [[ $path == prototypes/agents/* ]]; then
    mark agents repository
  elif [[ $path == prototypes/edits/* ]]; then
    mark edits repository
  elif [[ $path == prototypes/* ]]; then
    mark workspace wasm image mls agents edits repository
  elif [[ $path == docs/* || ($path == *.md && $path != */*) ]]; then
    continue
  else
    # $parts unquoted: one word per part.
    mark $parts
  fi
done <<<"$paths"

for part in $parts; do echo "$part=${!part}"; done
