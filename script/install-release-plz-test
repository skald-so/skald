#!/usr/bin/env bash
# Tests script/install-release-plz with stand-ins for curl and cargo:
#   - a crate that does not match its SHA-256 fails the run, and nothing is built or installed;
#   - with crates that match their SHA-256, a copy of the script next to a script/lib/release.sh of
#     stand-in crates and a stand-in patch downloads them from crates.io, applies the patch to them
#     and runs `cargo install --locked` on the extracted release-plz crate into its directory;
#   - with the release-plz of script/lib/release.sh installed, it downloads and builds nothing, and in
#     a GitHub Actions job it puts that release-plz's directory on the PATH of the later steps;
#   - --cache-key prints the key of the build, with its version, its crates' versions and the
#     SHA-256 of the patch and of the script, and its directory, and installs nothing; a change to
#     the script alone changes the key.
# The download of the real crates, the patch and the build run in CI, before the release-plz tests.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export CARGO_HOME=$tmp/cargo
unset GITHUB_PATH
source "$root/script/lib/release.sh"
failures=0

fail() {
  echo "install-release-plz-test: $*" >&2
  failures=$((failures + 1))
}

# The stand-ins log their calls. curl saves the file under $tmp/served at the URL's path on
# static.crates.io, or else a file that is not the crate. cargo copies the directory that holds the
# crate of its --path, as the build sees it, to $tmp/built.
mkdir "$tmp/bin" "$tmp/served"
cat >"$tmp/bin/curl" <<EOF
#!/usr/bin/env bash
echo "curl \$*" >>"$tmp/calls.log"
while [[ \$# -gt 0 ]]; do
  case \$1 in
    --output) output=\$2; shift ;;
    https://static.crates.io/*) url=\$1 ;;
  esac
  shift
done
served=$tmp/served/\${url#https://static.crates.io/}
if [[ -f \$served ]]; then cp "\$served" "\$output"; else echo "not the crate" >"\$output"; fi
EOF
cat >"$tmp/bin/cargo" <<EOF
#!/usr/bin/env bash
echo "cargo \$*" >>"$tmp/calls.log"
while [[ \$# -gt 0 ]]; do
  [[ \$1 != --path ]] || cp -R "\$(dirname "\$2")" "$tmp/built"
  shift
done
EOF
chmod +x "$tmp/bin/curl" "$tmp/bin/cargo"

# run_install [<option>]: runs script/install-release-plz; sets $status and $output.
run_install() {
  rm -f "$tmp/calls.log"
  status=0
  output=$(PATH="$tmp/bin:$PATH" "$root/script/install-release-plz" "$@" 2>&1) || status=$?
}

case="the cache key"
run_install --cache-key
[[ $status == 0 ]] || fail "$case: the run fails: $output"
key=$(sed -n 's/^key=//p' <<<"$output")
patch_sum=$(openssl dgst -sha256 -r "$root/script/lib/release-plz.patch")
parts=("$release_plz_version" "${patch_sum%% *}")
for crate in "${release_plz_crates[@]}"; do
  read -r name version _ <<<"$crate"
  parts+=("$name-$version")
done
script_sum=$(openssl dgst -sha256 -r "$root/script/install-release-plz")
parts+=("${script_sum%% *}")
for part in "${parts[@]}"; do
  [[ $key == *"$part"* ]] || fail "$case: the key does not name $part: $output"
done
[[ $(grep -c . <<<"$output") == 2 && $(sed -n 's/^path=//p' <<<"$output") == "$release_plz_root" ]] ||
  fail "$case: it does not print the key and the path $release_plz_root alone: $output"
[[ ! -e $tmp/calls.log && ! -e $release_plz_root ]] || fail "$case: it downloads, builds or installs"

case="a crate that does not match its SHA-256"
run_install
[[ $status != 0 ]] || fail "$case: the run passes"
grep -qF "does not match its SHA-256" <<<"$output" || fail "$case: it does not say so: $output"
! grep -q '^cargo' "$tmp/calls.log" 2>/dev/null || fail "$case: it runs cargo: $(cat "$tmp/calls.log")"
[[ ! -e $release_plz_root/bin/release-plz ]] || fail "$case: it installs release-plz"

# A copy of the script next to a script/lib/release.sh of two stand-in crates and a stand-in patch
# that changes a file of the second one.
case="crates that match their SHA-256"
copy=$tmp/copy
mkdir -p "$copy/script/lib" "$tmp/crates/standin-plz-1.2.3/src" "$tmp/crates/standin_core-4.5.6/src"
cp "$root/script/install-release-plz" "$copy/script/"
echo "the release-plz crate" >"$tmp/crates/standin-plz-1.2.3/src/main.rs"
echo "unpatched" >"$tmp/crates/standin_core-4.5.6/src/lib.rs"
crates=()
for crate in standin-plz/1.2.3 standin_core/4.5.6; do
  name=${crate%/*} version=${crate#*/}
  mkdir -p "$tmp/served/crates/$name"
  file=$tmp/served/crates/$name/$name-$version.crate
  tar -czf "$file" -C "$tmp/crates" "$name-$version"
  sum=$(openssl dgst -sha256 -r "$file")
  crates+=("\"$name $version ${sum%% *}\"")
done
cat >"$copy/script/lib/release.sh" <<EOF
release_plz_version=1.2.3+standin.1
release_plz_crates=(${crates[*]})
release_plz_root=$tmp/standin-root
EOF
cat >"$copy/script/lib/release-plz.patch" <<'EOF'
--- a/standin_core-4.5.6/src/lib.rs
+++ b/standin_core-4.5.6/src/lib.rs
@@ -1 +1 @@
-unpatched
+patched
EOF
run_install_copy() {
  rm -f "$tmp/calls.log"
  status=0
  output=$(PATH="$tmp/bin:$PATH" "$copy/script/install-release-plz" "$@" 2>&1) || status=$?
}
run_install_copy
[[ $status == 0 ]] || fail "$case: the run fails: $output"
for crate in standin-plz/1.2.3 standin_core/4.5.6; do
  name=${crate%/*} version=${crate#*/}
  grep -qF "https://static.crates.io/crates/$name/$name-$version.crate" "$tmp/calls.log" ||
    fail "$case: it does not download $name $version from crates.io: $(cat "$tmp/calls.log")"
done
cargo_calls=$(grep '^cargo' "$tmp/calls.log" || true)
read -r -a args <<<"${cargo_calls#cargo }"
locked=no root_arg="" path_arg=""
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[i]} in
    --locked) locked=yes ;;
    --root) root_arg=${args[i + 1]:-} ;;
    --path) path_arg=${args[i + 1]:-} ;;
  esac
done
[[ $(grep -c . <<<"$cargo_calls") == 1 && ${args[0]:-} == install && $locked == yes ]] ||
  fail "$case: cargo does not get one \`install --locked\`: $cargo_calls"
[[ $root_arg == "$tmp/standin-root" ]] ||
  fail "$case: cargo does not get --root $tmp/standin-root: $cargo_calls"
[[ $(basename "$path_arg") == standin-plz-1.2.3 &&
  $(cat "$tmp/built/standin-plz-1.2.3/src/main.rs" 2>/dev/null) == "the release-plz crate" ]] ||
  fail "$case: cargo does not get --path of the extracted release-plz crate: $cargo_calls"
[[ $(cat "$tmp/built/standin_core-4.5.6/src/lib.rs" 2>/dev/null) == patched ]] ||
  fail "$case: the build does not see the patch applied"

case="a change to the script alone"
run_install_copy --cache-key
key=$(sed -n 's/^key=//p' <<<"$output")
echo "# a change" >>"$copy/script/install-release-plz"
run_install_copy --cache-key
[[ -n $key && $(sed -n 's/^key=//p' <<<"$output") != "$key" ]] || fail "$case: it keeps the cache key"

case="release-plz $release_plz_version installed already"
mkdir -p "$release_plz_root/bin"
printf '#!/usr/bin/env bash\necho "release-plz %s"\n' "$release_plz_version" \
  >"$release_plz_root/bin/release-plz"
chmod +x "$release_plz_root/bin/release-plz"
export GITHUB_PATH=$tmp/github-path
run_install
[[ $status == 0 ]] || fail "$case: the run fails: $output"
[[ ! -s $tmp/calls.log ]] || fail "$case: it downloads or builds: $(cat "$tmp/calls.log")"
[[ $(cat "$GITHUB_PATH" 2>/dev/null) == "$release_plz_root/bin" ]] ||
  fail "$case: GITHUB_PATH does not have $release_plz_root/bin alone: $(cat "$GITHUB_PATH" 2>/dev/null)"

if ((failures > 0)); then
  echo "install-release-plz-test: $failures case(s) failed" >&2
  exit 1
fi
echo "install-release-plz-test: all cases passed"
