#!/usr/bin/env bash
# Checks a server's GitHub sign-in without a person, in these steps, each only after the one before
# passed:
#   device authorization  POST <server>/auth/device gives a user code, a device code and a
#                         verification page on that server
#   verification page     the page, without a session, links "Sign in with GitHub" to that server,
#                         and the link sends the browser to $GITHUB_URL/login/oauth/authorize with
#                         <client ID> and the callback <server>/auth/github/callback
#   polling               POST <server>/auth/token with the new device code answers
#                         authorization_pending
# GitHub's address is $GITHUB_URL, https://github.com by default; the check never contacts it.
# Prints a line `<step>: pass` or `<step>: fail: <reason>` per step it runs, then `pass` or `fail`;
# never a code the server gave, nor curl's own messages. Exits 0 only when every step passes, 1 when
# one fails, 2 on wrong usage.
# Makes its own HTTPS requests with curl, which checks the server's certificate.
# crates/server/tests/github_sign_in_check.rs tests it.
# Usage: script/check-github-sign-in <server address> <client ID>
set -euo pipefail

source "$(dirname "$0")/lib/sign-in-check.sh"
check_start check-github-sign-in "$@"

github=${GITHUB_URL:-https://github.com}
if [[ ! $github =~ $url_parts ]]; then
  echo "check-github-sign-in: GITHUB_URL is not a URL" >&2
  exit 2
fi
authorize=$(origin "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")${BASH_REMATCH[3]%/}/login/oauth/authorize

verification_page() {
  sign_in_start 'Sign in with GitHub' '"Sign in with GitHub" link' "$authorize" \
    /auth/github/callback
}

polling() {
  local status
  jq -j --arg client "$machine" '"grant_type=" + ("urn:ietf:params:oauth:grant-type:device_code" | @uri)
    + "&device_code=" + (.device_code | @uri) + "&client_id=" + ($client | @uri)' \
    "$tmp/device" >"$tmp/poll-form"
  status=$(request poll --header "$version" --data-binary @"$tmp/poll-form" \
    "$server/auth/token" </dev/null) || {
    echo "no answer from $server/auth/token"
    return 1
  }
  local error
  # Only an error code of letters and underscores is printed: the answer is the server's.
  error=$(jq -r 'objects | .error | strings | select(test("^[a-z_]{1,40}$"))' "$tmp/poll" \
    2>/dev/null) || true
  [[ $status == 400 && $error == authorization_pending ]] || {
    echo "HTTP $status${error:+ with $error} from $server/auth/token, not authorization_pending"
    return 1
  }
}

run_steps device_authorization verification_page polling
