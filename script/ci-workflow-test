#!/usr/bin/env node
// Tests .github/workflows/ci.yml:
//   - it runs on a PR into dev, and on every push to dev, whatever the push changes; the pushes to
//     dev share a concurrency group, which no PR shares, and a push's run cancels no running run;
//     a PR's run is in the PR's group and cancels the PR's older run;
//   - the checks the ruleset of dev requires, Changed parts, Rust, Tooling, Web and Site, are each
//     the name of one job;
//   - each check script/test runs, run with stand-ins for its scripts and tools
//     (script/lib/test-stand-ins.sh), runs in exactly one of the jobs that run script/test, by their
//     SKALD_TEST_PARTS: none is left out and none runs twice; installing the packages of web/ and
//     Chrome Headless Shell is setup, not a check;
//   - each part script/changed-parts prints is an output of its job and the part of one job; those
//     jobs need only the job of script/changed-parts; on a PR one runs exactly when one of its parts
//     changed, whatever the other parts, and on a push to dev it runs;
//   - the part self-host runs alone in a job of its own, which the job Rust needs;
//   - the job Rust needs the job of script/changed-parts and every job that runs script/test and is
//     not a required check itself; it runs whatever their results, a cancelled run's too, and fails
//     unless the job of script/changed-parts succeeded and each other one succeeded or was skipped;
//   - the jobs Rust needs that run script/test set up the same tools: their steps differ only in the
//     Cargo workspaces they cache, in SKALD_TEST_PARTS and in NEXTEST_TEST_THREADS;
//   - NEXTEST_TEST_THREADS of a step that runs script/test is a whole number of tests at once, and
//     neither CI nor a job or step of it that runs script/test sets NEXTEST_PROFILE, NEXTEST_RETRIES,
//     CARGO_PROFILE_*, RUSTFLAGS or CARGO_ENCODED_RUSTFLAGS: every test runs, once, as script/test
//     builds it;
//   - the jobs of the parts web and site upload the screenshots that differ from their references,
//     web/kit-diff/ and site/references-diff/, after their tests fail;
//   - every action of the workflow, and of the local actions it runs, is pinned to a commit, a
//     checkout keeps no credentials, and a job's token reads contents at most.
// And .github/workflows/client-windows.yml, with the job that runs the client's and the adapters'
// tests on Windows, which no job of CI runs:
//   - every PR into dev and every push to dev start it, whatever they change, a PR also when it gets
//     a label; a PR's run cancels the PR's older run, a push's run cancels none, and no two PRs or a
//     PR and dev share a concurrency group; its tokens read contents at most, its actions are
//     pinned and its checkouts keep no credentials;
//   - a job writes what script/changed-parts HEAD^1 prints to its outputs; the tests on Windows
//     need only it and run on a PR exactly when its workspace output is true and the PR has the
//     label ready-to-merge, whatever its other labels, and on a push to dev;
//   - the check Rust on Windows, which dev requires: on a push to dev, or on a PR that has the
//     label or whose workspace output is not true, one job of that name runs whatever the tests
//     end with, and passes only when job changes succeeded and the tests succeeded, or were skipped
//     with the workspace output not true; on a PR without the label whose workspace output is
//     true, the tests are skipped and no job is named Rust on Windows, so the check is missing;
//   - one job of a PR with the label runs `cargo nextest run -p skald-client -p skald-adapters --locked
//     --no-fail-fast`, with no other option but --test-threads, on a windows-2025 runner, in a step
//     that may run and whose failure fails the job: every test of the client and the adapters, none
//     left out (neither has doctests);
//   - the job writes .cargo/config.toml only by copying to it a Cargo config file of the repository
//     that sets only optimization levels, and sets no NEXTEST_PROFILE, NEXTEST_RETRIES,
//     CARGO_PROFILE_*, RUSTFLAGS or CARGO_ENCODED_RUSTFLAGS: debug assertions and overflow checks
//     stay as Cargo.toml sets them, and nextest runs its default profile;
//   - .config/nextest.toml sets no default-filter, which would leave tests out, and no retries,
//     which would pass a flaky test;
//   - alone() is called only directly in top-level #[test] fns of the crates' test files, and each
//     such test matches an override of .config/nextest.toml,
//     `package(<package>) & binary(<binary>) & test(=<path>)`, that sets threads-required =
//     'num-test-threads': under nextest, alone() holds back no other test's process;
//   - that command is the last of the step, in a standard shell: under pwsh a step's exit code is its
//     last command's, so a command after it would hide a failing test;
//   - before it starts PostgreSQL, it sets fsync = off and max_connections = 500 in
//     $env:PGDATA\postgresql.conf, as script/lib/postgres.sh sets the tests' PostgreSQL;
//   - before the tests, it starts the runner image's PostgreSQL service and waits for it, installs
//     the packages of web/ and then, with their playwright-core, Chrome Headless Shell, which that
//     playwright-core drives; the tests get the server through SKALD_TEST_DATABASE_URL;
//   - it, and each job of script/test's parts workspace and web, restores Playwright's browsers from
//     the Actions cache before its tests, from where playwright-core keeps them on the runner's OS;
//   - its test step sets SKALD_TEST_REAL_KEY_STORAGE=1, so a test uses the runner's Credential
//     Manager; no other job of any workflow and no script sets it;
//   - a process started before the tests samples the ephemeral ports in use into ports.txt, whose
//     path the test step gives the tests in SKALD_TEST_PORT_SAMPLES; a step after the tests, also
//     when they fail, prints the samples with the most;
//   - a step after the tests, when they fail, prints the failures in PostgreSQL's log;
//   - a step after the tests, also when they fail, fails the job when they left a skald-update-* or
//     skald-client-* directory in the temporary directory.
import { execFileSync, spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import {
  commands,
  condition,
  event,
  isUnknown,
  jobsFor,
  needsOf,
  open,
  permissions,
  readWorkflow,
  runsFor,
  stepSkipped,
  template,
  toText,
  triggers,
  truth,
  unknown,
  words,
} from './lib/workflows.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const ciFile = '.github/workflows/ci.yml';
const ci = readWorkflow(path.join(root, ciFile));
let failures = 0;
const fail = (what) => {
  console.error(`ci-workflow-test: ${what}`);
  failures++;
};
const done = () => {
  if (failures > 0) {
    console.error(`ci-workflow-test: ${failures} case(s) failed`);
    process.exit(1);
  }
  console.log('ci-workflow-test: all cases passed');
};

const jobs = ci.jobs ?? {};
const nameOf = (key) => jobs[key]?.name ?? key;
const pr = event('pull_request', 'refs/pull/7/merge');
const push = event('push', 'refs/heads/dev');

// The events and the concurrency groups.
if (!runsFor(ci, pr)) fail('a PR into dev does not run CI');
if (!runsFor(ci, push)) fail('a push to dev does not run CI');
const onPush = triggers(ci).push ?? {};
if (onPush.paths !== undefined || onPush['paths-ignore'] !== undefined) fail('a push to dev runs CI only for some paths');
// concurrency <event> <commit> [<PR number>]: the run's group and whether it cancels the group's
// older run.
const concurrency = (ev, sha, number) => {
  const payload = number === undefined ? ev.github.event : open({ ...ev.github.event, number, pull_request: open({ ...ev.github.event.pull_request, number }) });
  const github = open({ ...ev.github, workflow: ci.name, sha, event: payload });
  const scope = { contexts: { github, inputs: {} }, status: {} };
  const config = typeof ci.concurrency === 'object' ? ci.concurrency : { group: ci.concurrency };
  return { group: template(config?.group, scope), cancels: truth(template(config?.['cancel-in-progress'] ?? false, scope)) };
};
const [first, second] = [concurrency(push, 'a'.repeat(40)), concurrency(push, 'b'.repeat(40))];
const [prRun, prRerun, otherPr] = [concurrency(pr, 'c'.repeat(40), 7), concurrency(pr, 'd'.repeat(40), 7), concurrency(pr, 'e'.repeat(40), 8)];
if ([first, second, prRun, prRerun, otherPr].some((run) => run.group === undefined || isUnknown(run.group))) {
  fail('the concurrency group of a run cannot be told from its event');
} else {
  if (first.group !== second.group) fail('two pushes to dev are in different concurrency groups');
  if ([prRun, otherPr].some((run) => run.group === first.group)) fail(`a PR shares the concurrency group of a push to dev: ${first.group}`);
  if (prRun.group !== prRerun.group) fail('two pushes to a PR are in different concurrency groups');
  if (prRun.group === otherPr.group) fail(`two PRs share the concurrency group ${prRun.group}`);
}
if (first.cancels !== false) fail("a push to dev's run cancels the older run of its group");
if (prRun.cancels !== true) fail("a PR's run does not cancel the PR's older run");

// The checks the ruleset of dev requires (docs/dev/infrastructure.md, "Branches").
const required = ['Changed parts', 'Rust', 'Tooling', 'Web', 'Site'];
for (const name of required) {
  const named = Object.keys(jobs).filter((key) => nameOf(key) === name);
  if (named.length !== 1) fail(`not one job is named ${name}, a check dev requires: ${named.join(', ') || 'none'}`);
}

// The jobs that run script/test, each with its parts.
const runsTest = (step) => commands(step.run).some((line) => /(^|[\s;&|(])(\.\/)?script\/test(\s|$)/.test(line));
const testJobs = Object.entries(jobs)
  .filter(([, job]) => (job.steps ?? []).some(runsTest))
  .map(([key, job]) => {
    const steps = job.steps.filter(runsTest);
    if (steps.length !== 1) fail(`job ${key} runs script/test in ${steps.length} steps, not one`);
    const parts = String(steps[0].env?.SKALD_TEST_PARTS ?? '');
    if (parts.trim() === '') fail(`job ${key} runs script/test without SKALD_TEST_PARTS: every part, which other jobs run too`);
    if (steps[0].if !== undefined || steps[0]['continue-on-error'] || job['continue-on-error']) {
      fail(`job ${key} may skip script/test or pass when it fails`);
    }
    return { key, job, parts: parts.split(/\s+/).filter(Boolean) };
  });

// Each check of script/test in exactly one job: script/test with stand-ins, alone and with each
// job's parts.
const standIns = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'ci-workflow-test.')));
process.on('exit', () => fs.rmSync(standIns, { recursive: true, force: true }));
execFileSync('bash', ['-c', 'source "$1" && test_stand_ins "$2"', 'bash', path.join(root, 'script/lib/test-stand-ins.sh'), standIns], {
  stdio: ['ignore', 'ignore', 'inherit'],
});
const setup = new Set(['web\tnpm ci --no-audit --no-fund', '\tnode web/node_modules/playwright-core/cli.js install chromium-headless-shell']);
// checks <parts>: the checks script/test runs with SKALD_TEST_PARTS=<parts>, all without, or null
// when it fails.
const checks = (parts) => {
  const log = path.join(standIns, 'checks');
  fs.rmSync(log, { force: true });
  const env = { PATH: `${path.join(standIns, 'bin')}:${process.env.PATH}`, TMPDIR: os.tmpdir() };
  if (process.env.HOME) env.HOME = process.env.HOME;
  if (parts !== undefined) env.SKALD_TEST_PARTS = parts;
  const run = spawnSync(path.join(standIns, 'script/test'), [], { env, encoding: 'utf8' });
  if (run.status !== 0) {
    fail(`script/test${parts === undefined ? '' : ` with SKALD_TEST_PARTS=${parts}`} exits ${run.status}: ${run.stderr.trim()}`);
    return null;
  }
  return (fs.existsSync(log) ? fs.readFileSync(log, 'utf8') : '').split('\n').filter((line) => line !== '' && !setup.has(line));
};
const shown = (check) => (check.startsWith('\t') ? check.slice(1) : check.replace('\t', ': '));
const all = checks(undefined) ?? [];
if (all.length === 0) fail('script/test alone runs no check');
const runners = new Map();
for (const { key, parts } of testJobs) {
  for (const check of checks(parts.join(' ')) ?? []) runners.set(check, [...(runners.get(check) ?? []), key]);
}
const times = new Map();
for (const check of all) times.set(check, (times.get(check) ?? 0) + 1);
for (const [check, n] of times) {
  const by = runners.get(check) ?? [];
  if (by.length === 0) fail(`no job runs the check ${shown(check)}`);
  else if (by.length > n) fail(`the check ${shown(check)} runs ${by.length} times, in jobs ${by.join(', ')}; script/test alone runs it ${n} times`);
  else if (by.length < n) fail(`the jobs run the check ${shown(check)} ${by.length} times, script/test alone ${n} times`);
}
for (const [check, by] of runners) {
  if (!times.has(check)) fail(`job ${by.join(', ')} runs ${shown(check)}, which script/test alone does not`);
}

// The parts of script/changed-parts: outputs of its job, each the part of one job, and the gates.
const partsJob = Object.keys(jobs).find((k) => (jobs[k].steps ?? []).some((step) => commands(step.run).some((line) => /script\/changed-parts\b/.test(line))));
if (!partsJob) fail('no job runs script/changed-parts');
const printed = execFileSync(path.join(root, 'script/changed-parts'), ['HEAD'], { cwd: root, encoding: 'utf8' })
  .split('\n')
  .filter(Boolean)
  .map((line) => line.split('=')[0]);
if (partsJob) {
  const partsStep = jobs[partsJob].steps.find((step) => commands(step.run).some((line) => /script\/changed-parts\b/.test(line)));
  const outputs = jobs[partsJob].outputs ?? {};
  for (const part of printed) {
    if (String(outputs[part] ?? '').replace(/\s+/g, '') !== `\${{steps.${partsStep.id}.outputs.${part}}}`) {
      fail(`job ${partsJob} does not output the part ${part} that script/changed-parts prints`);
    }
  }
  if (!commands(partsStep.run).some((line) => /script\/changed-parts HEAD\^1 \| tee -a "\$GITHUB_OUTPUT"/.test(line)) || partsStep.shell !== 'bash') {
    fail(`job ${partsJob} does not write what script/changed-parts HEAD^1 prints to $GITHUB_OUTPUT, in bash`);
  }
  if (stepSkipped(partsStep, jobsFor(ci, pr)[partsJob])) fail(`job ${partsJob} skips script/changed-parts on a PR`);
}
// The parts script/test knows: it names them when it rejects an unknown one.
const rejected = spawnSync(path.join(standIns, 'script/test'), [], {
  env: { PATH: `${path.join(standIns, 'bin')}:${process.env.PATH}`, SKALD_TEST_PARTS: 'no-such-part' },
  encoding: 'utf8',
});
const known = (rejected.stderr.match(/parts: (.*)$/m)?.[1] ?? '').split(/\s+/).filter(Boolean);
if (rejected.status !== 2) fail(`script/test with an unknown part exits ${rejected.status}, not 2`);
if (JSON.stringify([...known].sort()) !== JSON.stringify([...printed].sort())) {
  fail(`script/test knows the parts ${known.join(' ') || 'none'}, script/changed-parts prints ${printed.join(' ')}`);
}
// A condition on a part script/test does not know never holds: its checks would never run. A
// variable in a condition is a list of parts, set once.
const testScript = fs.readFileSync(path.join(root, 'script/test'), 'utf8');
for (const line of testScript.split('\n')) {
  if (line.trim().startsWith('#')) continue;
  for (const m of line.matchAll(/(?:^|[\s;&|!(])checks(?:_any)?((?: +[$\w-]+)+)/g)) {
    for (const word of m[1].trim().split(/ +/)) {
      const list = word.startsWith('$') ? [...testScript.matchAll(new RegExp(`^${word.slice(1)}='([^']*)'$`, 'gm'))] : null;
      if (list && list.length !== 1) fail(`script/test sets the parts $${word.slice(1)} ${list.length} times, not once`);
      for (const part of list ? (list[0]?.[1] ?? '').split(/\s+/).filter(Boolean) : [word]) {
        if (!known.includes(part)) fail(`script/test checks whether it runs the part ${part}, which it does not know`);
      }
    }
  }
}
for (const part of printed) {
  const owners = testJobs.filter((j) => j.parts.includes(part)).map((j) => j.key);
  if (owners.length !== 1) fail(`not one job runs the part ${part}: ${owners.join(', ') || 'none'}`);
}
for (const { key, parts } of testJobs) {
  for (const part of parts) if (!printed.includes(part)) fail(`job ${key} runs the part ${part}, which script/changed-parts never selects`);
}
// runs <job> <event> <outputs>: whether the job runs when the job of script/changed-parts succeeds
// with those outputs: true, false, or undefined when that does not decide it.
const runs = (job, ev, outputs) => {
  const scope = {
    contexts: { github: ev.github, inputs: {}, needs: { [partsJob]: { result: 'success', outputs } } },
    status: { success: true, always: true, failure: false, cancelled: false },
  };
  return job.if === undefined ? true : truth(condition(job.if, scope));
};
// gated <key> <parts>: job <key> needs only the job of script/changed-parts, runs on a PR exactly
// when one of <parts> changed, whatever the other parts, and on a push to dev.
const gated = (key, parts) => {
  if (!partsJob) return;
  if (JSON.stringify(needsOf(jobs[key])) !== JSON.stringify([partsJob])) {
    fail(`job ${key} needs ${needsOf(jobs[key]).join(', ') || 'nothing'}, not only job ${partsJob}, which runs script/changed-parts`);
  }
  const outputs = (set) => Object.fromEntries(printed.map((part) => [part, part in set ? set[part] : unknown()]));
  for (const part of parts) {
    if (runs(jobs[key], pr, outputs({ [part]: 'true' })) !== true) fail(`job ${key} may be skipped on a PR that changes the part ${part}`);
  }
  if (runs(jobs[key], pr, outputs(Object.fromEntries(parts.map((part) => [part, 'false'])))) !== false) {
    fail(`job ${key} may run on a PR that changes none of its parts ${parts.join(', ')}`);
  }
  if (runs(jobs[key], push, outputs({})) !== true) fail(`job ${key} may be skipped on a push to dev`);
};
for (const { key, parts } of testJobs) gated(key, parts);

// The job Rust: passes only when the jobs it needs passed or were skipped.
const gateKey = Object.keys(jobs).find((key) => nameOf(key) === 'Rust');
const behind = testJobs.filter((j) => !required.includes(nameOf(j.key)));
if (gateKey && partsJob) {
  const gate = jobs[gateKey];
  const want = [partsJob, ...behind.map((j) => j.key)].sort();
  if (JSON.stringify([...needsOf(gate)].sort()) !== JSON.stringify(want)) fail(`job ${gateKey} needs ${needsOf(gate).join(', ')}, not ${want.join(', ')}`);
  for (const [status, result] of [
    [{ success: true, failure: false, cancelled: false }, 'success'],
    [{ success: false, failure: true, cancelled: false }, 'failure'],
    [{ success: false, failure: false, cancelled: true }, 'cancelled'],
  ]) {
    const needs = Object.fromEntries(needsOf(gate).map((n) => [n, { result, outputs: {} }]));
    const scope = { contexts: { github: pr.github, inputs: {}, needs }, status: { ...status, always: true } };
    if (gate.if === undefined || truth(condition(gate.if, scope)) !== true) fail(`job ${gateKey} may be skipped when a job it needs ends ${result}: a skipped check passes`);
  }
  if (gate['continue-on-error'] || (gate.steps ?? []).some((step) => step['continue-on-error'] || step.if !== undefined)) {
    fail(`job ${gateKey} may pass when a step of it fails or is skipped`);
  }
  const verdict = (gate.steps ?? []).find((step) => Object.values(step.env ?? {}).some((v) => String(v).replace(/\s+/g, '') === '${{toJSON(needs)}}'));
  if (!verdict || verdict.shell !== 'bash') fail(`no step of job ${gateKey} reads the results of the jobs it needs, toJSON(needs), in bash`);
  else {
    const variable = Object.keys(verdict.env).find((name) => String(verdict.env[name]).replace(/\s+/g, '') === '${{toJSON(needs)}}');
    // passes <results>: the step passes when the jobs it needs end with <results>, the rest skipped.
    const passes = (results) => {
      const needs = Object.fromEntries(needsOf(gate).map((n) => [n, { result: results[n] ?? 'skipped', outputs: {} }]));
      const env = { PATH: process.env.PATH, [variable]: JSON.stringify(needs) };
      return spawnSync('bash', ['--noprofile', '--norc', '-eo', 'pipefail', '-c', verdict.run], { env, stdio: 'ignore' }).status === 0;
    };
    const success = Object.fromEntries(needsOf(gate).map((n) => [n, 'success']));
    if (!passes(success)) fail(`job ${gateKey} fails when every job it needs succeeds`);
    if (!passes({ [partsJob]: 'success' })) fail(`job ${gateKey} fails when job ${partsJob} succeeds and the others are skipped`);
    for (const { key } of behind) {
      if (!passes({ [partsJob]: 'success', [key]: 'success' })) fail(`job ${gateKey} fails when only job ${key} runs and succeeds`);
      for (const result of ['failure', 'cancelled']) {
        if (passes({ ...success, [key]: result })) fail(`job ${gateKey} passes when job ${key} ends ${result}`);
      }
    }
    for (const result of ['failure', 'cancelled', 'skipped']) {
      if (passes({ [partsJob]: result })) fail(`job ${gateKey} passes when job ${partsJob} ends ${result}`);
    }
  }
}

// The self-host stack's part: alone in a job of the Rust code, on a runner of its own, which the job
// Rust needs.
const selfHost = testJobs.filter((j) => j.parts.includes('self-host'));
if (selfHost.length !== 1 || selfHost[0].parts.length !== 1) {
  fail(`the part self-host does not run alone in one job: ${selfHost.map((j) => `${j.key} (${j.parts.join(' ')})`).join(', ') || 'none'}`);
} else if (gateKey && !needsOf(jobs[gateKey]).includes(selfHost[0].key)) {
  fail(`job ${gateKey} does not need job ${selfHost[0].key}, which runs the part self-host`);
}

// The jobs of the Rust code set up the same tools.
const setUp = ({ job }) =>
  JSON.stringify(
    (job.steps ?? []).map((step) => {
      const copy = structuredClone(step);
      delete copy.with?.workspaces;
      if (runsTest(copy)) {
        delete copy.env?.SKALD_TEST_PARTS;
        delete copy.env?.NEXTEST_TEST_THREADS;
      }
      return copy;
    }),
  );
for (const j of behind.slice(1)) {
  if (setUp(j) !== setUp(behind[0]) || j.job['runs-on'] !== behind[0].job['runs-on']) {
    fail(`job ${j.key} sets up other tools than job ${behind[0].key}: their steps differ in more than the cached workspaces, SKALD_TEST_PARTS and NEXTEST_TEST_THREADS`);
  }
}

// What a run of script/test may change: how many tests run at once, not which or how they build.
const overridesRun = /^(NEXTEST_PROFILE|NEXTEST_RETRIES|CARGO_PROFILE_\w+|RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS)$/;
for (const name of Object.keys(ci.env ?? {})) {
  if (overridesRun.test(name)) fail(`${ciFile} sets ${name}, which changes how the tests of script/test are built or run`);
}
for (const { key, job } of testJobs) {
  for (const name of Object.keys(job.env ?? {})) {
    if (overridesRun.test(name)) fail(`job ${key} sets ${name}, which changes how the tests of script/test are built or run`);
  }
  const env = job.steps.find(runsTest).env ?? {};
  for (const name of Object.keys(env)) {
    if (overridesRun.test(name)) fail(`job ${key} runs script/test with ${name}, which changes how its tests are built or run`);
  }
  if ('NEXTEST_TEST_THREADS' in env && !/^[1-9][0-9]*$/.test(String(env.NEXTEST_TEST_THREADS))) {
    fail(`job ${key} runs script/test with NEXTEST_TEST_THREADS=${env.NEXTEST_TEST_THREADS}, not a whole number of tests at once`);
  }
}

// The screenshots that differ from their references, with diff images: the job of each part that
// compares screenshots uploads them after its tests fail.
for (const [part, dir] of [
  ['web', 'web/kit-diff/'],
  ['site', 'site/references-diff/'],
]) {
  const j = testJobs.find(({ parts }) => parts.includes(part));
  if (!j) continue;
  const steps = j.job.steps;
  const after = steps.slice(steps.findIndex(runsTest) + 1);
  const uploads = after.filter(
    (step) => /^actions\/upload-artifact@/.test(step.uses ?? '') && step.with?.path === dir && /^(\$\{\{\s*)?failure\(\)(\s*\}\})?$/.test(String(step.if ?? '').trim()),
  );
  if (uploads.length !== 1) fail(`job ${j.key} does not upload ${dir} after its tests fail`);
}

// The rules of every workflow, for every job: pinned actions, no kept credentials, a read-only token.
// pinned <steps> <where> <seen>: each action of the steps, and of the local actions among them, is
// pinned to a commit.
const pinned = (steps, where, seen = new Set()) => {
  for (const step of steps ?? []) {
    const uses = String(step.uses ?? '');
    if (uses.startsWith('./')) {
      const dir = path.join(root, uses);
      const file = ['action.yml', 'action.yaml'].map((name) => path.join(dir, name)).find((f) => fs.existsSync(f));
      if (!file) fail(`${where} uses ${uses}, which has no action.yml`);
      else if (!seen.has(file)) {
        seen.add(file);
        pinned(readWorkflow(file).runs?.steps, `${where}, through ${uses},`, seen);
      }
    } else if (uses && !/@[0-9a-f]{40}$/.test(uses)) fail(`${where} uses ${uses}, not pinned to a commit`);
  }
};
for (const [key, job] of Object.entries(jobs)) {
  pinned(job.steps, `job ${key}`);
  for (const step of job.steps ?? []) {
    const uses = String(step.uses ?? '');
    if (uses.startsWith('actions/checkout@') && step.with?.['persist-credentials'] !== false && step.with?.['persist-credentials'] !== 'false') {
      fail(`a checkout of job ${key} keeps the credentials: no persist-credentials: false`);
    }
  }
  const granted = permissions(ci, job);
  if (granted === null) fail(`job ${key} has no permissions set`);
  else if (Object.entries(granted).some(([scope, level]) => level !== 'none' && !(scope === 'contents' && level === 'read'))) {
    fail(`the token of job ${key} gets more than contents: read: ${JSON.stringify(granted)}`);
  }
}

// The workflow of the client on Windows: its triggers, the label ready-to-merge and the check
// Rust on Windows.
const winFile = '.github/workflows/client-windows.yml';
const win = readWorkflow(path.join(root, winFile));
const winJobs = win.jobs ?? {};
const label = 'ready-to-merge';
const winPr = event('pull_request', 'refs/pull/7/merge', { labels: [label] });
const onWin = triggers(win);
if (!runsFor(win, pr)) fail(`a PR into dev does not start ${winFile}`);
if (!runsFor(win, push)) fail(`a push to dev does not start ${winFile}`);
for (const [name, config] of [
  ['pull_request', onWin.pull_request ?? {}],
  ['push', onWin.push ?? {}],
]) {
  if (config.paths !== undefined || config['paths-ignore'] !== undefined) fail(`a ${name} starts ${winFile} only for some paths: the check Rust on Windows would be missing`);
}
for (const type of ['opened', 'synchronize', 'reopened', 'ready_for_review', 'labeled']) {
  if (![].concat(onWin.pull_request?.types ?? []).includes(type)) fail(`a PR's ${type} event does not start ${winFile}`);
}
{
  const group = (ev, number) => {
    const payload = number === undefined ? ev.github.event : open({ ...ev.github.event, number, pull_request: open({ ...ev.github.event.pull_request, number }) });
    const scope = { contexts: { github: open({ ...ev.github, workflow: win.name, event: payload }), inputs: {} }, status: {} };
    return { group: template(win.concurrency?.group, scope), cancels: truth(template(win.concurrency?.['cancel-in-progress'] ?? false, scope)) };
  };
  const [dev, seven, eight] = [group(push), group(pr, 7), group(pr, 8)];
  if ([dev, seven, eight].some((run) => run.group === undefined || isUnknown(run.group))) fail(`the concurrency group of a run of ${winFile} cannot be told from its event`);
  else if (new Set([dev.group, seven.group, eight.group]).size !== 3) fail(`two PRs, or a PR and dev, share a concurrency group of ${winFile}`);
  if (dev.cancels !== false) fail(`a push to dev's run of ${winFile} cancels the older run of its group`);
  if (seven.cancels !== true) fail(`a PR's run of ${winFile} does not cancel the PR's older run`);
}
const winParts = Object.keys(winJobs).find((k) => (winJobs[k].steps ?? []).some((step) => commands(step.run).some((line) => /script\/changed-parts\b/.test(line))));
const winTests = Object.keys(winJobs).find((k) => String(winJobs[k]['runs-on'] ?? '').startsWith('windows-'));
const winGate = Object.keys(winJobs).find((k) => k !== winParts && k !== winTests);
if (!winParts || !winTests || !winGate || Object.keys(winJobs).length !== 3) {
  fail(`${winFile} does not have three jobs: script/changed-parts, the tests on Windows and the check Rust on Windows`);
} else {
  const partsStep = winJobs[winParts].steps.find((step) => commands(step.run).some((line) => /script\/changed-parts\b/.test(line)));
  if (!commands(partsStep.run).some((line) => /script\/changed-parts HEAD\^1 \| tee -a "\$GITHUB_OUTPUT"/.test(line)) || partsStep.shell !== 'bash') {
    fail(`job ${winParts} of ${winFile} does not write what script/changed-parts HEAD^1 prints to $GITHUB_OUTPUT, in bash`);
  }
  if (String(winJobs[winParts].outputs?.workspace ?? '').replace(/\s+/g, '') !== `\${{steps.${partsStep.id}.outputs.workspace}}`) {
    fail(`job ${winParts} of ${winFile} does not output the part workspace that script/changed-parts prints`);
  }
  if (stepSkipped(partsStep, jobsFor(win, winPr)[winParts])) fail(`job ${winParts} of ${winFile} skips script/changed-parts on a PR`);
  if (JSON.stringify(needsOf(winJobs[winTests])) !== JSON.stringify([winParts])) fail(`job ${winTests} of ${winFile} needs other jobs than ${winParts}`);
  if (JSON.stringify([...needsOf(winJobs[winGate])].sort()) !== JSON.stringify([winParts, winTests].sort())) fail(`job ${winGate} of ${winFile} does not need jobs ${winParts} and ${winTests}`);
  // The cases: the event, whether the PR has the label, the workspace output, and whether the tests
  // run then and the check Rust on Windows decides.
  const cases = [];
  for (const workspace of ['true', 'false', '']) {
    for (const labels of [[], ['bug'], ['bug', label]]) {
      const labelled = labels.includes(label);
      cases.push({ ev: event('pull_request', 'refs/pull/7/merge', { labels }), workspace, labelled, what: `a PR${labelled ? ' with the label' : ` without the label${labels.length ? ' but another' : ''}`} whose workspace output is '${workspace}'` });
    }
  }
  cases.push({ ev: push, workspace: '', what: 'a push to dev' });
  for (const c of cases) {
    const onPr = c.ev.name === 'pull_request';
    const tests = !onPr || (c.workspace === 'true' && c.labelled);
    const decides = !onPr || c.workspace !== 'true' || c.labelled;
    const testsScope = {
      contexts: { github: c.ev.github, inputs: {}, needs: { [winParts]: { result: 'success', outputs: { workspace: c.workspace } } } },
      status: { success: true, always: true, failure: false, cancelled: false },
    };
    if (truth(condition(winJobs[winTests].if ?? 'true', testsScope)) !== tests) fail(`job ${winTests} of ${winFile} ${tests ? 'may be skipped' : 'may run'} on ${c.what}`);
    for (const [status, result] of [
      [{ success: true, failure: false, cancelled: false }, 'success'],
      [{ success: false, failure: true, cancelled: false }, 'failure'],
      [{ success: false, failure: false, cancelled: true }, 'cancelled'],
    ]) {
      const needs = { [winParts]: { result: 'success', outputs: { workspace: c.workspace } }, [winTests]: { result, outputs: {} } };
      const scope = { contexts: { github: c.ev.github, inputs: {}, needs }, status: { ...status, always: true } };
      const named = template(winJobs[winGate].name, scope);
      const runs = truth(condition(winJobs[winGate].if ?? 'success()', scope));
      if (decides && (named !== 'Rust on Windows' || runs !== true)) fail(`on ${c.what}, job ${winGate} of ${winFile} is not the check Rust on Windows, run whatever job ${winTests} ends with (${result}): it is ${toText(named)}, ${runs ? 'run' : 'skipped'}`);
      if (!decides && (isUnknown(named) || named === 'Rust on Windows')) fail(`on ${c.what}, the tests on Windows are skipped, and job ${winGate} of ${winFile} may report the check Rust on Windows`);
    }
  }
  const gate = winJobs[winGate];
  if (gate['continue-on-error'] || (gate.steps ?? []).some((step) => step['continue-on-error'] || step.if !== undefined)) fail(`job ${winGate} of ${winFile} may pass when a step of it fails or is skipped`);
  const verdict = (gate.steps ?? []).find((step) => Object.values(step.env ?? {}).some((v) => String(v).replace(/\s+/g, '') === '${{toJSON(needs)}}'));
  if (!verdict || verdict.shell !== 'bash') fail(`no step of job ${winGate} of ${winFile} reads the results of the jobs it needs, toJSON(needs), in bash`);
  else {
    const variable = Object.keys(verdict.env).find((name) => String(verdict.env[name]).replace(/\s+/g, '') === '${{toJSON(needs)}}');
    const passes = (parts, workspace, tests) => {
      const needs = { [winParts]: { result: parts, outputs: { workspace } }, [winTests]: { result: tests, outputs: {} } };
      return spawnSync('bash', ['--noprofile', '--norc', '-eo', 'pipefail', '-c', verdict.run], { env: { PATH: process.env.PATH, [variable]: JSON.stringify(needs) }, stdio: 'ignore' }).status === 0;
    };
    for (const [parts, workspace, tests, want] of [
      ['success', 'true', 'success', true],
      ['success', '', 'success', true],
      ['success', 'false', 'skipped', true],
      ['success', 'true', 'skipped', false],
      ['success', 'true', 'failure', false],
      ['success', 'true', 'cancelled', false],
      ['success', 'false', 'failure', false],
      ['failure', '', 'skipped', false],
      ['cancelled', '', 'skipped', false],
      ['skipped', '', 'skipped', false],
    ]) {
      if (passes(parts, workspace, tests) !== want) fail(`job ${winGate} of ${winFile} ${want ? 'fails' : 'passes'} when job ${winParts} ends ${parts} with workspace '${workspace}' and job ${winTests} ends ${tests}`);
    }
  }
  for (const [key, job] of Object.entries(winJobs)) {
    pinned(job.steps, `job ${key} of ${winFile}`);
    for (const step of job.steps ?? []) {
      if (String(step.uses ?? '').startsWith('actions/checkout@') && step.with?.['persist-credentials'] !== false) fail(`a checkout of job ${key} of ${winFile} keeps the credentials`);
    }
    const granted = permissions(win, job);
    if (granted === null || Object.entries(granted).some(([scope, level]) => level !== 'none' && !(scope === 'contents' && level === 'read'))) {
      fail(`the token of job ${key} of ${winFile} gets more than contents: read: ${JSON.stringify(granted)}`);
    }
  }
}
// No job of CI runs the client's tests on Windows: they wait for the label in their own workflow.
for (const [key, job] of Object.entries(jobs)) {
  if (String(job['runs-on'] ?? '').startsWith('windows-')) fail(`job ${key} of ${ciFile} runs on Windows: the client's tests on Windows run in ${winFile}`);
}

// The job of the client on Windows.
const states = jobsFor(win, winPr);
// The cargo nextest run command of a line, as its words, or null.
const cargoTest = (line) => {
  const w = words(line);
  const at = w.findIndex((word, i) => word === 'cargo' && w[i + 1] === 'nextest' && w[i + 2] === 'run');
  return at < 0 ? null : w.slice(at + 3);
};
// Whether the words run the client's tests: a build alone, --no-run, runs none.
const testsClient = (args) => {
  const options = args.indexOf('--') < 0 ? args : args.slice(0, args.indexOf('--'));
  return (
    !options.includes('--no-run') &&
    (options.some((word, i) => (word === '-p' || word === '--package') && options[i + 1] === 'skald-client') || options.includes('--package=skald-client'))
  );
};

// The job.
const found = Object.entries(winJobs).filter(
  ([key, job]) =>
    !states[key]?.skipped &&
    String(job['runs-on'] ?? '').startsWith('windows-') &&
    (job.steps ?? []).some((step) => commands(step.run).some((line) => testsClient(cargoTest(line) ?? []))),
);
if (found.length !== 1) {
  fail(`not one job of ${winFile} on a PR with the label ready-to-merge runs cargo nextest run -p skald-client on a Windows runner: ${found.map(([key]) => key).join(', ') || 'none'}`);
  done();
}
const [key, job] = found[0];
const steps = job.steps ?? [];
if (job['runs-on'] !== 'windows-2025') fail(`job ${key} runs on ${job['runs-on']}, not on windows-2025`);
if (job['continue-on-error']) fail(`a failure of job ${key} does not fail the run: continue-on-error`);

// The test step.
const testIndex = steps.findIndex((step) => commands(step.run).some((line) => testsClient(cargoTest(line) ?? [])));
const testStep = steps[testIndex];
if (testStep['continue-on-error']) fail(`a failure of the test step of job ${key} does not fail the job: continue-on-error`);
if (stepSkipped(testStep, states[key])) fail(`the test step of job ${key} is skipped for a PR`);
if (testStep.if !== undefined) fail(`the test step of job ${key} has a condition: ${testStep.if}`);
const tests = commands(testStep.run).filter((line) => cargoTest(line));
if (tests.length !== 1) fail(`the test step of job ${key} runs cargo nextest run ${tests.length} times, not once`);
const args = cargoTest(tests[0] ?? '') ?? [];
// The options but --test-threads <n>, which changes only how many tests run at once.
const threads = args.indexOf('--test-threads');
const options = threads >= 0 && /^[1-9][0-9]*$/.test(args[threads + 1] ?? '') ? args.toSpliced(threads, 2) : args;
if (options.join(' ') !== '-p skald-client -p skald-adapters --locked --no-fail-fast') {
  fail(`job ${key} runs cargo nextest run ${args.join(' ')}, not cargo nextest run -p skald-client -p skald-adapters --locked --no-fail-fast: every test of the client and the adapters, from the lockfile`);
}
const last = commands(testStep.run)
  .map((line) => line.trim())
  .filter((line) => line !== '' && !line.startsWith('#'))
  .at(-1);
if (last !== tests[0]?.trim()) {
  fail(`the test step of job ${key} ends with ${last ?? 'nothing'}, not with cargo nextest run: its exit code is the step's last command's, so a failing test would not fail the step`);
}
// A custom shell, {0} for the script, decides the exit code itself.
if (String(testStep.shell ?? job.defaults?.run?.shell ?? win.defaults?.run?.shell ?? '').includes('{0}')) {
  fail(`the test step of job ${key} runs in a custom shell, which may hide a failing test`);
}
// .cargo/config.toml: written only by a copy of a repository file that sets only opt-level.
const cargoConfig = /\.cargo[\\/]config(\.toml)?\b/;
for (const line of steps.flatMap((step) => commands(step.run)).filter((line) => cargoConfig.test(line))) {
  const copy = line.match(/^\s*Copy-Item\s+-Path\s+(\S+)\s+-Destination\s+\.cargo[\\/]config\.toml\s*$/);
  const file = copy ? path.resolve(root, copy[1]) : '';
  const settings = file.startsWith(root + path.sep) && file.endsWith('.toml') && fs.existsSync(file)
    ? fs.readFileSync(file, 'utf8').split('\n').map((l) => l.trim()).filter((l) => l !== '' && !l.startsWith('#') && !l.startsWith('['))
    : [];
  if (settings.length === 0 || !settings.every((l) => /^opt-level\s*=\s*("[sz]"|[0-3])$/.test(l))) {
    fail(`job ${key} writes .cargo/config.toml other than by a copy of a Cargo config file of the repository that sets only optimization levels: ${line.trim()}`);
  }
}
// Environment that changes the build's settings or nextest's profile and retries: in the
// workflow's, the job's or a step's env, or set by a step's script.
const overriding = /^(NEXTEST_PROFILE|NEXTEST_RETRIES|CARGO_PROFILE_\w+|RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS)$/;
for (const name of [win.env, job.env, ...steps.map((step) => step.env)].flatMap((env) => Object.keys(env ?? {}))) {
  if (overriding.test(name)) fail(`job ${key} sets ${name}, which changes how its tests are built or run`);
}
for (const line of steps.flatMap((step) => commands(step.run))) {
  const named = line.match(/\b(NEXTEST_PROFILE|NEXTEST_RETRIES|CARGO_PROFILE_\w+|RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS)\b/);
  if (named) fail(`a step of job ${key} names ${named[1]}, which changes how its tests are built or run: ${line.trim()}`);
}

// .config/nextest.toml: every test runs, once.
const nextestFile = path.join(root, '.config/nextest.toml');
const nextest = fs.existsSync(nextestFile) ? fs.readFileSync(nextestFile, 'utf8') : '';
for (const setting of ['default-filter', 'retries']) {
  if (new RegExp(`^\\s*${setting}\\s*=`, 'm').test(nextest)) fail(`.config/nextest.toml sets ${setting}: the client's tests on Windows would not all run, or not once`);
}
// The tests that run alone under nextest: <package> <binary> <path> of each override that sets
// threads-required = 'num-test-threads' with filters of that one form, joined by |.
const aloneUnderNextest = new Set(
  nextest
    .split(/^\[\[profile\.default\.overrides\]\]\s*$/m)
    .slice(1)
    .map((block) => block.split(/^\[/m)[0])
    .filter((block) => /^\s*threads-required\s*=\s*'num-test-threads'\s*$/m.test(block))
    .flatMap((block) => (block.match(/^\s*filter\s*=\s*'([^']*)'\s*$/m)?.[1] ?? '').split('|'))
    .map((term) => term.trim().match(/^\(?package\(([\w-]+)\) & binary\((\w+)\) & test\(=([\w:]+)\)\)?$/))
    .filter(Boolean)
    .map(([, pkg, binary, test]) => `${pkg} ${binary} ${test}`),
);
// The tests of the crates' integration test targets that call alone() themselves, as nextest names
// them: <package> <binary> <module path>::<function>.
const callers = [];
for (const crate of fs.readdirSync(path.join(root, 'crates'))) {
  const testsDir = path.join(root, 'crates', crate, 'tests');
  const manifest = path.join(root, 'crates', crate, 'Cargo.toml');
  if (!fs.existsSync(testsDir) || !fs.existsSync(manifest)) continue;
  const pkg = fs.readFileSync(manifest, 'utf8').match(/^name\s*=\s*"([^"]+)"/m)?.[1];
  for (const file of fs.readdirSync(testsDir, { recursive: true }).filter((f) => f.endsWith('.rs'))) {
    const parts = file.split(path.sep);
    const binary = parts.length === 1 ? parts[0].slice(0, -3) : parts[0];
    const modules = parts.length === 1 ? [] : parts.slice(1).map((part) => part.replace(/\.rs$/, '')).filter((part, i, all) => !(i === all.length - 1 && (part === 'main' || part === 'mod')));
    const text = fs.readFileSync(path.join(testsDir, file), 'utf8');
    // Calls of alone(), not its definition or a method of the same name.
    const calls = (code) => [...code.matchAll(/(^|[^\w.])alone\(\)/gm)].filter((m) => !/\bfn\s*$/.test(code.slice(0, m.index + m[1].length))).length;
    let counted = 0;
    for (const [, name, body] of text.matchAll(/^#\[test\]\n(?:#\[[^\n]*\]\n)*(?:pub )?fn (\w+)\([^)]*\)[^{]*\{([\s\S]*?)^\}$/gm)) {
      if (calls(body) > 0) callers.push(`${pkg} ${binary} ${[...modules, name].join('::')}`);
      counted += calls(body);
    }
    // A call anywhere else, a helper's or a nested module's test's, escapes the check.
    if (calls(text) > counted) {
      fail(`crates/${crate}/tests/${file} calls alone() other than directly in a top-level #[test] fn, which the check of the tests nextest runs alone cannot name`);
    }
  }
}
const defined = fs.readdirSync(path.join(root, 'crates'), { recursive: true })
  .filter((f) => f.endsWith('.rs') && f.split(path.sep).includes('tests'))
  .some((f) => /^pub fn alone\(\)/m.test(fs.readFileSync(path.join(root, 'crates', f), 'utf8')));
if (defined && callers.length === 0) fail('alone() is defined, but this check finds no test that calls it');
for (const caller of callers) {
  if (!aloneUnderNextest.has(caller)) fail(`${caller} calls alone(), and no override of .config/nextest.toml runs it alone: package(…) & binary(…) & test(=…) with threads-required = 'num-test-threads'`);
}

// The server's URL: in the step's or the job's env, or set in PowerShell before the tests run.
const url = /^postgres(ql)?:\/\/[^@\s/]+@127\.0\.0\.1:5432$/;
const lines = commands(testStep.run);
const set = lines.findIndex((line) => url.test(line.match(/^\s*\$env:SKALD_TEST_DATABASE_URL\s*=\s*"([^"]*)"\s*$/)?.[1] ?? ''));
const powershell = ['pwsh', 'powershell', undefined].includes(testStep.shell ?? job.defaults?.run?.shell ?? win.defaults?.run?.shell);
const inEnv = [testStep.env, job.env, win.env].some((env) => url.test(String(env?.SKALD_TEST_DATABASE_URL ?? '')));
if (!inEnv && !(powershell && set >= 0 && set < lines.findIndex((line) => cargoTest(line)))) {
  fail(`the test step of job ${key} does not give the tests the PostgreSQL at 127.0.0.1:5432 through SKALD_TEST_DATABASE_URL`);
}

// What the tests need, before them.
const before = steps.slice(0, testIndex).filter((step) => !step['continue-on-error'] && !stepSkipped(step, states[key]) && step.if === undefined);
const starts = before.findIndex((step) => {
  const text = commands(step.run).join('\n');
  return /\bStart-Service\b/.test(text) && /['"]?postgresql\*['"]?/.test(text);
});
if (starts < 0) fail(`job ${key} does not start the runner image's PostgreSQL service, postgresql*, before its tests`);
// The settings script/lib/postgres.sh gives the tests' PostgreSQL, in its configuration before it starts.
const configured = (setting) =>
  before.slice(0, starts + 1).some((step, i) => {
    const lines = commands(step.run);
    const until = i === starts ? lines.findIndex((line) => /\bStart-Service\b/.test(line)) : lines.length;
    return lines
      .slice(0, until)
      .some((line) => /^\s*Add-Content\b/.test(line) && line.includes('"$env:PGDATA\\postgresql.conf"') && setting.test(line));
  });
for (const [name, setting] of [
  ['fsync = off', /'fsync\s*=\s*off'/],
  ['max_connections = 500', /'max_connections\s*=\s*500'/],
]) {
  if (starts >= 0 && !configured(setting)) {
    fail(`job ${key} does not set ${name} in $env:PGDATA\\postgresql.conf before it starts PostgreSQL, as script/lib/postgres.sh sets it`);
  }
}
const waits = before.findIndex(
  (step, i) => i >= starts && commands(step.run).some((line) => /pg_isready\b/.test(line) && /--host\s+127\.0\.0\.1\b/.test(line) && /--port\s+5432\b/.test(line)),
);
if (starts >= 0 && waits < 0) fail(`job ${key} does not wait for PostgreSQL at 127.0.0.1:5432 with pg_isready before its tests`);
const packages = before.findIndex((step) => step['working-directory'] === 'web' && commands(step.run).some((line) => /^\s*npm\s+ci\b/.test(line)));
if (packages < 0) {
  fail(`job ${key} does not install the packages of web/ with npm ci before its tests: the sign-in tests drive Chrome Headless Shell with its playwright-core`);
}
const shell = (line) => {
  const w = words(line);
  return w[0] === 'node' && w[1] === 'node_modules/playwright-core/cli.js' && w[2] === 'install' && w.slice(3).join(' ') === 'chromium-headless-shell';
};
if (!before.some((step, i) => i > packages && step['working-directory'] === 'web' && commands(step.run).some(shell))) {
  fail(`job ${key} does not install Chrome Headless Shell with the playwright-core of web/ after its packages and before its tests: the sign-in tests drive it`);
}
if (!before.some((step) => String(step.uses ?? '').startsWith('actions/checkout@'))) fail(`job ${key} does not check out the repository before its tests`);

// Chrome Headless Shell from the Actions cache, in each job whose tests drive it.
// expanded <steps>: the steps, each of a local action in its place by the steps of that action.
const expanded = (steps) =>
  (steps ?? []).flatMap((step) => {
    const uses = String(step.uses ?? '');
    if (!uses.startsWith('./')) return [step];
    const file = ['action.yml', 'action.yaml'].map((name) => path.join(root, uses, name)).find((f) => fs.existsSync(f));
    return file ? expanded(readWorkflow(file).runs?.steps) : [];
  });
const browserJobs = [
  [key, steps.slice(0, testIndex)],
  ...testJobs
    .filter(({ parts }) => parts.some((part) => part === 'workspace' || part === 'web'))
    .map(({ key: k, job: j }) => [k, j.steps.slice(0, j.steps.findIndex(runsTest))]),
];
for (const [k, until] of browserJobs) {
  const want = String((k === key ? job : jobs[k])['runs-on']).startsWith('windows-') ? '~/AppData/Local/ms-playwright' : '~/.cache/ms-playwright';
  if (!expanded(until).some((step) => String(step.uses ?? '').startsWith('actions/cache@') && step.with?.path === want)) {
    fail(`job ${k} does not restore ${want} from the Actions cache before its tests: they drive Chrome Headless Shell`);
  }
}

// The ports in use, sampled from before the tests, given to them and printed after them.
const sampled = before.some((step) => /\bStart-Process\b/.test(commands(step.run).join('\n')) && commands(step.run).join('\n').includes("'ports.txt'"));
const heldStep = steps.slice(testIndex + 1).find((step) => commands(step.run).join('\n').includes("'ports.txt'"));
const given = commands(testStep.run).some((line) => /^\s*\$env:SKALD_TEST_PORT_SAMPLES\s*=.*'ports\.txt'/.test(line));
if (!sampled || !heldStep || !given) {
  fail(`job ${key} does not sample, from before its tests, the ephemeral ports in use, give the samples to them and print the most after them`);
} else {
  for (const failure of [false, true]) {
    const scope = { ...states[key].scope, status: { success: !failure, always: true, failure, cancelled: false } };
    if (truth(condition(heldStep.if ?? 'success()', scope)) !== true) {
      fail(`the step of job ${key} that prints the most ephemeral ports in use does not run when the tests ${failure ? 'fail' : 'pass'}`);
    }
  }
}

// PostgreSQL's failures, printed after the tests when they fail.
const logStep = steps.slice(testIndex + 1).find((step) => /\bGet-Content\b/.test(commands(step.run).join('\n')) && commands(step.run).join('\n').includes('$env:PGDATA\\log'));
if (!logStep) {
  fail(`no step of job ${key} after its tests prints PostgreSQL's log, $env:PGDATA\\log`);
} else {
  const text = commands(logStep.run).join('\n');
  for (const level of ['FATAL', 'PANIC']) {
    if (!text.includes(level)) fail(`the step of job ${key} that prints PostgreSQL's log leaves out its ${level} lines`);
  }
  if ((logStep.shell ?? job.defaults?.run?.shell ?? win.defaults?.run?.shell) !== 'pwsh') fail(`the step of job ${key} that prints PostgreSQL's log does not run in pwsh`);
  const scope = { ...states[key].scope, status: { success: false, always: true, failure: true, cancelled: false } };
  if (truth(condition(logStep.if ?? 'success()', scope)) !== true) fail(`the step of job ${key} that prints PostgreSQL's log does not run when the tests fail`);
}

// The check that the tests left no directories, after them, also when they fail.
const patterns = ["'skald-update-*'", "'skald-client-*'"];
const checkStep = steps.slice(testIndex + 1).find((step) => patterns.every((p) => commands(step.run).join('\n').includes(p)));
if (!checkStep) {
  fail(`no step of job ${key} after its tests checks that they left no ${patterns.join(' or ')} directory`);
} else {
  const text = commands(checkStep.run).join('\n');
  if (!text.includes('[IO.Path]::GetTempPath()')) fail(`the check of job ${key} for directories left does not look in the temporary directory, [IO.Path]::GetTempPath()`);
  if (!/^\s*if \(\$left\) \{ exit 1 \}\s*$/m.test(text)) fail(`the check of job ${key} for directories left does not fail when there is one`);
  if (checkStep['continue-on-error']) fail(`a failure of the check of job ${key} for directories left does not fail the job: continue-on-error`);
  if ((checkStep.shell ?? job.defaults?.run?.shell ?? win.defaults?.run?.shell) !== 'pwsh') fail(`the check of job ${key} for directories left does not run in pwsh`);
  // It runs whether the tests passed or failed.
  for (const failure of [false, true]) {
    const scope = { ...states[key].scope, status: { success: !failure, always: true, failure, cancelled: false } };
    if (truth(condition(checkStep.if ?? 'success()', scope)) !== true) {
      fail(`the check of job ${key} for directories left does not run when the tests ${failure ? 'fail' : 'pass'}`);
    }
  }
}

// The gate: as the workspace part's job.
if (!testJobs.some((j) => j.parts.includes('workspace'))) fail('no job runs script/test with the workspace part');

// The system's own key storage: only this job's tests use it.
const realKeys = 'SKALD_TEST_REAL_KEY_STORAGE';
if (String(testStep.env?.[realKeys]) !== '1') fail(`the test step of job ${key} does not set ${realKeys}=1`);
const workflowDir = path.join(root, '.github/workflows');
for (const file of fs.readdirSync(workflowDir).filter((f) => /\.ya?ml$/.test(f))) {
  const workflow = readWorkflow(path.join(workflowDir, file));
  const others = { ...workflow, jobs: Object.fromEntries(Object.entries(workflow.jobs ?? {}).filter(([k]) => `.github/workflows/${file}` !== winFile || k !== key)) };
  if (JSON.stringify(others).includes(realKeys)) fail(`.github/workflows/${file} sets ${realKeys} outside job ${key} of ${winFile}`);
}
if (JSON.stringify(winJobs[key]).replace(JSON.stringify(testStep), '').includes(realKeys)) fail(`job ${key} sets ${realKeys} outside its test step`);
for (const file of fs.readdirSync(path.join(root, 'script'), { recursive: true })) {
  const full = path.join(root, 'script', file);
  if (file !== 'ci-workflow-test' && fs.statSync(full).isFile() && fs.readFileSync(full, 'utf8').includes(realKeys)) fail(`script/${file} sets ${realKeys}`);
}

done();
