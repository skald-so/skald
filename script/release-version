#!/usr/bin/env bash
# Prints the workspace version, the one of [workspace.package] in Cargo.toml: a release's is its tag
# without the v. With <tag>, fails unless <tag> is v and that version.
# Usage: script/release-version [<tag>]
set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "usage: $0 [<tag>]" >&2
  exit 2
fi
root=$(cd "$(dirname "$0")/.." && pwd)
version=$(awk -F'"' '/^\[/ { section = $0 }
  section == "[workspace.package]" && /^version *=/ { print $2; exit }' "$root/Cargo.toml")
if [[ -z $version ]]; then
  echo "release-version: Cargo.toml has no version in [workspace.package]" >&2
  exit 1
fi
if [[ $# -eq 1 && $1 != "v$version" ]]; then
  echo "release-version: the tag $1 is not the workspace version's, v$version" >&2
  exit 1
fi
echo "$version"
