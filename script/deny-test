#!/usr/bin/env bash
# Tests the license and vulnerability policy: script/deny checks the graph of every workspace crate;
# workspace crates declare their planned licenses;
# no other crate has a normal or build dependency on the AGPL skald-server;
# no workspace crate depends on the prototypes in prototypes/, which never ship;
# cargo-deny with deny.toml accepts permissive dependencies and rejects disallowed licenses,
# unlicensed crates and known vulnerabilities; deny.toml rejects a license exception no crate uses.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0

fail() {
  echo "deny-test: $*" >&2
  failures=$((failures + 1))
}

# Workspace crates: the server is AGPL-3.0, the rest are MIT OR Apache-2.0.
crates=$(cargo metadata --manifest-path "$root/Cargo.toml" --no-deps --format-version 1 --locked |
  jq -r '.packages[] | "\(.name) \(.license)"')
[[ $(wc -l <<<"$crates") -ge 6 ]] || fail "expected at least 6 workspace crates, got: $crates"
while read -r name license; do
  want='MIT OR Apache-2.0'
  [[ $name == skald-server ]] && want='AGPL-3.0-only'
  [[ $license == "$want" ]] || fail "$name: license '$license', want '$want'"
done <<<"$crates"

# script/deny, as script/test runs it: the root package is one of the crates, so cargo-deny alone
# would check only its graph.
graph=$("$root/script/deny" list --format json --layout crate | jq -r 'keys[] | split(" ")[0]')
while read -r name _; do
  grep -qxF "$name" <<<"$graph" || fail "script/deny does not check the workspace crate $name"
done <<<"$crates"

# server_dependents <manifest> [cargo-metadata flag...]: prints the packages in the graph, other than
# skald-server itself, with a normal or build dependency on it. Dev-dependencies are not distributed.
server_dependents() {
  local manifest=$1
  shift
  cargo metadata --manifest-path "$manifest" --format-version 1 "$@" |
    jq -r '[.packages[] | select(.name != "skald-server")
      | select(any(.dependencies[]; .name == "skald-server" and .kind != "dev")) | .name] | join(" ")'
}

# The deny.toml exception allows skald-server anywhere in the graph; this check keeps it out of other crates.
dependents=$(server_dependents "$root/Cargo.toml" --locked)
[[ -z $dependents ]] || fail "AGPL skald-server is a dependency of: $dependents"

# prototype_packages <manifest> <dir> [cargo-metadata flag...]: prints the packages in the graph of
# <manifest> whose manifest is under <dir>.
prototype_packages() {
  local manifest=$1 dir=$2
  shift 2
  cargo metadata --manifest-path "$manifest" --format-version 1 "$@" |
    jq -r --arg dir "$dir/" '[.packages[] | select(.manifest_path | startswith($dir)) | .name] | join(" ")'
}

prototypes=$(prototype_packages "$root/Cargo.toml" "$root/prototypes" --locked)
[[ -z $prototypes ]] || fail "workspace crates depend on the prototypes: $prototypes"

# Creates the fixture <case>: an MIT package that depends on <dependency>.
fixture() {
  local case=$1 dependency=$2
  mkdir -p "$tmp/$case/src"
  touch "$tmp/$case/src/lib.rs"
  cat >"$tmp/$case/Cargo.toml" <<TOML
[package]
name = "app"
version = "0.1.0"
edition = "2024"
license = "MIT"

[dependencies]
$dependency
TOML
}

# Creates the fixture <case> with a local dependency `dep` declaring [license].
local_fixture() {
  local case=$1 license=${2:-}
  fixture "$case" 'dep = { path = "dep" }'
  mkdir -p "$tmp/$case/dep/src"
  touch "$tmp/$case/dep/src/lib.rs"
  {
    printf '[package]\nname = "dep"\nversion = "0.1.0"\nedition = "2024"\n'
    [[ -z $license ]] || printf 'license = "%s"\n' "$license"
  } >"$tmp/$case/dep/Cargo.toml"
}

# The policy of deny.toml for the fixtures: they lack the crates its exceptions name, which the
# workspace's own check requires to be in its graph.
config=$tmp/deny.toml
sed 's/^unused-license-exception = "deny"$/unused-license-exception = "allow"/' "$root/deny.toml" >"$config"
grep -qx 'unused-license-exception = "allow"' "$config" ||
  fail 'deny.toml: no unused-license-exception = "deny" in [licenses]'

# expect <case> <pass|code> <check>...: runs cargo-deny on the fixture <case>;
# expects it to pass or to fail with error[<code>].
expect() {
  local case=$1 want=$2 output
  shift 2
  if output=$(cargo deny --manifest-path "$tmp/$case/Cargo.toml" --config "$config" \
    --color never check "$@" 2>&1); then
    [[ $want == pass ]] || fail "$case: expected error[$want], cargo-deny passed"
  elif [[ $want == pass ]]; then
    fail "$case: expected pass, cargo-deny failed:"$'\n'"$output"
  elif [[ $output != *"error[$want]"* ]]; then
    fail "$case: expected error[$want], got:"$'\n'"$output"
  fi
}

# Creates the fixture <case>: an MIT package `app` with <entry> in [<table>]
# and a local AGPL `skald-server` in `server/`.
server_fixture() {
  local case=$1 table=$2 entry=$3
  mkdir -p "$tmp/$case/src" "$tmp/$case/server/src"
  touch "$tmp/$case/src/lib.rs" "$tmp/$case/server/src/lib.rs"
  printf '[package]\nname = "app"\nversion = "0.1.0"\nedition = "2024"\nlicense = "MIT"\n\n[%s]\n%s\n' \
    "$table" "$entry" >"$tmp/$case/Cargo.toml"
  printf '[package]\nname = "skald-server"\nversion = "0.1.0"\nedition = "2024"\nlicense = "AGPL-3.0-only"\n' \
    >"$tmp/$case/server/Cargo.toml"
}

# expect_server_dependents <case> <want>: the dependents of skald-server in the fixture <case> are <want>.
expect_server_dependents() {
  local case=$1 want=$2 got
  got=$(server_dependents "$tmp/$case/Cargo.toml")
  [[ $got == "$want" ]] || fail "$case: skald-server dependents '$got', want '$want'"
}

local_fixture permissive 'MIT OR Apache-2.0'
expect permissive pass advisories licenses

local_fixture gpl 'GPL-3.0-only'
expect gpl rejected licenses

local_fixture agpl 'AGPL-3.0-only'
expect agpl rejected licenses

local_fixture unlicensed
expect unlicensed unlicensed licenses

# RUSTSEC-2021-0003: buffer overflow in SmallVec::insert_many.
fixture vulnerable 'smallvec = "=1.6.0"'
expect vulnerable vulnerability advisories

server_fixture server-normal dependencies 'skald-server = { path = "server" }'
expect_server_dependents server-normal app

server_fixture server-build build-dependencies 'skald-server = { path = "server" }'
expect_server_dependents server-build app

server_fixture server-renamed dependencies 'server = { package = "skald-server", path = "server" }'
expect_server_dependents server-renamed app

server_fixture server-dev dev-dependencies 'skald-server = { path = "server" }'
expect_server_dependents server-dev ''

# A dependency on a prototype, even a dev-dependency, pulls it into the workspace's graph.
for table in dependencies dev-dependencies; do
  case=prototype-$table
  mkdir -p "$tmp/$case/src" "$tmp/$case/prototypes/proto/src"
  touch "$tmp/$case/src/lib.rs" "$tmp/$case/prototypes/proto/src/lib.rs"
  printf '[package]\nname = "app"\nversion = "0.1.0"\nedition = "2024"\n\n[%s]\nproto = { path = "prototypes/proto" }\n' \
    "$table" >"$tmp/$case/Cargo.toml"
  printf '[package]\nname = "proto"\nversion = "0.1.0"\nedition = "2024"\n' >"$tmp/$case/prototypes/proto/Cargo.toml"
  got=$(prototype_packages "$tmp/$case/Cargo.toml" "$tmp/$case/prototypes")
  [[ $got == proto ]] || fail "$case: prototype packages '$got', want 'proto'"
done

if [[ $failures -ne 0 ]]; then
  echo "deny-test: $failures case(s) failed" >&2
  exit 1
fi
echo "deny-test: all cases passed"
