#!/usr/bin/env node
// WinGet release manifests and catalog submission against local archives and a GitHub stand-in.
// Native installation is checked separately by winget-installers-test.ps1.
import assert from 'node:assert/strict';
import { execFile, execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { after, test } from 'node:test';
import { fileURLToPath } from 'node:url';
import { promisify } from 'node:util';
import { catalogFixture } from './lib/winget-catalog-stub.mjs';
import { allNeeds, dryRunEvents, event, jobsRunning, readWorkflow, unpublishedEvents } from './lib/workflows.mjs';

const root = fileURLToPath(new URL('..', import.meta.url));
const run = promisify(execFile);
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'release-winget-test.'));
after(() => fs.rmSync(tmp, { recursive: true, force: true }));

const version = '1.23.45';
const tag = `v${version}`;
const id = 'Fixture.Skald';
const releases = `https://github.com/skald-so/skald/releases/download/${tag}`;
const targets = { x64: 'x86_64-pc-windows-msvc', arm64: 'aarch64-pc-windows-msvc' };
const archive = (architecture) => `skald-client-${targets[architecture]}.zip`;
const hash = (file) => createHash('sha256').update(fs.readFileSync(file)).digest('hex');
function releaseFixture(releaseVersion) {
  const dir = path.join(tmp, `release-${releaseVersion}`);
  fs.mkdirSync(dir);
  const staging = fs.mkdtempSync(path.join(tmp, 'archive.'));
  for (const architecture of Object.keys(targets)) {
    fs.writeFileSync(path.join(staging, 'skald.exe'), `skald ${releaseVersion} ${architecture}\n`);
    const name = archive(architecture);
    const zip = path.join(dir, name);
    execFileSync('zip', ['-q', zip, 'skald.exe'], { cwd: staging });
    fs.writeFileSync(`${zip}.sha256`, `${hash(zip)} *${name}\n\n`);
  }
  return dir;
}
const assets = releaseFixture(version);

// A command gets synthetic credentials and can reach the loopback fixture through any proxy.
const proxy = 'http://127.0.0.1:1';
const env = {
  PATH: process.env.PATH,
  ALL_PROXY: proxy, HTTP_PROXY: proxy, HTTPS_PROXY: proxy,
  all_proxy: proxy, http_proxy: proxy, https_proxy: proxy,
  NO_PROXY: '127.0.0.1', no_proxy: '127.0.0.1', NODE_USE_ENV_PROXY: '1',
  GH_TOKEN: 'fixture-token', GITHUB_TOKEN: 'fixture-token',
  GH_CONFIG_DIR: path.join(tmp, 'gh'),
};
const command = (name) => path.join(root, 'script', name);
const generate = (releaseDir, manifestDir, downloadUrl, releaseTag = tag, packageId = id) =>
  run(command('release-winget'), [releaseTag, releaseDir, packageId, manifestDir], {
    cwd: root,
    env: { ...env, ...(downloadUrl ? { SKALD_DOWNLOAD_URL: downloadUrl } : {}) },
    timeout: 15000,
  });

function checkManifestSet(dir, baseUrl) {
  const manifest = (name, type) => {
    const body = readWorkflow(path.join(dir, name));
    assert.equal(body.ManifestType, type);
    assert.equal(body.PackageIdentifier, id);
    assert.equal(body.PackageVersion, version);
    assert.match(body.ManifestVersion, /^1\.\d+\.\d+$/);
    return body;
  };
  const release = manifest(`${id}.yaml`, 'version');
  assert.match(release.DefaultLocale, /^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$/i);
  const localeFile = `${id}.locale.${release.DefaultLocale}.yaml`;
  assert.deepEqual(fs.readdirSync(dir).sort(), [`${id}.installer.yaml`, localeFile, `${id}.yaml`].sort(),
    'one version, locale and installer YAML');
  const locale = manifest(localeFile, 'defaultLocale');
  const installer = manifest(`${id}.installer.yaml`, 'installer');
  assert.equal(locale.PackageLocale, release.DefaultLocale);
  assert.match(locale.PackageName, /^skald$/i);
  assert.equal(new Set([release.ManifestVersion, locale.ManifestVersion, installer.ManifestVersion]).size, 1);
  assert.deepEqual(installer.Installers.map(({ Architecture }) => Architecture).sort(), ['arm64', 'x64']);
  for (const entry of installer.Installers) {
    const name = archive(entry.Architecture);
    assert.equal(entry.InstallerUrl, `${baseUrl}/${name}`);
    assert.equal(String(entry.InstallerSha256).toLowerCase(), hash(path.join(assets, name)));
    assert.equal(entry.InstallerType ?? installer.InstallerType, 'zip');
    assert.equal(entry.NestedInstallerType ?? installer.NestedInstallerType, 'portable');
    assert.ok(!Object.hasOwn(installer, 'Scope') && !Object.hasOwn(entry, 'Scope'),
      'WinGet validates portable ZIPs without a manifest scope');
    const nested = entry.NestedInstallerFiles ?? installer.NestedInstallerFiles;
    assert.equal(nested.length, 1);
    assert.equal(nested[0].RelativeFilePath, 'skald.exe');
    // The archive already names the command skald.exe. An explicit alias must preserve that name.
    assert.match(nested[0].PortableCommandAlias ?? 'skald', /^skald(?:\.exe)?$/i);
  }
}

test('one portable WinGet set maps both Windows architectures to the exact tagged ZIP, hash and binary', async () => {
  const dir = path.join(tmp, 'manifest');
  await generate(assets, dir);
  checkManifestSet(dir, releases);
});

test('the Windows fixture download URL applies to both entries in the same manifest', async () => {
  const dir = path.join(tmp, 'local-manifest');
  const url = 'http://127.0.0.1:18763';
  await generate(assets, dir, url);
  checkManifestSet(dir, url);
});

for (const scenario of ['missing archive', 'mismatched checksum']) {
  test(`WinGet generation refuses a release with a ${scenario}`, async () => {
    const releaseDir = path.join(tmp, scenario);
    fs.cpSync(assets, releaseDir, { recursive: true });
    const zip = path.join(releaseDir, archive('arm64'));
    if (scenario === 'missing archive') fs.unlinkSync(zip);
    else fs.copyFileSync(path.join(assets, archive('x64')), zip);
    const manifestDir = path.join(tmp, `${scenario} manifests`);
    await assert.rejects(generate(releaseDir, manifestDir), (error) => {
      assert.equal(typeof error.code, 'number', 'the release command must exist and exit with a failure');
      assert.match(error.stderr + error.stdout, /arm64|aarch64|checksum|sha256/i);
      return true;
    });
    assert.ok(!fs.existsSync(path.join(manifestDir, `${id}.installer.yaml`)), 'invalid release produced an installer manifest');
  });
}

test('a beta does not generate a stable WinGet manifest set', async () => {
  const dir = path.join(tmp, 'beta');
  await generate(assets, dir, undefined, `${tag}-beta.1`).catch((error) => {
    assert.equal(typeof error.code, 'number', 'the release command must exist');
  });
  assert.ok(!fs.existsSync(dir) || fs.readdirSync(dir).length === 0, 'beta produced stable manifests');
});

test('catalog submission opens one PR with the generated set, reuses it on retry and reports its acceptance', async () => {
  const submit = command('submit-winget');
  fs.accessSync(submit, fs.constants.X_OK);
  const dir = path.join(tmp, 'catalog-manifest');
  await generate(assets, dir);
  const catalog = await catalogFixture();
  try {
    const submitOnce = async (manifestDir = dir) => {
      const result = await run(submit, [manifestDir], {
        cwd: root,
        env: {
          ...env,
          GITHUB_API_URL: catalog.url,
          WINGET_CATALOG_REPO: catalog.upstream,
          WINGET_SUBMISSION_REPO: catalog.fork,
        },
        timeout: 15000,
      });
      return result.stdout + result.stderr;
    };
    const first = await submitOnce();
    assert.match(first, /\bpending\b/i);
    const [pull] = catalog.pulls;
    assert.equal(catalog.pulls.length, 1);
    assert.ok(first.includes(pull.html_url) || first.includes(`#${pull.number}`));
    assert.equal(pull.base.repo.full_name, catalog.upstream);
    assert.equal(pull.base.ref, 'master');
    assert.equal(pull.head.repo.full_name, catalog.fork);
    const prefix = `manifests/f/Fixture/Skald/${version}`;
    assert.deepEqual(catalog.files(pull), Object.fromEntries(
      fs.readdirSync(dir).map((name) => [`${prefix}/${name}`, fs.readFileSync(path.join(dir, name), 'utf8')]),
    ));
    const again = await submitOnce();
    assert.match(again, /\bpending\b/i);
    assert.ok(again.includes(pull.html_url) || again.includes(`#${pull.number}`));
    assert.equal(catalog.pulls.length, 1);
    catalog.merge(pull);
    const accepted = await submitOnce();
    assert.match(accepted, /\b(?:accepted|merged)\b/i);
    assert.doesNotMatch(accepted, /\bpending\b/i);
    assert.ok(accepted.includes(pull.html_url) || accepted.includes(`#${pull.number}`));
    assert.equal(catalog.pulls.length, 1);

    const nextVersion = '1.23.46';
    for (const [releaseDir, packageId, releaseVersion] of [
      [releaseFixture(nextVersion), id, nextVersion],
      [assets, 'Fixture.OtherSkald', version],
    ]) {
      const additional = path.join(tmp, `${packageId}-${releaseVersion}`);
      await generate(releaseDir, additional, undefined, `v${releaseVersion}`, packageId);
      assert.match(await submitOnce(additional), /\bpending\b/i);
      assert.match(await submitOnce(additional), /\bpending\b/i);
    }
    assert.equal(catalog.pulls.length, 3, 'a new version or package identifier has its own catalog PR');
    assert.equal(new Set(catalog.pulls.map((entry) => entry.head.label)).size, 3);
  } finally {
    await catalog.close();
  }
});

const workflow = () => readWorkflow(path.join(root, '.github/workflows/release.yml'));
const runs = (release, eventName, ref, name) => jobsRunning(release, event(eventName, ref), (line) => line.includes(name));

test('the release workflow submits WinGet only after publishing a stable release', () => {
  const release = workflow();
  const stableRef = `refs/tags/${tag}`;
  const submit = runs(release, 'push', stableRef, 'script/submit-winget');
  assert.equal(submit.length, 1, 'a stable release has one WinGet catalog submission job');
  const published = runs(release, 'push', stableRef, 'gh release create');
  assert.equal(published.length, 1);
  assert.ok(allNeeds(release.jobs, submit[0]).has(published[0]), 'submission waits for the published release');
  for (const [name, ref] of [...unpublishedEvents, ['push', `${stableRef}-beta.1`]]) {
    assert.deepEqual(runs(release, name, ref, 'script/submit-winget'), [], `${name} ${ref} submits nothing`);
  }
});

test('release dry runs exercise the same WinGet manifest artifact on both native Windows targets', () => {
  const fixture = fs.readFileSync(path.join(root, 'script/winget-installers-test.ps1'), 'utf8');
  const install = fixture.match(/^\s*& \$winget install (.+)$/m)?.[1] ?? '';
  assert.match(install, /(?:^|\s)--scope user(?:\s|$)/);
  assert.doesNotMatch(install, /(?:^|\s)--(?:no-)?proxy(?:\s|=|$)/,
    'loopback installation uses default WinGet proxy settings');

  const release = workflow();
  const artifactNames = (job, action) => (job.steps ?? [])
    .filter((step) => step.uses?.startsWith(`actions/${action}-artifact@`))
    .map((step) => step.with?.name)
    .filter(Boolean);
  for (const [name, ref] of dryRunEvents) {
    const native = runs(release, name, ref, 'script/winget-installers-test.ps1');
    assert.ok(native.length, `${name} exercises WinGet native installation`);
    const generation = runs(release, name, ref, 'script/release-winget');
    const common = new Set(generation.flatMap((key) => artifactNames(release.jobs[key], 'upload')));
    const checked = new Set();
    const fixtures = new Set();
    for (const key of native) {
      const job = release.jobs[key];
      const needs = allNeeds(release.jobs, key);
      const manifest = artifactNames(job, 'download').find((file) => common.has(file) &&
        generation.some((generator) => needs.has(generator) && artifactNames(release.jobs[generator], 'upload').includes(file)));
      assert.ok(manifest, `${key} downloads the generated manifest artifact`);
      fixtures.add(manifest);
      const nativeTargets = job.strategy?.matrix?.include?.map(({ target }) => target) ?? job.strategy?.matrix?.target ?? [];
      for (const target of Object.values(targets)) {
        if (nativeTargets.includes(target) || job.steps.some((step) => step.run?.includes(target))) checked.add(target);
      }
    }
    assert.equal(fixtures.size, 1, 'the native Windows targets use the same manifest artifact');
    assert.deepEqual([...checked].sort(), Object.values(targets).sort(), `${name} checks x64 and Arm64`);
  }
});
