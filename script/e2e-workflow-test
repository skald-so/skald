#!/usr/bin/env node
// Tests .github/workflows/e2e.yml, which runs the e2e tests of the client and of the adapters
// against the latest Claude Code:
//   - it runs daily, by hand, and on a PR into dev that changes the adapter (claude_relay.rs,
//     claude_socket.rs, helper.rs, hook.rs, main.rs, mcp.rs, permission_prompts.rs, recv.rs,
//     resend.rs, state.rs and wait.rs of the client, its claude-mod, and crates/adapters), the
//     Claude Code plugin (.claude-plugin/ and plugins/claude-code/), its e2e or hook tests, a
//     module the e2e tests take by #[path] or include!, found by following them from
//     claude_code_e2e/main.rs and
//     claude_code_executor/main.rs, or the workflow; a PR that changes none of them does not start
//     it;
//   - one job runs on Linux, macOS and Windows; it installs @anthropic-ai/claude-code@latest with
//     npm, then runs the ignored claude_code_e2e tests of the client and claude_code_executor tests
//     of the adapters with SKALD_E2E_REQUIRED=1, so a skip fails, each in a step without a
//     condition;
//   - the Linux host job installs the latest Claude Code and pinned releases of Paseo and Herdr
//     in a temporary directory; its host tests fail if an executable is missing;
//   - it needs no secret: it reads none, its token reads contents at most, a checkout keeps no
//     credentials, and every action is pinned to a commit.
import fs from 'node:fs';
import path from 'node:path';
import { reporter } from './lib/report.mjs';
import { event, pathTriggers, permissions, readWorkflow, runsFor, triggers, writes } from './lib/workflows.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const file = '.github/workflows/e2e.yml';
const { fail, done } = reporter('e2e-workflow-test');

if (!fs.existsSync(path.join(root, file))) {
  console.error(`e2e-workflow-test: ${file} is missing`);
  process.exit(1);
}
// modules <main> <least>: the files of the Rust crate root <main>, a path from the root of the
// repository: it and, following each `mod` and `include!` from it, every file they take, at least
// <least> of them.
function modules(main, least) {
  const seen = new Set();
  const visit = (file) => {
    if (seen.has(file)) return;
    seen.add(file);
    scan(file, file);
  };
  // The modules `file` declares, as a part of `base`, the file whose modules they are.
  const scan = (file, base) => {
    let attribute = null;
    for (const line of fs.readFileSync(path.join(root, file), 'utf8').split('\n').map((l) => l.trim())) {
      const at = line.match(/^#\[path\s*=\s*"([^"]+)"\]/);
      const included = line.match(/^include!\("([^"]+)"\)/);
      const declared = line.match(/^(?:pub(?:\([^)]*\))?\s+)?mod\s+(\w+)\s*;/);
      if (at) {
        attribute = at[1];
      } else if (included) {
        const into = path.normalize(path.join(path.dirname(file), included[1]));
        seen.add(into);
        scan(into, base);
      } else if (declared) {
        const owner = path.basename(base);
        const dir = ['main.rs', 'mod.rs', 'lib.rs'].includes(owner)
          ? path.dirname(base)
          : path.join(path.dirname(base), owner.replace(/\.rs$/, ''));
        const plain = path.join(dir, `${declared[1]}.rs`);
        visit(
          attribute
            ? path.normalize(path.join(path.dirname(base), attribute))
            : fs.existsSync(path.join(root, plain))
              ? plain
              : path.join(dir, declared[1], 'mod.rs'),
        );
        attribute = null;
      } else if (line !== '' && !line.startsWith('//') && !line.startsWith('#[')) {
        attribute = null;
      }
    }
  };
  visit(main);
  if (seen.size < least) fail(`the modules of ${main} were not found: ${[...seen].join(', ')}`);
  return [...seen];
}

const workflow = readWorkflow(path.join(root, file));
const text = fs.readFileSync(path.join(root, file), 'utf8');
const on = triggers(workflow);

// The events that start it.
if (!(on.schedule ?? []).some((entry) => typeof entry?.cron === 'string')) fail('it does not run on a schedule');
if (!runsFor(workflow, event('workflow_dispatch', 'refs/heads/dev'))) fail('a manual run does not start it');
if (!runsFor(workflow, event('pull_request', 'refs/pull/7/merge'))) fail('a PR into dev does not start it');
for (const changed of [
  'crates/client/src/claude_relay.rs',
  'crates/client/src/claude_socket.rs',
  'crates/client/src/helper.rs',
  'crates/client/src/hook.rs',
  'crates/client/src/main.rs',
  'crates/client/src/mcp.rs',
  'crates/client/src/permission_prompts.rs',
  'crates/client/src/recv.rs',
  'crates/client/src/resend.rs',
  'crates/client/src/state.rs',
  'crates/client/src/wait.rs',
  'crates/client/claude-mod/hooks/mod.js',
  'crates/client/tests/claude_code_hooks/hooks.rs',
  'crates/client/tests/claude_code_hooks/inputs/stop.json',
  'crates/adapters/src/lib.rs',
  'crates/adapters/src/claude_code.rs',
  'crates/adapters/Cargo.toml',
  '.claude-plugin/marketplace.json',
  'plugins/claude-code/.claude-plugin/plugin.json',
  'plugins/claude-code/hooks/hooks.json',
  'plugins/claude-code/skills/skald/SKILL.md',
  ...modules('crates/client/tests/claude_code_e2e/main.rs', 10),
  ...modules('crates/adapters/tests/claude_code_executor/main.rs', 6),
  file,
]) {
  if (!pathTriggers(on.pull_request ?? {}, changed)) fail(`a PR that changes only ${changed} does not start it`);
}
for (const changed of ['crates/server/src/main.rs', 'docs/dev/infrastructure.md', '.github/workflows/ci.yml']) {
  if (pathTriggers(on.pull_request ?? {}, changed)) fail(`a PR that changes only ${changed} starts it`);
}

const jobs = workflow.jobs ?? {};
const key = 'claude-code';
const job = jobs[key] ?? {};
const oses = [].concat(job.strategy?.matrix?.os ?? job['runs-on'] ?? []).map(String);
for (const [os, pattern] of [
  ['Linux', /^ubuntu-/],
  ['macOS', /^macos-/],
  ['Windows', /^windows-/],
]) {
  if (!oses.some((runner) => pattern.test(runner))) fail(`job ${key} does not run on ${os}: ${oses.join(', ')}`);
}
if (job.strategy?.['fail-fast'] !== false) fail(`job ${key}: a failure on one OS cancels the others`);
const run = (step) => String(step.run ?? '');
const claudeInstall = (steps) => steps.findIndex((step) =>
  /\bnpm install --global @anthropic-ai\/claude-code@latest\b/.test(run(step)));
const steps = job.steps ?? [];
const install = claudeInstall(steps);
if (install < 0) fail(`job ${key} does not install the latest Claude Code with npm`);
for (const [crate, target] of [
  ['skald-client', 'claude_code_e2e'],
  ['skald-adapters', 'claude_code_executor'],
]) {
  const filtered = target === 'claude_code_e2e' ? ' --skip hosts::' : '';
  const command = new RegExp(`^cargo test -p ${crate}( --locked)? --test ${target} -- --ignored${filtered}$`);
  const tests = steps.findIndex((step) => command.test(run(step).trim()));
  if (tests < 0) {
    fail(`job ${key} does not run the ignored ${target} tests alone in a step`);
    continue;
  }
  if (install >= 0 && install > tests) fail(`job ${key} installs Claude Code after the ${target} tests`);
  const step = steps[tests];
  if (String(step.env?.SKALD_E2E_REQUIRED) !== '1') fail(`job ${key}: a skipped ${target} test does not fail it`);
  if (step.if !== undefined || step['continue-on-error']) fail(`job ${key}: the ${target} tests may not run or not fail it`);
}

const hostKey = 'claude-code-hosts';
const hosts = jobs[hostKey] ?? {};
if (!/^ubuntu-/.test(hosts['runs-on'] ?? '')) fail(`job ${hostKey} needs a Linux runner`);
const hostSteps = hosts.steps ?? [];
const hostInstall = claudeInstall(hostSteps);
const hostCommand = 'cargo test -p skald-client --locked --test claude_code_e2e -- --ignored hosts::';
const hostTests = hostSteps.findIndex((step) => run(step).split('\n').includes(hostCommand));
if (hostInstall < 0 || hostInstall >= hostTests) fail(`job ${hostKey} does not install Claude Code before the tests`);
if (hostTests < 0) {
  fail(`job ${hostKey} does not run the ignored host tests`);
} else {
  const step = hostSteps[hostTests];
  if (step.if !== undefined || step['continue-on-error']) fail(`job ${hostKey}: the host tests may not run or not fail it`);
  for (const name of ['SKALD_E2E_REQUIRED', 'SKALD_E2E_REQUIRED_HOSTS']) {
    if (String(step.env?.[name]) !== '1') fail(`job ${hostKey}: a skipped test does not fail it (${name})`);
  }
  const setup = run(step).split(hostCommand)[0];
  for (const [pattern, missing] of [
    [/mktemp -d/, 'temporary installation directory'],
    [/trap 'rm -rf "\$hosts"' EXIT/, 'installation cleanup'],
    [/https:\/\/registry\.npmjs\.org\/@getpaseo\/cli\/-\/cli-\d+\.\d+\.\d+\.tgz/, 'pinned Paseo package'],
    [/https:\/\/github\.com\/herdrdev\/herdr\/releases\/download\/v\d+\.\d+\.\d+\/herdr-linux-x86_64/, 'pinned Herdr binary'],
    [/sha256sum --check/, 'checksum verification'],
    [/^[0-9a-f]{64}  paseo\.tgz$/m, 'Paseo checksum'],
    [/^[0-9a-f]{64}  herdr$/m, 'Herdr checksum'],
    [/npm install --prefix "\$hosts" .*\.\/paseo\.tgz/, 'Paseo installation'],
    [/chmod \+x herdr/, 'executable Herdr'],
    [/export PATH="\$hosts\/node_modules\/\.bin:\$hosts:\$PATH"/, 'installed hosts on PATH'],
  ]) {
    if (!pattern.test(setup)) fail(`job ${hostKey}: missing ${missing} before the tests`);
  }
}

// No secret.
if (/\bsecrets\./.test(text)) fail('it reads a secret');
for (const [key, job] of Object.entries(jobs)) {
  const own = permissions(workflow, job);
  if (own === null) fail(`job ${key}: its permissions are not set`);
  else if (own.all || writes(own).length > 0) fail(`job ${key}: its token writes`);
  for (const step of job.steps ?? []) {
    const uses = String(step.uses ?? '');
    if (uses && !uses.startsWith('./') && !/@[0-9a-f]{40}$/.test(uses)) fail(`${uses} is not pinned to a commit`);
    if (uses.startsWith('actions/checkout@') && step.with?.['persist-credentials'] !== false) fail('a checkout keeps its credentials');
  }
}

done();
