#!/usr/bin/env node
// Tests how the release workflow, .github/workflows/release.yml, builds and publishes the web app's
// archive, and how docs/dev/infrastructure.md says to verify it:
//   - a job runs script/release-web <dir>, which builds web/ with the packages installed there and
//     writes <dir>/skald-web.tar.gz and <dir>/skald-web.tar.gz.sha256 (script/release-web-test). Its
//     steps, run as GitHub runs them with a stand-in script/release-web and a stand-in npm that
//     records each command: on a push of vX.Y.Z and vX.Y.Z-beta.N, and on the dry run of a PR and
//     of a manual run, it installs web/ from its lockfile, `npm ci`, before it builds, and never
//     runs npm install or update; its checkouts take the run's commit, the tag's on a push of one;
//   - the job that creates the release needs it, and, run after it on a push of vX.Y.Z and
//     vX.Y.Z-beta.N with a stand-in gh and the files the build jobs make, publishes with the rest of
//     the release's files the archive and its checksum as the job made them, and its attestation as
//     a file of its own, skald-web.tar.gz.sigstore.json: the bundle an attesting step of that job
//     writes before the release is created, with the archive among its subjects;
//   - the rules every job of the workflow follows, the dry run publishing nothing and only a push of
//     a v* tag attesting, are those of script/release-workflow-test, script/release-attest-test and
//     script/release-npm-workflow-test;
//   - docs/dev/infrastructure.md: "Release" says GitHub Releases hold skald-web.tar.gz too, not
//     skald only; "Channels" has a row of it; "Trust in builds" has a command that verifies it
//     against skald-web.tar.gz.sigstore.json, pinned to the release workflow at the release tag:
//     gh attestation verify --bundle, or cosign verify-blob-attestation --bundle.
import crypto from 'node:crypto';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { infrastructureSection, pinsAttestation } from './lib/release-docs.mjs';
import { reporter } from './lib/report.mjs';
import { runJobs } from './lib/run-jobs.mjs';
import { allNeeds, commands, dryRunEvents, readWorkflow, toText } from './lib/workflows.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const releaseFile = '.github/workflows/release.yml';
const { fail, done } = reporter('release-web-workflow-test');
const WEB = 'skald-web.tar.gz';
const BUNDLE = `${WEB}.sigstore.json`;

// The docs.
const docs = (title) => infrastructureSection(root, title);
const releaseDocs = docs('Release');
if (!releaseDocs.includes(WEB)) fail(`docs/dev/infrastructure.md, "Release", does not say GitHub Releases hold ${WEB}`);
if (/GitHub Releases hold `skald` only/.test(releaseDocs)) fail('docs/dev/infrastructure.md, "Release", still says GitHub Releases hold skald only');
if (!docs('Channels').split('\n').some((line) => line.startsWith('|') && line.includes(WEB))) {
  fail(`docs/dev/infrastructure.md, "Channels", has no row of ${WEB}`);
}
const workflowIdentity = 'https://github.com/skald-so/skald/.github/workflows/release.yml@refs/tags/v';
const verifiesWeb = (line) =>
  new RegExp(`\\s${WEB.replace(/\./g, '\\.')}(\\s|$|\`)`).test(line) &&
  new RegExp(`--bundle[\\s=]+['"]?${BUNDLE.replace(/\./g, '\\.')}`).test(line) &&
  ((/\bgh\s+attestation\s+verify\b/.test(line) && pinsAttestation(line)) ||
    (/\bcosign\s+verify-blob-attestation\b/.test(line) &&
      line.includes(`--certificate-identity ${workflowIdentity}`) &&
      /--certificate-oidc-issuer[\s=]+['"]?https:\/\/token\.actions\.githubusercontent\.com/.test(line)));
if (!docs('Trust in builds').split('\n').some(verifiesWeb)) {
  fail(
    `docs/dev/infrastructure.md, "Trust in builds", has no command that verifies ${WEB} against ${BUNDLE}, pinned to the release workflow at the release tag`,
  );
}

// The jobs.
const release = readWorkflow(path.join(root, releaseFile));
const jobs = release.jobs ?? {};
const lines = (job) => (job.steps ?? []).flatMap((step) => commands(step.run));
const buildsWeb = (line) => /(^|[\s;&|(/"'])script\/release-web(?=$|[\s"';&|)])/.test(line);
const webJobs = Object.keys(jobs).filter((key) => lines(jobs[key]).some(buildsWeb));
const creators = Object.keys(jobs).filter((key) => lines(jobs[key]).some((line) => /\bgh\s+release\s+create\b/.test(line)));
if (webJobs.length === 0) {
  fail(`no job of ${releaseFile} runs script/release-web`);
  done();
}
if (creators.length !== 1) {
  fail(`one job of ${releaseFile} runs gh release create, not: ${creators.join(', ') || 'none'}`);
  done();
}
const [creator] = creators;
for (const key of webJobs) {
  if (key !== creator && !allNeeds(jobs, creator).has(key)) fail(`job ${creator} creates the release without needing job ${key}, which builds the web app's archive`);
  (jobs[key].steps ?? []).forEach((step, index) => {
    if (!/^actions\/checkout@/i.test(String(step.uses ?? ''))) return;
    const ref = step.with?.ref;
    if (step.with?.repository !== undefined || (ref !== undefined && !/^\$\{\{\s*github\.(sha|ref)\s*\}\}$/.test(String(ref).trim()))) {
      fail(`job ${key} step ${step.name ?? index + 1}: it builds the web app at the run's commit, the tag's, not at: ${step.with?.repository ?? ''} ${ref ?? ''}`);
    }
  });
}
const publishAt = (jobs[creator].steps ?? []).findIndex((step) => commands(step.run).some((line) => /\bgh\s+release\s+create\b/.test(line)));

const targets = [
  'aarch64-apple-darwin',
  'aarch64-pc-windows-msvc',
  'aarch64-unknown-linux-gnu',
  'x86_64-apple-darwin',
  'x86_64-pc-windows-msvc',
  'x86_64-unknown-linux-gnu',
];
const sha256 = (bytes) => crypto.createHash('sha256').update(bytes).digest('hex');
// list <text>: the items of an action's input, one per line or comma-separated.
const list = (text) =>
  toText(text)
    .split(/[\n,]/)
    .map((s) => s.trim())
    .filter(Boolean);
// copyInto <from> <into>: the files under <from>, a file or a directory, into <into>, a directory's
// files at their paths under it, as an artifact holds them.
function copyInto(from, into) {
  fs.mkdirSync(into, { recursive: true });
  if (fs.statSync(from).isDirectory()) fs.cpSync(from, into, { recursive: true });
  else fs.copyFileSync(from, path.join(into, path.basename(from)));
}

// run <eventName> <ref> <keys>: runs the jobs <keys> on the event; {results, problems, log, made,
// published, bundles, work}.
function run(eventName, ref, keys, version) {
  const tmp = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'release-web-workflow-test-')));
  const work = path.join(tmp, 'work');
  const bin = path.join(tmp, 'bin');
  const runner = path.join(tmp, 'runner');
  const store = path.join(tmp, 'artifacts');
  const published = path.join(tmp, 'published');
  for (const dir of [work, bin, runner, store, published]) fs.mkdirSync(dir);
  try {
    // The checkout: the scripts, release-web a stand-in; the installers; web/ with its package files;
    // the workspace at <version>; a CHANGELOG with its section.
    fs.mkdirSync(path.join(work, 'script'));
    for (const name of fs.readdirSync(path.join(root, 'script'))) {
      if (name !== 'release-web') fs.symlinkSync(path.join(root, 'script', name), path.join(work, 'script', name));
    }
    const log = path.join(tmp, 'commands.jsonl');
    const token = crypto.randomBytes(16).toString('hex');
    fs.writeFileSync(
      path.join(work, 'script', 'release-web'),
      `#!/usr/bin/env node
// The stand-in script/release-web <dir>: records its call and writes the archive and its checksum.
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
fs.appendFileSync(${JSON.stringify(log)}, JSON.stringify({ command: 'release-web', args: process.argv.slice(2), cwd: process.cwd() }) + '\\n');
const dir = path.resolve(process.argv[process.argv.length - 1]);
fs.mkdirSync(dir, { recursive: true });
const bytes = Buffer.from(${JSON.stringify(`stand-in ${WEB} ${token}\n`)});
fs.writeFileSync(path.join(dir, ${JSON.stringify(WEB)}), bytes);
fs.writeFileSync(path.join(dir, ${JSON.stringify(`${WEB}.sha256`)}), crypto.createHash('sha256').update(bytes).digest('hex') + '  ' + ${JSON.stringify(WEB)} + '\\n');
`,
      { mode: 0o755 },
    );
    fs.symlinkSync(path.join(root, 'installers'), path.join(work, 'installers'));
    fs.mkdirSync(path.join(work, 'web'));
    for (const name of ['package.json', 'package-lock.json']) fs.copyFileSync(path.join(root, 'web', name), path.join(work, 'web', name));
    fs.writeFileSync(path.join(work, 'Cargo.toml'), `[workspace.package]\nversion = "${version}"\n`);
    fs.writeFileSync(
      path.join(work, 'CHANGELOG.md'),
      `# Changelog\n\n## [Unreleased]\n\n## [${version}](https://github.com/skald-so/skald/releases/tag/v${version}) - 2026-11-20\n\n### Added\n\n- *(web)* the web app ([#30](https://github.com/skald-so/skald/pull/30))\n`,
    );
    // npm: records each command and does nothing. gh: release create keeps a copy of each file it
    // publishes.
    fs.writeFileSync(
      path.join(bin, 'npm'),
      `#!/usr/bin/env node\nrequire('fs').appendFileSync(${JSON.stringify(log)}, JSON.stringify({ command: 'npm', args: process.argv.slice(2), cwd: process.cwd() }) + '\\n');\n`,
      { mode: 0o755 },
    );
    fs.writeFileSync(
      path.join(bin, 'gh'),
      `#!/usr/bin/env bash
if [[ $1 == release && $2 == create ]]; then
  previous=
  for arg in "$@"; do
    if [[ -f $arg && $previous != --notes-file && $previous != -F ]]; then cp "$arg" '${published}/'; fi
    previous=$arg
  done
fi
`,
      { mode: 0o755 },
    );
    // The build jobs' artifacts: each target's archive and its checksum.
    for (const target of targets) {
      const archive = `skald-client-${target}.${target.includes('windows') ? 'zip' : 'tar.gz'}`;
      const dir = path.join(store, `build-${target}`);
      fs.mkdirSync(dir);
      const bytes = crypto.randomBytes(128);
      fs.writeFileSync(path.join(dir, archive), bytes);
      fs.writeFileSync(path.join(dir, `${archive}.sha256`), `${sha256(bytes)} *${archive}\n`);
    }

    const bundles = [];
    const action = ({ kind, index, key, input }) => {
      const at = (p) => path.resolve(work, p);
      if (kind === 'actions/upload-artifact') {
        const into = path.join(store, input('name') || 'artifact');
        let found = 0;
        for (const pattern of list(input('path'))) {
          for (const match of fs.globSync(at(pattern))) {
            copyInto(match, into);
            found++;
          }
        }
        if (found === 0 && input('if-no-files-found') === 'error') return { passed: false, problem: `upload-artifact finds no file: ${input('path')}` };
      } else if (kind === 'actions/download-artifact') {
        const into = at(input('path') || '.');
        const pattern = input('pattern') || input('name');
        const merge = input('merge-multiple') === 'true' || Boolean(input('name'));
        for (const name of fs.readdirSync(store)) {
          if (pattern && !new RegExp(`^${pattern.replace(/[.+^$()|[\]\\]/g, '\\$&').replace(/\*/g, '.*')}$`).test(name)) continue;
          fs.cpSync(path.join(store, name), merge ? into : path.join(into, name), { recursive: true });
        }
        if (input('name') && !fs.existsSync(path.join(store, input('name')))) return { passed: false, problem: `no artifact ${input('name')}` };
      } else if (kind === 'actions/attest' || kind === 'actions/attest-build-provenance') {
        const subjects = [];
        for (const pattern of list(input('subject-path'))) {
          for (const match of fs.globSync(at(pattern))) if (fs.statSync(match).isFile()) subjects.push(sha256(fs.readFileSync(match)));
        }
        const checksums = input('subject-checksums');
        if (checksums && fs.existsSync(at(checksums))) {
          for (const line of fs.readFileSync(at(checksums), 'utf8').split('\n')) {
            const m = line.match(/^([0-9a-fA-F]{64})\s/);
            if (m) subjects.push(m[1].toLowerCase());
          }
        }
        const file = path.join(runner, `attestation-${bundles.length + 1}.sigstore.json`);
        const text = JSON.stringify({ mediaType: 'application/vnd.dev.sigstore.bundle.v0.3+json', standin: { subjects, key, index } });
        fs.writeFileSync(file, text);
        bundles.push({ key, index, subjects, text });
        return { outputs: { 'bundle-path': file, 'attestation-id': String(bundles.length), 'attestation-url': `https://github.com/skald-so/skald/attestations/${bundles.length}` } };
      }
      return {};
    };
    const { results, problems } = runJobs(release, keys, { eventName, ref, version, sha: '0'.repeat(40), work, bin, runner, action, env: { TMPDIR: tmp } });
    const logged = fs.existsSync(log) ? fs.readFileSync(log, 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l)) : [];
    const made = Buffer.from(`stand-in ${WEB} ${token}\n`);
    const files = Object.fromEntries(fs.readdirSync(published).map((name) => [name, fs.readFileSync(path.join(published, name))]));
    return { results, problems, log: logged, made, published: files, bundles, work };
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

// installs <run> <label>: the web jobs installed web/ from its lockfile before they built it, and
// never with npm install or update.
function installs(r, label) {
  const web = path.join(r.work, 'web');
  const verb = (args) => args.find((a) => !a.startsWith('-'));
  const target = (entry) => {
    const { args, cwd } = entry;
    for (let i = 0; i < args.length; i++) {
      const m = args[i].match(/^(--prefix|-C)(?:=(.*))?$/);
      if (m) return path.resolve(cwd, m[2] ?? args[i + 1] ?? '');
    }
    return cwd;
  };
  const built = r.log.findIndex((e) => e.command === 'release-web');
  if (built < 0) {
    fail(`${label}: no job runs script/release-web`);
    return;
  }
  const ci = r.log.slice(0, built).some((e) => e.command === 'npm' && verb(e.args) === 'ci' && target(e) === web);
  if (!ci) fail(`${label}: script/release-web runs after npm ci installs web/ from its lockfile, but no npm ci in web/ runs before it`);
  for (const e of r.log.filter((x) => x.command === 'npm')) {
    if (/^(install|i|in|ins|inst|insta|instal|isnt|isnta|isntal|isntall|add|update|up|upgrade|udpate)$/.test(verb(e.args) ?? '')) {
      fail(`${label}: the web app is built from its lockfile, but npm ${e.args.join(' ')} runs`);
    }
  }
}

const order = [...webJobs.filter((k) => k !== creator), creator];
for (const tag of ['v1.2.3', 'v1.2.4-beta.1']) {
  const label = `on a push of ${tag}`;
  const r = run('push', `refs/tags/${tag}`, order, tag.slice(1));
  for (const key of order) if (r.results[key].result === 'skipped') fail(`${label}: job ${key} is skipped`);
  for (const p of r.problems) fail(`${label}: ${p}`);
  installs(r, label);
  const names = Object.keys(r.published).sort();
  for (const name of [WEB, `${WEB}.sha256`, BUNDLE]) {
    if (!names.includes(name)) fail(`${label}: the release has no ${name}; it has: ${names.join(', ') || 'no file'}`);
  }
  if (r.published[WEB] && !r.published[WEB].equals(r.made)) fail(`${label}: the release's ${WEB} is not the archive script/release-web made`);
  const checksum = r.published[`${WEB}.sha256`]?.toString().trim().split(/\s+/);
  if (checksum && (checksum[0] !== sha256(r.made) || checksum[1]?.replace(/^\*/, '') !== WEB)) {
    fail(`${label}: ${WEB}.sha256 is not the checksum of the archive script/release-web made: ${checksum.join(' ')}`);
  }
  if (r.published[BUNDLE]) {
    const text = r.published[BUNDLE].toString();
    const bundle = r.bundles.find((b) => b.text === text);
    if (!bundle) fail(`${label}: ${BUNDLE} is not the bundle of an attestation the release workflow made`);
    else if (bundle.key !== creator || bundle.index > publishAt) {
      fail(`${label}: ${BUNDLE} is the bundle of an attestation of job ${bundle.key}, not one job ${creator} makes before it creates the release`);
    } else if (!bundle.subjects.includes(sha256(r.made))) fail(`${label}: ${BUNDLE} is the bundle of an attestation that does not attest ${WEB}`);
  }
}
for (const [name, ref] of dryRunEvents) {
  const label = `on the dry run of a ${name}`;
  const keys = webJobs.filter((k) => k !== creator);
  if (keys.length === 0) {
    fail(`${label}: no job builds the web app's archive; only job ${creator}, which publishes, does`);
    continue;
  }
  const r = run(name, ref, keys, '1.2.3');
  for (const key of keys) if (r.results[key].result === 'skipped') fail(`${label}: job ${key}, which builds the web app's archive, is skipped`);
  for (const p of r.problems) fail(`${label}: ${p}`);
  installs(r, label);
}

done();
