#!/usr/bin/env node
// Tests the release image: what .github/workflows/release.yml does with the skald-server image, and
// how docs/dev/infrastructure.md says to verify it.
//   - Only a push of a v* tag pushes, signs and attests the image: for any other push, a PR and a
//     manual run, on a tag ref too, every step that may write to a registry, sign with cosign or
//     attest an image is skipped, whatever the run's inputs, variables and step outputs.
//   - The jobs that touch the image, run as GitHub runs them, with the stand-ins of
//     script/lib/registry-stub.mjs for docker, cosign and the other registry tools and a stand-in
//     GHCR that has :edge and an older release:
//     - on a push of vX.Y.Z and of vX.Y.Z-beta.N, the image is built at the tag's commit from the
//       image definition script/image-test builds, with the repository as its context, the commit as
//       its REVISION, no other target and no imported cache, and pushed to
//       ghcr.io/skald-so/skald-server under one tag, its version, X.Y.Z or vX.Y.Z, the same form for
//       both; no other tag is written, so there is no :latest, :edge and the older release keep their
//       digests, and nothing goes to another image; the pushed digest is one a build of the run made,
//       not :edge's or another existing one;
//     - cosign signs that digest, by digest and keyless: no key, and no tag; actions/attest or
//       actions/attest-build-provenance attests the build provenance of that digest, pushed before,
//       as ghcr.io/skald-so/skald-server;
//     - when GHCR already has the version's tag, it is not pushed again: the tag keeps its digest;
//     - when the lookup of the version's tag fails other than with not found, the run fails and
//       pushes, signs and attests nothing;
//     - the dry run, on a PR and on a manual run on dev and on a tag ref, builds the image from that
//       definition and pushes, signs and attests nothing.
//   - The rules of the release pipeline for the jobs that touch the image: a job that pushes or
//     signs writes packages, one that signs or attests requests an OIDC token, one that attests
//     writes attestations, and none writes anything else, unless it also creates the GitHub
//     Release; no other job writes packages; cosign is installed before it runs, by
//     taiki-e/install-action at an exact version it checks against a checksum; no build imports a
//     cache; the workflow names no :latest.
//   - docs/dev/infrastructure.md: the GHCR row of "Channels" names the version tags; "Trust in
//     builds" covers release images, not :edge; it says GHCR tags can be moved, so an image is
//     verified by its digest and signature; it has the cosign verify command of the image by digest,
//     pinned to the exact identity of the release workflow at refs/tags/vX.Y.Z and GitHub's OIDC
//     issuer, and the gh attestation verify command of the image by digest, pinned like a release
//     file's.
// The rules every job of the workflow follows, actions pinned to commits, tools checked against
// checksums and no cache restored, are script/release-workflow-test's.
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import {
  commands,
  condition,
  event,
  isUnknown,
  jobsFor,
  needsOf,
  open,
  permissions,
  readWorkflow,
  stepSkipped,
  template,
  toText,
  truth,
  unknown,
} from './lib/workflows.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const releaseFile = '.github/workflows/release.yml';
const image = 'ghcr.io/skald-so/skald-server';
const stub = path.join(root, 'script/lib/registry-stub.mjs');
let failures = 0;
const fail = (what) => {
  console.error(`release-image-test: ${what}`);
  failures++;
};

const release = readWorkflow(path.join(root, releaseFile));
const jobs = release.jobs ?? {};

// The image definition script/image-test builds: the Dockerfile it names.
const named = [...new Set(fs.readFileSync(path.join(root, 'script/image-test'), 'utf8').match(/--file [^\s)]+/g) ?? [])];
const dockerfile = named.length === 1 ? named[0].replace(/^--file /, '') : null;
if (!dockerfile) fail(`script/image-test names no Dockerfile or several: ${named.join(', ') || 'none'}`);

// What a step does to images.
const usesOf = (step) => String(step?.uses ?? '');
const action = (step) => usesOf(step).split('@')[0].toLowerCase();
const lines = (step) => commands(step?.run);
const registryWrite =
  /\bdocker\s+(image\s+)?push\b|\bdocker\s+(buildx\s+)?(build|bake)\b.*(--push\b|push=true|type=registry)|\bimagetools\s+create\b|\bcrane\s+(push|copy|cp|tag|append|mutate|rebase|flatten|delete|index)\b|\bskopeo\s+(copy|delete|sync)\b|\bregctl\s+(image\s+(copy|cp|import|mod|delete)|tag\s+(add|rm|delete)|manifest\s+(put|delete)|index)\b|\boras\s+(push|cp|copy|tag|attach|manifest\s+(push|delete))\b/;
const cosignWrite = /\bcosign\s+(sign|attest|attach|copy|upload)\b/;
const runWrites = (step) => lines(step).some((l) => registryWrite.test(l) || cosignWrite.test(l));
const runSigns = (step) => lines(step).some((l) => cosignWrite.test(l));
const builds = (step) => /^docker\/(build-push-action|bake-action)$/.test(action(step));
const attestsImage = (step) =>
  /^actions\/(attest-build-provenance|attest)$/.test(action(step)) &&
  (step.with?.['subject-name'] !== undefined || step.with?.['subject-digest'] !== undefined);
const off = (v) => v === undefined || v === null || v === false || v === '' || String(v).toLowerCase() === 'false';
// pushInput <step> <scope>: a build action's step pushes for the scope: true, false or undefined.
function pushInput(step, scope) {
  if (action(step) === 'docker/bake-action') return undefined;
  const push = template(step.with?.push ?? false, scope);
  const outputs = template(step.with?.outputs ?? '', scope);
  if (isUnknown(push) || isUnknown(outputs)) return undefined;
  return !off(push) || /push=true|type=registry/.test(toText(outputs));
}
// writesImage <step> <scope>: why the step may push, sign or attest an image for the scope, or null.
function writesImage(step, scope) {
  if (builds(step) && pushInput(step, scope) !== false) return `${usesOf(step).split('@')[0]} may push`;
  if (runWrites(step)) return 'it runs a command that writes to a registry or signs';
  if (attestsImage(step)) return 'it attests an image';
  return null;
}
const stepName = (key, step, index) => `job ${key} step ${step.name ?? step.id ?? index + 1}`;

// Only a push of a v* tag pushes, signs and attests.
const quiet = [
  ['push', 'refs/heads/dev'],
  ['push', 'refs/heads/main'],
  ['push', 'refs/heads/v1.2.3'],
  ['push', 'refs/tags/1.2.3'],
  ['push', 'refs/tags/release-1.2.3'],
  ['push', 'refs/tags/skald-v1.2.3'],
  ['pull_request', 'refs/pull/7/merge'],
  ['workflow_dispatch', 'refs/heads/dev'],
  ['workflow_dispatch', 'refs/tags/v1.2.3'],
  ['workflow_dispatch', 'refs/tags/v1.2.3-beta.1'],
];
for (const [name, ref] of quiet) {
  const states = jobsFor(release, event(name, ref));
  for (const [key, job] of Object.entries(jobs)) {
    (job.steps ?? []).forEach((step, index) => {
      if (stepSkipped(step, states[key])) return;
      const why = writesImage(step, { ...states[key].scope, status: { success: unknown(), always: true, failure: unknown(), cancelled: unknown() } });
      if (why) fail(`a ${name} on ${ref} pushes, signs and attests nothing, but ${stepName(key, step, index)} may run: ${why}`);
    });
  }
}

// The jobs that touch the image, and their tokens.
const allSteps = Object.entries(jobs).flatMap(([key, job]) => (job.steps ?? []).map((step, index) => ({ key, step, index })));
const pushers = allSteps.filter(({ step }) => (builds(step) && !off(step.with?.push ?? step.with?.outputs)) || lines(step).some((l) => registryWrite.test(l)));
const signers = allSteps.filter(({ step }) => runSigns(step));
const attesters = allSteps.filter(({ step }) => attestsImage(step));
if (pushers.length === 0) fail(`no step of ${releaseFile} pushes the image`);
if (!allSteps.some(({ step }) => lines(step).some((l) => /\bcosign\s+sign\b/.test(l)))) fail(`no step of ${releaseFile} signs the image with cosign sign`);
if (attesters.length === 0) fail(`no step of ${releaseFile} attests the image with actions/attest or actions/attest-build-provenance`);
const writes = (p) => (p ? Object.entries(p).filter(([, level]) => level === 'write').map(([scope]) => scope) : []);
const createsRelease = (job) => (job.steps ?? []).some((s) => lines(s).some((l) => /\bgh\s+release\s+create\b/.test(l)));
for (const [key, job] of Object.entries(jobs)) {
  const has = (list) => list.some((s) => s.key === key);
  const pushes = has(pushers);
  const signs = has(signers);
  const attests = has(attesters);
  const pushesAttestation = attesters.some((s) => s.key === key && !off(s.step.with?.['push-to-registry']));
  const needed = new Set();
  if (pushes || signs || pushesAttestation) needed.add('packages');
  if (signs || attests) needed.add('id-token');
  if (attests) needed.add('attestations');
  const w = writes(permissions(release, job) ?? {});
  for (const scope of needed) if (!w.includes(scope)) fail(`job ${key} touches the image, so its token writes ${scope}`);
  if (needed.size > 0) {
    const allowed = new Set([...needed, ...(createsRelease(job) ? ['contents', 'attestations', 'id-token'] : [])]);
    const extra = w.filter((s) => !allowed.has(s));
    if (extra.length > 0) fail(`job ${key} touches the image; its token writes only what that needs, not also: ${extra.join(', ')}`);
  } else if (w.includes('packages')) fail(`job ${key} pushes, signs and attests no image, but its token writes packages`);
}

// cosign: installed at an exact version before it runs.
for (const [key, job] of Object.entries(jobs)) {
  const steps = job.steps ?? [];
  const first = steps.findIndex((s) => lines(s).some((l) => /\bcosign\b/.test(l)));
  if (first < 0) continue;
  // sigstore/cosign-installer checks only its bootstrap version against a checksum; any other, by
  // its signature alone.
  const installer = steps.slice(0, first).find(
    (s) =>
      action(s) === 'taiki-e/install-action' &&
      /(^|[,\s])cosign@\d+\.\d+\.\d+($|[,\s])/.test(String(s.with?.tool ?? '')) &&
      !(s.with?.checksum === false || String(s.with?.checksum).toLowerCase() === 'false'),
  );
  if (!installer) {
    fail(`job ${key} runs cosign without installing it before by taiki-e/install-action at cosign@X.Y.Z, checked against its checksum`);
  }
}

// No imported cache and no :latest.
for (const { key, step, index } of allSteps) {
  if (builds(step) && !off(step.with?.['cache-from'])) fail(`${stepName(key, step, index)}: the release image imports a cache: ${step.with['cache-from']}`);
  if (lines(step).some((l) => /--cache-from\b/.test(l))) fail(`${stepName(key, step, index)}: the release image imports a cache: --cache-from`);
}
const strings = (v) => (typeof v === 'string' ? [v] : v && typeof v === 'object' ? Object.values(v).flatMap(strings) : []);
for (const s of strings(release)) {
  if (/:latest\b|\blatest=(true|auto)\b/.test(s)) fail(`${releaseFile} names a :latest tag; there is none: ${s.trim().split('\n')[0]}`);
}

// The run: the jobs that touch the image, and the jobs they need that only check out and run
// scripts, such as the one that sets the release tag; any other job they need succeeds with its
// outputs that name a tag or a version set to the release's.
const touches = (job) =>
  (job.steps ?? []).some(
    (s) =>
      /^(docker|sigstore)\//.test(action(s)) ||
      attestsImage(s) ||
      lines(s).some((l) => /\b(docker|cosign|crane|skopeo|regctl|oras)\b|skald-server|ghcr\.io/.test(l)),
  );
const light = (job) =>
  !job.strategy &&
  (job.steps ?? []).every((s) => s.uses === undefined || action(s) === 'actions/checkout') &&
  !(job.steps ?? []).some((s) => lines(s).some((l) => /\b(cargo|dist|rustup|npm|npx|installers-test)\b/.test(l)));
const simulated = new Set(Object.keys(jobs).filter((k) => touches(jobs[k])));
const addNeeds = (key) => {
  for (const n of needsOf(jobs[key])) {
    if (jobs[n] && !simulated.has(n) && light(jobs[n])) {
      simulated.add(n);
      addNeeds(n);
    }
  }
};
[...simulated].forEach(addNeeds);
const order = [];
const visit = (key) => {
  if (order.includes(key) || !simulated.has(key)) return;
  needsOf(jobs[key]).forEach(visit);
  order.push(key);
};
[...simulated].forEach(visit);

const usesStatus = (v) => typeof v === 'string' && /\b(success|always|failure|cancelled)\s*\(/i.test(v);
// combinations <matrix>: the matrix's combinations, [{}] without one.
function combinations(matrix) {
  if (!matrix || typeof matrix !== 'object') return [{}];
  const keys = Object.keys(matrix).filter((k) => k !== 'include' && k !== 'exclude');
  let combos = [{}];
  for (const k of keys) combos = combos.flatMap((c) => [].concat(matrix[k] ?? []).map((v) => ({ ...c, [k]: v })));
  const include = [].concat(matrix.include ?? []);
  if (keys.length === 0 && include.length > 0) return include;
  return [...combos, ...include];
}
const git = (cwd, ...args) => {
  const r = spawnSync('git', ['-c', 'commit.gpgsign=false', '-c', 'tag.gpgsign=false', ...args], {
    cwd,
    encoding: 'utf8',
    env: {
      PATH: process.env.PATH,
      HOME: process.env.HOME,
      GIT_CONFIG_GLOBAL: '/dev/null',
      GIT_CONFIG_NOSYSTEM: '1',
      GIT_AUTHOR_NAME: 'test',
      GIT_AUTHOR_EMAIL: 'test@example.com',
      GIT_COMMITTER_NAME: 'test',
      GIT_COMMITTER_EMAIL: 'test@example.com',
    },
  });
  if (r.status !== 0) throw new Error(`git ${args.join(' ')}: ${r.stderr}`);
  return r.stdout.trim();
};

// run <event name> <ref> <workspace version> <registry tags> [<lookup error>]: runs the jobs on a
// stand-in GHCR that holds <registry tags>, each tag to its digest, and with <lookup error> fails
// every lookup of the image with an error other than not found; {state, sha, work, problems}: the
// registry and daemon afterwards, the commit run, the checkout's path, and the steps that failed or
// could not run.
function run(eventName, ref, version, registryTags, lookupError = false) {
  const tmp = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'release-image-test-')));
  const problems = [];
  try {
    const work = path.join(tmp, 'work');
    const bin = path.join(tmp, 'bin');
    const runner = path.join(tmp, 'runner');
    for (const dir of [work, bin, runner]) fs.mkdirSync(dir);
    // The checkout: the scripts and the crates, the workspace at <version>, one commit, its tag.
    fs.symlinkSync(path.join(root, 'script'), path.join(work, 'script'));
    fs.symlinkSync(path.join(root, 'crates'), path.join(work, 'crates'));
    fs.writeFileSync(path.join(work, 'Cargo.toml'), `[workspace.package]\nversion = "${version}"\n`);
    git(work, 'init', '-q');
    git(work, 'add', '-A');
    git(work, 'commit', '-q', '-m', 'release');
    const sha = git(work, 'rev-parse', 'HEAD');
    if (ref.startsWith('refs/tags/')) git(work, 'tag', ref.slice('refs/tags/'.length));
    const stateFile = path.join(tmp, 'registry.json');
    fs.writeFileSync(
      stateFile,
      JSON.stringify({
        image,
        tags: registryTags,
        manifests: [...new Set(Object.values(registryTags))],
        built: [],
        local: {},
        ids: {},
        writes: [],
        elsewhere: [],
        builds: [],
        signatures: [],
        attestations: [],
        unsupported: [],
        lookupError,
      }),
    );
    const state = () => JSON.parse(fs.readFileSync(stateFile, 'utf8'));
    for (const tool of ['docker', 'crane', 'skopeo', 'regctl', 'oras', 'cosign', 'gh', 'curl', 'wget']) {
      fs.writeFileSync(path.join(bin, tool), `#!/usr/bin/env bash\nexec "${process.execPath}" "${stub}" "${stateFile}" ${tool} "$@"\n`, { mode: 0o755 });
    }

    const ev = event(eventName, ref);
    const github = open({
      ...ev.github,
      sha,
      workspace: work,
      token: 'stub-token',
      actor: 'skald-release[bot]',
      server_url: 'https://github.com',
      run_id: '1',
      run_number: '1',
      run_attempt: '1',
    });
    const baseEnv = {
      PATH: `${bin}${path.delimiter}${process.env.PATH}`,
      HOME: process.env.HOME,
      TMPDIR: process.env.TMPDIR ?? os.tmpdir(),
      CI: 'true',
      GITHUB_ACTIONS: 'true',
      GITHUB_WORKSPACE: work,
      GITHUB_EVENT_NAME: eventName,
      GITHUB_REF: ref,
      GITHUB_REF_NAME: ev.refName,
      GITHUB_REF_TYPE: ref.startsWith('refs/tags/') ? 'tag' : 'branch',
      GITHUB_REPOSITORY: 'skald-so/skald',
      GITHUB_REPOSITORY_OWNER: 'skald-so',
      GITHUB_SHA: sha,
      GITHUB_ACTOR: 'skald-release[bot]',
      GITHUB_SERVER_URL: 'https://github.com',
      GITHUB_RUN_ID: '1',
      RUNNER_TEMP: runner,
      RUNNER_OS: 'Linux',
      RUNNER_ARCH: 'X64',
    };
    const value = (text, contexts, status) => {
      const v = template(text, { contexts, status });
      return isUnknown(v) ? '' : toText(v);
    };
    const results = {};
    let counter = 0;
    for (const key of order) {
      const job = jobs[key];
      const needs = {};
      for (const n of needsOf(job)) {
        if (results[n]) needs[n] = results[n];
        else {
          const outputs = {};
          for (const name of Object.keys(jobs[n]?.outputs ?? {})) {
            outputs[name] = /tag/i.test(name) ? ev.refName.startsWith('v') ? ev.refName : `v${version}` : /version/i.test(name) ? version : unknown();
          }
          needs[n] = { result: 'success', outputs: open(outputs) };
        }
      }
      const needResults = Object.values(needs).map((n) => n.result);
      const jobStatus = {
        success: needResults.every((r) => r === 'success'),
        failure: needResults.includes('failure'),
        always: true,
        cancelled: false,
      };
      const jobContexts = { github, needs, inputs: eventName === 'workflow_dispatch' ? open({}) : {}, vars: open({}) };
      let runs = usesStatus(job.if) ? true : jobStatus.success;
      if (job.if !== undefined && truth(condition(job.if, { contexts: jobContexts, status: jobStatus })) === false) runs = false;
      if (!runs) {
        results[key] = { result: 'skipped', outputs: {} };
        continue;
      }
      let ok = true;
      let jobOutputs = {};
      for (const matrix of combinations(job.strategy?.matrix)) {
        const steps = {};
        const env = { ...baseEnv, GITHUB_JOB: key };
        let failed = false;
        for (const [index, step] of (job.steps ?? []).entries()) {
          const status = { success: !failed, failure: failed, always: true, cancelled: false };
          const contexts = {
            ...jobContexts,
            env: open({}),
            steps: open(steps),
            matrix: open(matrix),
            runner: open({ temp: runner, os: 'Linux', arch: 'X64' }),
            secrets: open({ GITHUB_TOKEN: 'stub-token' }),
            job: open({}),
            strategy: open({}),
          };
          let go = usesStatus(step.if) ? true : !failed;
          if (step.if !== undefined && truth(condition(step.if, { contexts, status })) === false) go = false;
          if (!go) {
            if (step.id) steps[step.id] = { outputs: {}, outcome: 'skipped', conclusion: 'skipped' };
            continue;
          }
          const stepEnv = { ...env };
          for (const source of [release.env, job.env, step.env]) {
            for (const [k, v] of Object.entries(source ?? {})) stepEnv[k] = value(v, { ...contexts, env: open({ ...stepEnv }) }, status);
          }
          const stepContexts = { ...contexts, env: open({ ...stepEnv }) };
          const input = (name) => value(step.with?.[name], stepContexts, status);
          const where = stepName(key, step, index);
          let outputs = {};
          let passed = true;
          const kind = action(step);
          if (step.run !== undefined) {
            const shell = step.shell ?? job.defaults?.run?.shell ?? release.defaults?.run?.shell ?? 'bash';
            if (!/^bash\b/.test(shell)) {
              problems.push(`${where}: the test runs steps in bash only, not ${shell}`);
              passed = false;
            } else {
              const n = counter++;
              const files = Object.fromEntries(['output', 'env', 'path', 'summary'].map((f) => [f, path.join(runner, `${f}-${n}`)]));
              Object.values(files).forEach((f) => fs.writeFileSync(f, ''));
              const script = path.join(runner, `step-${n}.sh`);
              fs.writeFileSync(script, value(step.run, stepContexts, status));
              const cwd = path.resolve(work, value(step['working-directory'] ?? job.defaults?.run?.['working-directory'] ?? '.', stepContexts, status));
              const r = spawnSync('bash', ['--noprofile', '--norc', '-eo', 'pipefail', script], {
                cwd,
                env: { ...stepEnv, GITHUB_OUTPUT: files.output, GITHUB_ENV: files.env, GITHUB_PATH: files.path, GITHUB_STEP_SUMMARY: files.summary },
                encoding: 'utf8',
              });
              if (r.status !== 0) {
                problems.push(`${where} exits ${r.status}: ${(r.stderr ?? '').trim().split('\n').slice(-3).join(' | ')}`);
                passed = false;
              }
              const read = (file) => {
                const pairs = {};
                const text = fs.readFileSync(file, 'utf8').split('\n');
                for (let i = 0; i < text.length; i++) {
                  const heredoc = text[i].match(/^([A-Za-z_][A-Za-z0-9_-]*)<<(.+)$/);
                  const pair = text[i].match(/^([A-Za-z_][A-Za-z0-9_-]*)=(.*)$/);
                  if (heredoc) {
                    const end = text.indexOf(heredoc[2], i + 1);
                    pairs[heredoc[1]] = text.slice(i + 1, end < 0 ? text.length : end).join('\n');
                    i = end < 0 ? text.length : end;
                  } else if (pair) pairs[pair[1]] = pair[2];
                }
                return pairs;
              };
              outputs = read(files.output);
              Object.assign(env, read(files.env));
            }
          } else if (kind === 'docker/build-push-action') {
            const list = (name, separators) => input(name).split(separators).map((s) => s.trim()).filter(Boolean);
            const meta = path.join(runner, `metadata-${counter++}.json`);
            const context = input('context') || `https://github.com/skald-so/skald.git#${sha}`;
            const args = ['buildx', 'build', '--metadata-file', meta];
            if (input('file')) args.push('--file', input('file'));
            for (const t of list('tags', /[\n,]/)) args.push('--tag', t);
            for (const a of list('build-args', /\n/)) args.push('--build-arg', a);
            for (const c of list('cache-from', /\n/)) args.push('--cache-from', c);
            for (const o of list('outputs', /\n/)) args.push('--output', o);
            if (input('target')) args.push('--target', input('target'));
            if (input('platforms')) args.push('--platform', input('platforms'));
            if (!off(input('push'))) args.push('--push');
            if (!off(input('load'))) args.push('--load');
            args.push(context);
            const r = spawnSync(process.execPath, [stub, stateFile, 'docker', ...args], { cwd: work, env: stepEnv, encoding: 'utf8' });
            if (r.status !== 0) {
              problems.push(`${where}: the build fails: ${r.stderr.trim()}`);
              passed = false;
            } else {
              const metadata = JSON.parse(fs.readFileSync(meta, 'utf8'));
              outputs = { digest: metadata['containerimage.digest'], imageid: metadata['containerimage.config.digest'], metadata: JSON.stringify(metadata) };
            }
          } else if (/^actions\/(attest-build-provenance|attest)$/.test(kind)) {
            if (attestsImage(step)) {
              const s = state();
              const digest = input('subject-digest');
              s.attestations.push({ name: input('subject-name'), digest, pushed: s.manifests.includes(digest) });
              fs.writeFileSync(stateFile, JSON.stringify(s));
            }
          } else if (
            ![
              'actions/checkout',
              'actions/upload-artifact',
              'actions/download-artifact',
              'docker/setup-buildx-action',
              'docker/setup-qemu-action',
              'docker/login-action',
              'taiki-e/install-action',
            ].includes(kind)
          ) {
            problems.push(`${where}: the test has no stand-in for ${kind}`);
            passed = false;
          } else if (kind === 'actions/checkout') {
            const at = input('ref');
            if (input('repository') && input('repository') !== 'skald-so/skald') problems.push(`${where}: it checks out ${input('repository')}`);
            if (at && ![sha, ref, ev.refName].includes(at)) problems.push(`${where}: it checks out ${at}, not the commit of the run`);
          }
          if (step.id) steps[step.id] = { outputs: open(outputs), outcome: passed ? 'success' : 'failure', conclusion: passed ? 'success' : 'failure' };
          if (!passed && off(step['continue-on-error'])) failed = true;
        }
        if (failed) ok = false;
        const contexts = { ...jobContexts, steps: open(steps), matrix: open(matrix), env: open({}) };
        jobOutputs = Object.fromEntries(Object.entries(job.outputs ?? {}).map(([name, v]) => [name, value(v, contexts, { success: !failed, failure: failed, always: true, cancelled: false })]));
      }
      results[key] = { result: ok ? 'success' : 'failure', outputs: open(jobOutputs) };
    }
    return { state: state(), sha, work, problems };
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

const edge = `sha256:${'e'.repeat(64)}`;
const older = `sha256:${'0'.repeat(64)}`;
const previously = { edge, '1.2.2': older, 'v1.2.2': older, [`sha-${'a'.repeat(40)}`]: edge };
// checkBuilds <label> <result>: every build is of the image definition script/image-test builds, at
// the run's commit, and imports no cache; there is one at least.
function checkBuilds(label, { state, sha, work }) {
  if (state.builds.length === 0) fail(`${label}: no image is built`);
  for (const b of state.builds) {
    const file = path.relative(work, b.file);
    const gitContext = b.context === `https://github.com/skald-so/skald.git#${sha}`;
    if (dockerfile && file !== dockerfile) fail(`${label}: an image is built from ${file}, not ${dockerfile}, which script/image-test builds`);
    if (b.context !== work && !gitContext) fail(`${label}: an image is built with the context ${path.relative(work, b.context) || b.context}, not the repository`);
    if (b.buildArgs.REVISION !== sha) fail(`${label}: an image is built with REVISION=${b.buildArgs.REVISION ?? ''}, not the run's commit ${sha}`);
    if (b.target) fail(`${label}: an image is built for the target ${b.target}, not the image script/image-test builds`);
    if (b.cacheFrom.length > 0) fail(`${label}: an image build imports a cache: ${b.cacheFrom.join(', ')}`);
  }
}
const report = (label, { problems, state }) => {
  for (const p of problems) fail(`${label}: ${p}`);
  for (const u of state.unsupported) fail(`${label}: the stand-ins cannot run: ${u}`);
};

// A push of a release tag: the image of its version.
const forms = {};
for (const version of ['1.2.3', '1.2.4-beta.1']) {
  const label = `a push of v${version}`;
  const result = run('push', `refs/tags/v${version}`, version, { ...previously });
  const { state } = result;
  report(label, result);
  checkBuilds(label, result);
  const tagged = [...new Set(state.writes.filter((w) => w.tag !== null).map((w) => w.tag))];
  const versionTags = [version, `v${version}`];
  if (tagged.length !== 1 || !versionTags.includes(tagged[0])) {
    fail(`${label}: the image is pushed under one tag, ${version} or v${version}, not: ${tagged.join(', ') || 'none'}`);
  }
  for (const w of state.writes) if (w.before !== null) fail(`${label}: ${w.tool} moves the tag ${w.tag} from ${w.before} to ${w.digest}`);
  for (const [tag, digest] of Object.entries(previously)) {
    if (state.tags[tag] !== digest) fail(`${label}: the tag ${tag} moves to ${state.tags[tag]}`);
  }
  for (const e of state.elsewhere) fail(`${label}: ${e.tool} writes to another image: ${e.ref}`);
  const tag = tagged.length === 1 ? tagged[0] : null;
  const pushed = tag ? state.tags[tag] : null;
  if (tag) forms[label] = tag === version ? 'X.Y.Z' : 'vX.Y.Z';
  if (pushed && Object.values(previously).includes(pushed)) fail(`${label}: the tag ${tag} names an image GHCR had, not one built at the tag's commit`);
  if (pushed && !state.built.includes(pushed)) fail(`${label}: the tag ${tag} names ${pushed}, which no build of the run pushed`);

  const signed = state.signatures.filter((s) => s.command === 'sign');
  if (pushed && !signed.some((s) => s.ours && s.byDigest && s.digest === pushed)) {
    fail(`${label}: cosign signs no reference to the pushed digest, ${image}@${pushed}`);
  }
  for (const s of state.signatures) {
    if (!s.ours) fail(`${label}: cosign ${s.command} ${s.ref}: another image`);
    else if (!s.byDigest) fail(`${label}: cosign ${s.command} ${s.ref}: by a tag, not by the pushed digest`);
    else if (s.digest !== pushed) fail(`${label}: cosign ${s.command} ${s.ref}: not the pushed digest ${pushed}`);
    if (s.key) fail(`${label}: cosign ${s.command} ${s.ref}: with a key, not keyless`);
  }
  if (pushed && !state.attestations.some((a) => a.digest === pushed)) fail(`${label}: no build provenance attestation of the pushed digest ${pushed}`);
  for (const a of state.attestations) {
    if (a.name !== image) fail(`${label}: an attestation names the subject ${a.name}, not ${image}`);
    if (a.digest !== pushed) fail(`${label}: an attestation is of ${a.digest || 'no digest'}, not the pushed digest ${pushed}`);
    else if (!a.pushed) fail(`${label}: the image is attested before it is pushed`);
  }
}
if (Object.keys(forms).length === 2 && new Set(Object.values(forms)).size !== 1) {
  fail(`a stable release and a beta tag the image in the same form, not: ${Object.entries(forms).map(([l, f]) => `${l}, ${f}`).join('; ')}`);
}

// A version GHCR already has is not pushed again.
{
  const label = 'a push of v1.2.3 when GHCR has 1.2.3 and v1.2.3';
  const existing = `sha256:${'b'.repeat(64)}`;
  const { state } = run('push', 'refs/tags/v1.2.3', '1.2.3', { ...previously, '1.2.3': existing, 'v1.2.3': existing });
  for (const w of state.writes.filter((x) => x.tag !== null)) fail(`${label}: ${w.tool} pushes the tag ${w.tag} again`);
  for (const tag of ['1.2.3', 'v1.2.3', ...Object.keys(previously)]) {
    const before = tag in previously ? previously[tag] : existing;
    if (state.tags[tag] !== before) fail(`${label}: the tag ${tag} moves to ${state.tags[tag]}`);
  }
  for (const e of state.elsewhere) fail(`${label}: ${e.tool} writes to another image: ${e.ref}`);
  for (const u of state.unsupported) fail(`${label}: the stand-ins cannot run: ${u}`);
}

// A lookup of the version's tag that fails other than with not found: the tag may exist, so the run
// fails and pushes, signs and attests nothing.
{
  const label = 'a push of v1.2.3 when the lookup of the tag fails other than with not found';
  const { state, problems } = run('push', 'refs/tags/v1.2.3', '1.2.3', { ...previously }, true);
  if (problems.length === 0) fail(`${label}: the run passes`);
  for (const w of state.writes) fail(`${label}: ${w.tool} pushes ${w.ref}`);
  for (const e of state.elsewhere) fail(`${label}: ${e.tool} pushes ${e.ref}`);
  for (const s of state.signatures) fail(`${label}: cosign ${s.command} ${s.ref}`);
  for (const a of state.attestations) fail(`${label}: it attests ${a.name}@${a.digest}`);
  for (const [tag, digest] of Object.entries(previously)) {
    if (state.tags[tag] !== digest) fail(`${label}: the tag ${tag} moves to ${state.tags[tag]}`);
  }
  for (const u of state.unsupported) fail(`${label}: the stand-ins cannot run: ${u}`);
}

// The dry run builds the image and pushes, signs and attests nothing.
for (const [name, ref] of [
  ['pull_request', 'refs/pull/7/merge'],
  ['workflow_dispatch', 'refs/heads/dev'],
  ['workflow_dispatch', 'refs/tags/v1.2.3'],
]) {
  const label = `the dry run of a ${name} on ${ref}`;
  const result = run(name, ref, '1.2.3', { ...previously });
  const { state } = result;
  report(label, result);
  checkBuilds(label, result);
  for (const w of state.writes) fail(`${label}: ${w.tool} pushes ${w.ref}`);
  for (const e of state.elsewhere) fail(`${label}: ${e.tool} pushes ${e.ref}`);
  for (const s of state.signatures) fail(`${label}: cosign ${s.command} ${s.ref}`);
  for (const a of state.attestations) fail(`${label}: it attests ${a.name}@${a.digest}`);
}

// docs/dev/infrastructure.md.
const docs = fs.readFileSync(path.join(root, 'docs/dev/infrastructure.md'), 'utf8');
const section = (title) => docs.match(new RegExp(`^## ${title}\\n([\\s\\S]*?)(?=^## |(?![\\s\\S]))`, 'm'))?.[1] ?? '';
const channels = section('Channels');
const row = channels.split('\n').find((l) => l.startsWith('|') && /skald-server/.test(l));
if (!row) fail('"Channels" has no row of the skald-server image');
else if (!/GHCR/.test(row) || !/:v?(X\.Y\.Z|<version>|\d+\.\d+\.\d+)/.test(row)) {
  fail(`"Channels": the GHCR row of the skald-server image names no version tag, such as :X.Y.Z: ${row}`);
}
const trust = section('Trust in builds');
if (!trust) fail('docs/dev/infrastructure.md has no section "Trust in builds"');
// Its top-level items, each with its nested ones.
const items = trust.split(/\n(?=- )/);
if (!items.some((i) => /:edge\b/.test(i) && /\b(not|no|never|unsigned)\b/i.test(i) && /\bimages?\b/i.test(i))) {
  fail('"Trust in builds" does not say it covers release images, not :edge');
}
if (!items.some((i) => /\btags?\b/i.test(i) && /\b(mov(e|ed|es|ing)|mutable)\b/i.test(i) && /\bdigest\b/i.test(i) && /\bsignature\b/i.test(i))) {
  fail('"Trust in builds" does not say that GHCR tags can be moved, so an image is verified by its digest and signature');
}
const trustLines = trust.split('\n');
const byDigest = /ghcr\.io\/skald-so\/skald-server@sha256:/;
const cosignVerify = trustLines.filter((l) => /\bcosign\s+verify(?![\w-])/.test(l));
const identity = /--certificate-identity[\s=]+['"]?https:\/\/github\.com\/skald-so\/skald\/\.github\/workflows\/release\.yml@refs\/tags\/v/;
const issuer = /--certificate-oidc-issuer[\s=]+['"]?https:\/\/token\.actions\.githubusercontent\.com(?![\w/.-])/;
if (!cosignVerify.some((l) => byDigest.test(l) && identity.test(l) && issuer.test(l) && !/-regexp\b/.test(l))) {
  fail(
    '"Trust in builds" has no cosign verify command of the image by digest, ghcr.io/skald-so/skald-server@sha256:…, pinned to the exact identity https://github.com/skald-so/skald/.github/workflows/release.yml@refs/tags/vX.Y.Z and the issuer https://token.actions.githubusercontent.com: ' +
      (cosignVerify.map((l) => l.trim()).join(' | ') || 'none'),
  );
}
const workflowIdentity = 'skald-so/skald/\\.github/workflows/release\\.yml';
const pins = (line) =>
  /(--repo|-R)[\s=]+['"]?skald-so\/skald(?![\w/.-])/.test(line) &&
  ((new RegExp(`--signer-workflow[\\s=]+['"]?(https://)?(github\\.com/)?${workflowIdentity}`).test(line) &&
    /--source-ref[\s=]+['"]?refs\/tags\/v/.test(line)) ||
    new RegExp(`--cert-identity[\\s=]+['"]?https://github\\.com/${workflowIdentity}@refs/tags/v`).test(line));
const attestationVerify = trustLines.filter((l) => /\bgh\s+attestation\s+verify\s+['"]?oci:\/\/ghcr\.io\/skald-so\/skald-server@sha256:/.test(l));
if (!attestationVerify.some(pins)) {
  fail(
    '"Trust in builds" has no gh attestation verify command of oci://ghcr.io/skald-so/skald-server@sha256:… that pins the repository skald-so/skald, the release workflow and refs/tags/vX.Y.Z: ' +
      (attestationVerify.map((l) => l.trim()).join(' | ') || 'none'),
  );
}

if (failures > 0) {
  console.error(`release-image-test: ${failures} case(s) failed`);
  process.exit(1);
}
console.log('release-image-test: all cases passed');
