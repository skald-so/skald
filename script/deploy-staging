#!/usr/bin/env bash
# Deploys <digest>, the skald-server image built from <commit>, to staging, only while <commit> is the
# head of dev on origin, so staging never moves back: script/lib/dev-head.sh.
#
# Connects over SSH as the deploy key's account and runs `deploy <digest>` there, which passes only
# when the server runs the image and its health check answers ok; exits 0 only then. The connection
# comes only from the secrets of the GitHub environment staging, STAGING_SSH_KEY,
# STAGING_SSH_HOST_KEY and STAGING_SSH_DESTINATION: script/lib/ssh-deploy.sh.
# Prints the commit, the digest and the deploy's own output, its steps and the health check result;
# never these values.
# Usage: script/deploy-staging <commit> <digest>, in a clone of the repository.
set -euo pipefail
source "$(dirname "$0")/lib/dev-head.sh"
source "$(dirname "$0")/lib/ssh-deploy.sh"

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <commit> <digest>" >&2
  exit 2
fi
commit=$1 digest=$2
check_commit_and_digest deploy-staging "$commit" "$digest"
check_ssh_secrets deploy-staging STAGING

exit_unless_dev_head deploy-staging "$commit" staging

echo "deploy-staging: deploying $commit, $digest"
ssh_deploy deploy-staging STAGING deploy "$digest"
echo "deploy-staging: staging runs $commit, $digest"
