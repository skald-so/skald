#!/usr/bin/env bash
# Run in a checkout of dev, with its tags, on the merge of a Release PR (script/release-pr-merged):
# tags that commit v<version>, the workspace version of script/release-version, with an annotated
# tag through the GitHub API at $GITHUB_API_URL with the token $GH_TOKEN in $GITHUB_REPOSITORY. Does
# nothing when that tag is there already. Exits 2 on an error.
# .github/workflows/release-pr.yml runs it; script/release-tag-test tests it.
# Usage: script/release-tag
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)

error() {
  echo "release-tag: $*" >&2
  exit 2
}

for name in GITHUB_API_URL GITHUB_REPOSITORY GH_TOKEN; do
  [[ -n ${!name:-} ]] || error "$name is not set"
done
commit=$(git -C "$root" rev-parse --verify 'HEAD^{commit}') || error "no commit is checked out"
version=$("$root/script/release-version") || exit 2
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ ]] ||
  error "the workspace version $version is not X.Y.Z or X.Y.Z-beta.N"
tag=v$version
if git -C "$root" rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
  echo "release-tag: $tag is tagged already"
  exit 0
fi

# post <path> <JSON>: a POST to the repository's REST API; prints the response.
post() {
  curl --fail-with-body --silent --show-error --max-time 60 --request POST \
    --header "Authorization: Bearer $GH_TOKEN" --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' --data "$2" \
    "$GITHUB_API_URL/repos/$GITHUB_REPOSITORY$1" || error "POST $1 failed"
}

object=$(post /git/tags "$(jq -n --arg tag "$tag" --arg commit "$commit" \
  '{$tag, message: "chore: release \($tag)", object: $commit, type: "commit"}')" | jq -er .sha) ||
  error "the GitHub API created no tag object for $tag"
post /git/refs "$(jq -n --arg ref "refs/tags/$tag" --arg sha "$object" '{$ref, $sha}')" >/dev/null
echo "release-tag: tagged $commit $tag"
