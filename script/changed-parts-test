#!/usr/bin/env bash
# Tests script/changed-parts on a scratch repository: a PR checks only the parts of script/test it
# changes; the OpenAPI spec, scripts, CI and unknown paths check everything; docs, the root's
# Markdown files and site/ check the website, and so do any Markdown file and a removed path that
# docs/ links to.
# With --since, the changes from where HEAD branched off the base to the working tree count.
# The self-host stack's part: the paths of the server image, the browser's packages, the web app's
# build, the compose file, Caddy's config and the self-host guide, the one path in docs/ that marks
# another part than site.
# Also tests that script/test rejects an unknown part instead of skipping it, and that with
# SKALD_TEST_SINCE it checks the parts the changes since that base touch, on a copy that runs no
# check (script/lib/test-stand-ins.sh): every part when none or when that cannot be told; a change
# to each path of the Rust code alone runs the checks that read it. And that with sccache on PATH,
# script/test runs cargo with it as the compiler wrapper.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0

fail() {
  echo "changed-parts-test: $*" >&2
  failures=$((failures + 1))
}

# parts <base>: the parts changed-parts reports as true, space-separated, or `none`.
parts() {
  local output
  output=$("$root/script/changed-parts" "$1")
  output=$(sed -n 's/=true$//p' <<<"$output" | paste -sd ' ' -)
  echo "${output:-none}"
}

# apply <change>: `path` edits or creates a file, `-path` deletes it, `old->new` moves it.
apply() {
  case $1 in
    -*) git rm --quiet "${1#-}" ;;
    *'->'*)
      mkdir -p "$(dirname "${1#*->}")"
      git mv "${1%%->*}" "${1#*->}"
      ;;
    *)
      mkdir -p "$(dirname "$1")"
      echo change >>"$1"
      ;;
  esac
}

# changed [<change>...]: the parts a commit with <change>s on top of the base changes, as parts does.
changed() {
  git checkout --quiet --detach "$base"
  for change in "$@"; do apply "$change"; done
  git add --all
  git commit --quiet --allow-empty --message change
  parts "$base"
}

# expect <want> [<change>...]: a commit with <change>s on top of the base changes the parts <want>.
expect() {
  local want=$1 got
  shift
  got=$(changed "$@")
  [[ $got == "$want" ]] || fail "changes '$*': got '$got', want '$want'"
}

# marks <part> [<change>...]: a commit with <change>s on top of the base changes <part>, among
# others.
marks() {
  local part=$1 got
  shift
  got=$(changed "$@")
  [[ " $got " == *" $part "* ]] || fail "changes '$*': got '$got', want $part among them"
}

# A scratch repository, isolated from the user's git config.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
cd "$tmp"
git init --quiet
for file in api/openapi.json Cargo.toml Cargo.lock deny.toml crates/server/src/lib.rs \
  web/package.json web/package-lock.json web/src/App.tsx web/README.md docs/dev/roadmap.md task.md \
  web/logo.svg web/logo.svg.bak prototypes/mls/benchmarks/src/main.rs \
  prototypes/edits/overlap/dictionary/names.txt \
  docs/self-host.md site/package.json \
  crates/server/Dockerfile .dockerignore \
  prototypes/mls/Cargo.toml prototypes/mls/Cargo.lock prototypes/mls/openmls/src/lib.rs \
  prototypes/agents/Cargo.toml prototypes/agents/inbox/src/lib.rs \
  prototypes/edits/Cargo.toml prototypes/edits/overlap/src/lib.rs \
  script/test .github/workflows/ci.yml renovate.json .gitattributes; do
  apply "$file"
done
# Links that leave docs/ for files and a directory outside it.
cat >docs/dev/links.md <<'EOF2'
[Screenshots](../../web/README.md#reference-screenshots), [logo](../../web/logo.svg),
[benchmarks](../../prototypes/mls/benchmarks).
<img src="../../prototypes/edits/overlap/dictionary/names.txt"> [Policy](../../deny.toml)

[manifest]: ../../Cargo.toml
EOF2
git add --all
git commit --quiet --message base
base=$(git rev-parse HEAD)

# The parts of the Rust code, those the workspace's crates touch, and all of them.
rust='workspace wasm image self-host mls agents edits repository'
crates='workspace wasm image self-host repository'
all="$rust tooling web site"

# The browser tests of the workspace run the web app's build, and the self-host stack serves it.
expect 'workspace self-host web' web/src/App.tsx
expect 'workspace self-host web' web/public/robots.txt
expect 'workspace self-host web' web/index.html
expect 'workspace self-host web' web/vite.config.ts
expect 'workspace self-host web' web/tsconfig.app.json
expect web web/kit.test.ts
# The website's main page takes the web UI's theme; its browser tests, the kit's Chrome.
expect 'workspace self-host web site' web/src/theme/theme.css
expect 'web site' web/kit-browser.ts
# Any Markdown file: a link of docs/ can name its headings.
expect 'web site' web/README.md
# The server's and the client's sign-in tests and the website's browser tests drive Chrome with the
# playwright-core of web/; the self-host stack's part runs for its packages too.
expect 'workspace self-host web site' web/package.json
expect 'workspace self-host web site' web/package-lock.json
expect 'workspace self-host web site' -web/package.json
expect 'workspace self-host web site' web/src/App.tsx docs/dev/roadmap.md task.md

expect "$crates" crates/server/src/lib.rs
expect "$crates site" crates/server/README.md
expect "$crates" Cargo.toml
expect "$crates" Cargo.lock
expect "$crates site" crates/server/src/lib.rs docs/dev/roadmap.md
# The skald-server image: its definition and its build context.
expect "$crates" crates/server/Dockerfile
expect "$crates" crates/server/migrations/new.sql
expect "$crates" crates/proto/src/lib.rs
# cargo-deny's policy: script/deny and script/deny-test.
expect repository deny.toml

# Each prototype: its own part, and the copied code and release checks on the whole repository.
expect 'mls repository' prototypes/mls/openmls/src/lib.rs
expect 'mls repository' prototypes/mls/Cargo.toml
expect 'mls repository' prototypes/mls/mls-rs/src/lib.rs
expect 'mls repository' -prototypes/mls/openmls/src/lib.rs
# The crates' WASM tests take the wasm-bindgen of the MLS prototypes' Cargo.lock.
expect 'wasm mls repository' prototypes/mls/Cargo.lock
expect 'agents repository' prototypes/agents/inbox/src/lib.rs
expect 'agents repository' prototypes/agents/Cargo.toml
expect 'agents repository' prototypes/agents/new/src/lib.rs
expect 'edits repository' prototypes/edits/overlap/src/lib.rs
expect 'edits repository' prototypes/edits/Cargo.toml
expect 'edits repository' -prototypes/edits/overlap/src/lib.rs
expect 'agents edits repository' prototypes/agents/inbox/src/lib.rs prototypes/edits/Cargo.toml
expect 'agents edits repository' 'prototypes/edits/overlap/src/lib.rs->prototypes/agents/overlap.rs'
# Any other path in prototypes/: every part of the Rust code.
expect "$rust site" prototypes/README.md
expect "$rust" prototypes/new/src/lib.rs
expect "$rust" prototypes/mlsx/src/lib.rs

expect 'workspace wasm image self-host repository web' crates/server/src/lib.rs web/src/App.tsx
expect 'workspace wasm image self-host edits repository' crates/server/src/lib.rs prototypes/edits/Cargo.toml

expect "$all" api/openapi.json
expect "$all" script/test
expect "$all" script/new-check
expect "$all" .github/workflows/ci.yml
expect "$all" renovate.json
expect "$all" .gitattributes
expect "$all" .dockerignore
expect "$all" ee/LICENSE
expect "$all" api/README.md
expect "$all" web/src/App.tsx api/openapi.json
expect "$all" prototypes/edits/Cargo.toml script/test

# A removed path that docs/ links to, or that lies in a directory it links to, as a link's whole
# target: also the website.
expect web web/logo.svg
expect 'web site' -web/logo.svg
expect 'web site' 'web/logo.svg->web/logo-old.svg'
expect web -web/logo.svg.bak
expect 'workspace self-host web' -web/src/App.tsx
expect 'mls repository' prototypes/mls/benchmarks/src/main.rs
expect 'mls repository site' -prototypes/mls/benchmarks/src/main.rs
expect 'edits repository site' -prototypes/edits/overlap/dictionary/names.txt
expect 'repository site' -deny.toml
expect "$crates site" -Cargo.toml
# Without --since, HEAD counts, not the working tree.
changed -web/logo.svg >/dev/null
apply web/logo.svg
got=$(parts "$base")
[[ $got == 'web site' ]] || fail "a file removed in HEAD but not in the working tree: got '$got', want 'web site'"
rm web/logo.svg
expect site docs/dev/roadmap.md
expect site docs/dev/new.md task.md README.md
expect site site/package.json
expect site site/config.mjs
expect site -docs/dev/roadmap.md
expect none

# The self-host stack: its guide, the one path in docs/ that marks another part than site; the
# compose file, Caddy's config and the part's tests.
expect 'self-host site' docs/self-host.md
expect 'self-host site' docs/self-host.md docs/dev/infrastructure.md README.md
expect 'workspace self-host web site' docs/self-host.md web/src/App.tsx
expect site docs/dev/infrastructure.md
expect site docs/self-hosting.md
expect site docs/self-host/notes.md
expect 'self-host site' 'docs/self-host.md->docs/self-host-old.md'
expect self-host docker-compose.yml
marks self-host docker-compose.yml
marks self-host Caddyfile
marks self-host script/self-host-test
marks self-host script/lib/self-host/machine.Dockerfile

# A moved file counts in both places.
expect "$crates site" 'crates/server/src/lib.rs->docs/lib.rs'
expect 'web site' 'docs/dev/roadmap.md->web/roadmap.md'

# CI checks out the PR merged into dev and compares it with its first parent, dev:
# changes that reached dev after the PR branched do not count.
git checkout --quiet --detach "$base"
apply web/src/App.tsx
git commit --quiet --all --message pr
pr=$(git rev-parse HEAD)
git checkout --quiet --detach "$base"
apply crates/server/src/lib.rs
git commit --quiet --all --message dev
git merge --quiet --no-edit "$pr"
got=$(parts HEAD^1)
[[ $got == 'workspace self-host web' ]] || fail "merged PR: got '$got', want 'workspace self-host web'"

# The exact output, for $GITHUB_OUTPUT.
git checkout --quiet --detach "$base"
apply crates/server/src/lib.rs
git commit --quiet --all --message rust
got=$("$root/script/changed-parts" "$base")
want=$'workspace=true\nwasm=true\nimage=true\nself-host=true\nmls=false\nagents=false\nedits=false\nrepository=true\ntooling=false\nweb=false\nsite=false'
[[ $got == "$want" ]] || fail "output: got '$got', want '$want'"

if "$root/script/changed-parts" >/dev/null 2>&1; then
  fail "expected a usage error without arguments"
fi
if "$root/script/changed-parts" no-such-commit >/dev/null 2>&1; then
  fail "expected an error for an unknown base"
fi

# --since: the changes from where HEAD branched off the base to the working tree, untracked files
# included; changes that reached the base after HEAD branched do not count.
# since <want> <base>: changed-parts --since <base> reports the parts <want>.
since() {
  local got
  got=$("$root/script/changed-parts" --since "$2" | sed -n 's/=true$//p' | paste -sd ' ' -)
  [[ ${got:-none} == "$1" ]] || fail "--since $2: got '${got:-none}', want '$1'"
}
git checkout --quiet --detach "$base"
since none "$base"
apply prototypes/edits/overlap/src/lib.rs
git commit --quiet --all --message edits
since 'edits repository' "$base"
apply prototypes/agents/inbox/src/lib.rs
since 'agents edits repository' "$base"
git add --all
since 'agents edits repository' "$base"
git reset --quiet --hard
apply web/new.ts
since 'edits repository web' "$base"
# From a directory below the root too.
mkdir -p crates
got=$(cd crates && "$root/script/changed-parts" --since "$base" | sed -n 's/=true$//p' | paste -sd ' ' -)
[[ $got == 'edits repository web' ]] || fail "--since in crates/: got '$got', want 'edits repository web'"
rm web/new.ts
# A file docs/ links to, removed from the working tree.
rm web/logo.svg
since 'edits repository web site' "$base"
git checkout --quiet -- web/logo.svg
# A search of docs/ that fails, on an ignored file it cannot read, fails the script.
echo docs/unreadable >>.git/info/exclude
touch docs/unreadable
chmod 000 docs/unreadable
rm web/src/App.tsx
if "$root/script/changed-parts" --since "$base" >/dev/null 2>&1; then
  fail "expected an error when a file of docs/ cannot be read"
fi
rm -f docs/unreadable
git checkout --quiet -- web/src/App.tsx
branch=$(git rev-parse HEAD)
git checkout --quiet --detach "$base"
apply crates/server/src/lib.rs
git commit --quiet --all --message dev
moved=$(git rev-parse HEAD)
git checkout --quiet --detach "$branch"
since 'edits repository' "$moved"
got=$(parts "$moved")
[[ $got == 'edits repository' ]] || fail "a base that moved on after HEAD branched: got '$got', want 'edits repository'"
for args in '--since' "--since $base $base" "--base $base" "$base $base"; do
  # $args unquoted: its words are the arguments.
  status=0
  "$root/script/changed-parts" $args >/dev/null 2>&1 || status=$?
  [[ $status -eq 2 ]] || fail "changed-parts $args: exit code $status, want a usage error, 2"
done
if "$root/script/changed-parts" --since no-such-commit >/dev/null 2>&1; then
  fail "expected an error for an unknown base with --since"
fi

# A typo in SKALD_TEST_PARTS must not skip checks.
status=0
SKALD_TEST_PARTS='workspace,web' "$root/script/test" >/dev/null 2>&1 || status=$?
[[ $status -eq 2 ]] || fail "script/test with an unknown part: exit code $status, want 2"

# script/test with SKALD_TEST_SINCE, on a scratch repository with a copy of script/test that runs no
# check.
source "$root/script/lib/test-stand-ins.sh"
copy=$tmp/copy
test_stand_ins "$copy"
printf '/bin/\n/sysroot/\n/checks\n' >"$copy/.gitignore"
cd "$copy"
git init --quiet
for file in prototypes/edits/src/lib.rs prototypes/agents/src/lib.rs docs/dev/roadmap.md; do
  apply "$file"
done
git add --all
git commit --quiet --message base
copy_base=$(git rev-parse HEAD)
# checking <want> [<variable>=<value>...]: script/test of the copy, with only those of its variables
# set, checks the parts <want>, or exits with the code <want>, `exit <code>`.
checking() {
  local want=$1 output got status=0
  shift
  output=$(env -u SKALD_TEST_PARTS -u SKALD_TEST_SINCE "$@" PATH="$copy/bin:$PATH" "$copy/script/test" 2>/dev/null) ||
    status=$?
  got="exit $status"
  if ((status == 0)); then
    got=$(sed -n 's/^script\/test: checking \(.*\) $/\1/p' <<<"$output")
  fi
  [[ $got == "$want" ]] || fail "script/test with $*: got '$got', want '$want'"
}
checking "$all"
checking edits SKALD_TEST_PARTS=edits
# No change since the base: every part.
checking "$all" SKALD_TEST_SINCE="$copy_base"
apply docs/dev/roadmap.md
git commit --quiet --all --message docs
checking site SKALD_TEST_SINCE="$copy_base"
apply prototypes/edits/src/lib.rs
git commit --quiet --all --message edits
checking 'edits repository site' SKALD_TEST_SINCE="$copy_base"
# A base that moved on after HEAD branched off it: its new commits do not count.
branch=$(git rev-parse HEAD)
git checkout --quiet --detach "$copy_base"
apply prototypes/agents/src/lib.rs
git commit --quiet --all --message dev
moved=$(git rev-parse HEAD)
git checkout --quiet --detach "$branch"
checking 'edits repository site' SKALD_TEST_SINCE="$moved"
# Uncommitted and untracked changes count; ignored files do not.
apply prototypes/agents/src/lib.rs
checking 'agents edits repository site' SKALD_TEST_SINCE="$copy_base"
git checkout --quiet -- prototypes/agents/src/lib.rs
apply web/new.ts
checking 'edits repository web site' SKALD_TEST_SINCE="$copy_base"
rm web/new.ts
# A base the copy cannot compare with: every part.
checking "$all" SKALD_TEST_SINCE=no-such-commit
checking 'exit 2' SKALD_TEST_SINCE="$copy_base" SKALD_TEST_PARTS=edits
# With sccache on PATH, every run of cargo compiles through it.
mkdir "$tmp/sccache"
printf '#!/usr/bin/env bash\n' >"$tmp/sccache/sccache"
printf '#!/usr/bin/env bash\necho "${RUSTC_WRAPPER:-none} $*" >>%q\n' "$tmp/wrapped" >"$tmp/sccache/cargo"
chmod +x "$tmp/sccache/sccache" "$tmp/sccache/cargo"
env -u SKALD_TEST_SINCE SKALD_TEST_PARTS=workspace PATH="$tmp/sccache:$copy/bin:$PATH" "$copy/script/test" \
  >/dev/null 2>&1 || fail "script/test with sccache on PATH fails"
wrapped=$(cat "$tmp/wrapped" 2>/dev/null) || true
[[ $wrapped == *'sccache nextest run --workspace --locked'* && $(grep -v '^sccache ' <<<"$wrapped") == '' ]] ||
  fail "script/test with sccache on PATH runs cargo without it:"$'\n'"$wrapped"

# The checks that read a path run when only it changes: script/test of the copy with
# SKALD_TEST_SINCE runs the parts script/changed-parts selects, as CI runs them, one job each.
# reads <path> <check>...: a commit that changes only <path> runs each <check>, a command as the
# stand-ins log it, `<directory>: <command>` when it runs below the root.
reads() {
  local path=$1 check line log
  shift
  git checkout --quiet --detach "$copy_base"
  apply "$path"
  git add --all
  git commit --quiet --message change
  # The parts that run npm enter web/ and site/, which the copy's base does not track.
  mkdir -p "$copy/web" "$copy/site"
  rm -f "$copy/checks"
  if ! env -u SKALD_TEST_PARTS -u SKALD_TEST_SINCE SKALD_TEST_SINCE="$copy_base" PATH="$copy/bin:$PATH" \
    "$copy/script/test" >/dev/null 2>&1; then
    fail "script/test after a change to $path fails"
    return
  fi
  log=$(cat "$copy/checks")
  for check in "$@"; do
    if [[ $check == *': '* ]]; then line=${check%%: *}$'\t'${check#*: }; else line=$'\t'$check; fi
    grep -qxF -- "$line" <<<"$log" || fail "a change to $path alone does not run: $check"
  done
}
# The workspace's build, fmt, clippy and tests, of the crates in WASM, and the checks of the whole
# tree: copied code, cargo-deny and the release tests on copies of the working tree.
crate_checks=(
  'cargo build --workspace --all-targets --locked'
  'cargo fmt --all --check'
  'cargo clippy --workspace --all-targets --locked -- -D warnings'
  'cargo nextest run --workspace --locked'
  'cargo test --doc --workspace --locked'
  'cargo clippy --target wasm32-unknown-unknown -p skald-proto -p skald-crypto --all-targets --locked -- -D warnings'
  script/wasm-test
  script/image-test
  script/self-host-test
  'script/deny check advisories licenses'
  script/deny-test
)
tree_checks=(
  'script/duplicates crates prototypes'
  script/release-pr-test
  script/release-tag-test
)
# prototype_checks <directory>: the build, fmt, clippy and tests of the prototypes' workspace there.
prototype_checks=()
prototype() {
  local manifest="--manifest-path $1/Cargo.toml"
  prototype_checks=(
    "cargo build $manifest --workspace --all-targets --locked"
    "cargo fmt $manifest --all --check"
    "cargo clippy $manifest --workspace --all-targets --locked -- -D warnings"
    "cargo nextest run $manifest --workspace --locked"
    "cargo test $manifest --doc --workspace --locked"
  )
}
for path in crates/server/src/lib.rs crates/server/Dockerfile Cargo.toml Cargo.lock; do
  reads "$path" "${crate_checks[@]}" "${tree_checks[@]}"
done
reads deny.toml 'script/deny check advisories licenses' script/deny-test
prototype prototypes/mls
mls_checks=(
  "${prototype_checks[@]}"
  'prototypes/mls: cargo clippy --target wasm32-unknown-unknown --workspace --all-targets --locked -- -D warnings'
  'prototypes/mls: cargo test --target wasm32-unknown-unknown -p mls-proto-openmls -p mls-proto-mls-rs --test scenarios --locked'
  'prototypes/mls: cargo test --target wasm32-unknown-unknown -p mls-bench --test smoke --locked'
)
reads prototypes/mls/openmls/src/lib.rs "${mls_checks[@]}" "${tree_checks[@]}"
# The crates' WASM tests check that the workspace takes its wasm-bindgen.
reads prototypes/mls/Cargo.lock "${mls_checks[@]}" script/wasm-test "${tree_checks[@]}"
prototype prototypes/agents
reads prototypes/agents/inbox/src/lib.rs "${prototype_checks[@]}" "${tree_checks[@]}"
prototype prototypes/edits
reads prototypes/edits/overlap/src/lib.rs "${prototype_checks[@]}" "${tree_checks[@]}"
# The self-host stack's guide, compose file and Caddy config.
for path in docs/self-host.md docker-compose.yml Caddyfile; do
  reads "$path" script/self-host-test
done
# The website and docs: its packages and build for docs/, any Markdown file and site/.
for path in docs/dev/roadmap.md README.md web/README.md site/config.mjs; do
  reads "$path" 'site: npm ci --no-audit --no-fund' script/site-test script/site-browser-test
done
# The server's and the client's sign-in tests and the website's browser tests drive Chrome with the
# playwright-core of web/; the self-host stack's part runs for its packages too.
reads web/package.json 'cargo nextest run --workspace --locked' script/self-host-test 'web: npm run lint' \
  'web: npm test' 'web: npm run build' script/site-browser-test
# The website's browser tests take the kit's Chrome.
reads web/kit-browser.ts 'web: npm test' script/site-browser-test
# The self-host stack serves the web app's build.
reads web/src/App.tsx script/self-host-test 'web: npm run build'

if [[ $failures -ne 0 ]]; then
  echo "changed-parts-test: $failures case(s) failed" >&2
  exit 1
fi
echo "changed-parts-test: all cases passed"
