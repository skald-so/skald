#!/usr/bin/env bash
# Mutation check of the Rust code changed since <base-ref>: cargo-mutants mutates only the lines of the
# diff <base-ref>...HEAD and runs the tests of the mutated crate, with PostgreSQL and the S3-compatible
# server as in script/test; in each prototype workspace, prototypes/*, the tests of the whole
# workspace.
# Exits 0 only if the tests catch every mutant; otherwise lists the mutants they miss.
# Usage: script/mutants <base-ref>, in the repository to check, with its changes committed.
# CARGO_MUTANTS_JOBS sets how many mutants are tested in parallel; the default is half the CPUs.
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <base-ref>" >&2
  exit 2
fi
base=$1
source "$(dirname "$0")/lib/postgres.sh"
source "$(dirname "$0")/lib/s3.sh"

for tool in cargo-mutants docker; do
  if ! command -v "$tool" >/dev/null; then
    echo "script/mutants: $tool is missing; see CONTRIBUTING.md, \"Requirements\"" >&2
    exit 1
  fi
done

cd "$(git rev-parse --show-toplevel)"
if ! merge_base=$(git merge-base "$base" HEAD 2>/dev/null); then
  echo "script/mutants: cannot find where HEAD branched from '$base'" >&2
  exit 2
fi
# The mutants are copies of the working tree; the diff describes HEAD.
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
  echo "script/mutants: commit or discard the changes first: the check covers HEAD" >&2
  exit 2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"; postgres_stop; s3_stop' EXIT

# Each Cargo workspace gets its diff with paths relative to it. Plumbing ignores the diff settings of
# the user's git config; -M limits a moved file to its changed lines.
# The product crates count only the mutated crate's tests. A prototype workspace counts all of its
# tests: code its crates share runs only in the other crates' tests, such as the MLS scenarios.
git diff-tree -p -M "$merge_base" HEAD -- '*.rs' ':(exclude)prototypes' >"$tmp/root.diff"
root=(--workspace --in-diff "$tmp/root.diff")

# list_mutants <diff> <cargo-mutants args...>: lists the mutants of the Rust code the diff changes.
# Called in plain assignments, so that a failing list stops the script.
list_mutants() {
  if [[ -s $1 ]]; then cargo mutants --list "${@:2}"; fi
}
root_mutants=$(list_mutants "$tmp/root.diff" "${root[@]}")
# The prototype workspaces with mutants, by their directory in prototypes/; each one's diff and
# reports go to $tmp/prototypes/<directory>.
mkdir "$tmp/prototypes"
prototypes=()
for manifest in prototypes/*/Cargo.toml; do
  [[ -f $manifest ]] || continue
  name=${manifest#prototypes/}
  name=${name%/Cargo.toml}
  diff=$tmp/prototypes/$name.diff
  git diff-tree -p -M --relative="prototypes/$name" "$merge_base" HEAD -- '*.rs' >"$diff"
  mutants=$(list_mutants "$diff" --dir "prototypes/$name" --workspace --in-diff "$diff")
  [[ -z $mutants ]] || prototypes+=("$name")
done
if [[ -z $root_mutants && ${#prototypes[@]} -eq 0 ]]; then
  echo "script/mutants: no mutants in the Rust code changed since $base"
  exit 0
fi

ncpu=$(getconf _NPROCESSORS_ONLN)
jobs=(--jobs "${CARGO_MUTANTS_JOBS:-$(((ncpu + 1) / 2))}")
# cargo-mutants prints each mutant the tests miss as MISSED; its reports go out of the working tree.
status=0
if [[ -n $root_mutants ]]; then
  postgres_start
  s3_start
  postgres_wait
  s3_wait
  mkdir "$tmp/root"
  cargo mutants "${root[@]}" --test-workspace=false "${jobs[@]}" --output "$tmp/root" || status=$?
fi
# Bash 3.2, macOS's, treats an empty array as unset.
for name in ${prototypes[@]+"${prototypes[@]}"}; do
  echo "script/mutants: the prototypes in prototypes/$name"
  mkdir "$tmp/prototypes/$name"
  cargo mutants --dir "prototypes/$name" --workspace --in-diff "$tmp/prototypes/$name.diff" \
    --test-workspace=true "${jobs[@]}" --output "$tmp/prototypes/$name" || status=$?
done
exit $status
