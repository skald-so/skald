#!/usr/bin/env bash
# Tests .github/workflows/edge.yml: it runs only on pushes to dev, on every one, one run at a time;
# its token writes packages and nothing else; on a linux/amd64 runner it checks out the pushed
# commit, logs in to GHCR with its token, builds crates/server/Dockerfile, the image definition
# script/image-test tests, from that commit with the layer cache of earlier runs, pushes it to GHCR
# tagged with the commit and moves :edge with script/tag-edge. Then a deploy job, whose token only
# reads contents, deploys the published digest of the pushed commit with script/deploy-staging in
# the environment staging, with its secrets, the only job of any workflow that uses them; the
# workflow names no connection detail.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/script/lib/yaml.sh"
workflow=$root/.github/workflows/edge.yml
image=ghcr.io/skald-so/skald-server
environment=staging
staging_secrets='["secrets.STAGING_SSH_DESTINATION", "secrets.STAGING_SSH_HOST_KEY", "secrets.STAGING_SSH_KEY"]'
failures=0

fail() {
  echo "edge-workflow-test: $*" >&2
  failures=$((failures + 1))
}

json=$(to_json "$workflow")

# expect <what> <jq filter>: the filter is true for the workflow.
expect() {
  jq --exit-status "$2" <<<"$json" >/dev/null || fail "$1"
}

# The Dockerfile script/image-test builds: the one it names.
dockerfile=$(grep -o -- '--file [^ ]*' "$root/script/image-test" | sort -u | sed 's/^--file //')
[[ -n $dockerfile && $dockerfile != *$'\n'* ]] ||
  fail "script/image-test names no Dockerfile or several: '$dockerfile'"

expect "it sets nothing but its name, trigger, permissions, concurrency and jobs" \
  'keys == ["concurrency", "jobs", "name", "on", "permissions"]'
expect "runs on pushes to dev and on nothing else" '.on == {"push": {"branches": ["dev"]}}'
expect "its token reads contents and writes packages, nothing else" \
  '.permissions == {"contents": "read", "packages": "write"}'
expect "the publish job keeps the workflow's token; the deploy job's only reads contents" \
  '(.jobs.publish | has("permissions") | not) and .jobs.deploy.permissions == {"contents": "read"}'
expect "one run at a time, without cancelling a running one" \
  '.concurrency == {"group": "${{ github.workflow }}", "cancel-in-progress": false}'
expect "every action is pinned to a commit" \
  '[.jobs[].steps[] | select(has("uses")) | .uses | test("@[0-9a-f]{40}$")] | all'
expect "the checkout keeps no credentials" \
  '[.jobs[].steps[] | select(.uses // "" | startswith("actions/checkout@"))
    | .with["persist-credentials"] == false] | length > 0 and all'
expect "the checkout takes the pushed commit: it sets nothing but persist-credentials" \
  '[.jobs[].steps[] | select(.uses // "" | startswith("actions/checkout@"))
    | .with == {"persist-credentials": false}] | length > 0 and all'
# secrets <job>: the secrets the job names.
secrets='def secrets($job): [$job | .. | strings | scan("secrets\\.[A-Za-z0-9_]+")] | unique;'
expect "the publish job uses no secret but its token" \
  "$secrets secrets(.jobs.publish) == [\"secrets.GITHUB_TOKEN\"]"
expect "the deploy job uses no secret but those of the environment $environment" \
  "$secrets secrets(.jobs.deploy) == $staging_secrets"
expect "the workflow names no connection detail: no SSH URL, account at a host, address or host key" \
  '[.. | objects | to_entries[] | select(.key != "uses") | .value | strings
    | select(test("ssh://|ssh-[a-z0-9]+ |[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+|[A-Za-z0-9._-]+@[A-Za-z0-9.-]+"))]
    == []'
expect "two jobs: publish, then deploy" '.jobs | keys == ["deploy", "publish"]'

# The publish job: the checkout, Buildx, the login, the build, then the move of :edge.
job='.jobs.publish'
expect "the publish job runs on every push: it has no condition" "$job | has(\"if\") | not"
expect "the publish job sets nothing but its name, runner, outputs and steps" \
  "$job | keys == [\"name\", \"outputs\", \"runs-on\", \"steps\"]"
expect "the publish job's output is the built digest" \
  "$job.outputs == {\"digest\": \"\${{ steps.build.outputs.digest }}\"}"
expect "the publish job runs on ubuntu-latest, so the image is linux/amd64 like staging" \
  "$job[\"runs-on\"] == \"ubuntu-latest\""
expect "the steps: checkout, Buildx, the login, the build, the move of :edge" \
  "[$job.steps[] | .uses // .name | sub(\"@.*\"; \"\")] == [\"actions/checkout\",
    \"docker/setup-buildx-action\", \"docker/login-action\", \"docker/build-push-action\",
    \"Move :edge\"]"
expect "no step has a condition or may fail" \
  "[.jobs[].steps[] | keys - [\"env\", \"id\", \"name\", \"run\", \"uses\", \"with\"]] | add == []"
expect "Buildx runs with its defaults: its docker-container driver exports the layer cache" \
  "$job.steps[1] | keys == [\"uses\"]"
expect "the login before the build is to GHCR with the token" \
  "$job.steps[2].with == {\"registry\": \"ghcr.io\", \"username\": \"\${{ github.actor }}\",
    \"password\": \"\${{ secrets.GITHUB_TOKEN }}\"}"
build="[$job.steps[] | select(.uses // \"\" | startswith(\"docker/build-push-action@\"))]"
expect "one build" "$build | length == 1"
expect "the build uses $dockerfile with the repository as its context" \
  "$build[0].with | .file == \"$dockerfile\" and .context == \".\""
expect "the build names the pushed commit" \
  "$build[0].with[\"build-args\"] == \"REVISION=\${{ github.sha }}\""
expect "the build pushes $image tagged with the commit" \
  "$build[0].with | .push == true and .tags == \"$image:\${{ github.sha }}\""
expect "the build reuses the layers of earlier runs" \
  "$build[0].with | .[\"cache-from\"] == \"type=gha\" and .[\"cache-to\"] == \"type=gha,mode=max\""
expect "the build sets nothing else, such as a target stage or a platform" \
  "$build[0] | keys == [\"id\", \"uses\", \"with\"] and (.with | keys == [\"build-args\",
    \"cache-from\", \"cache-to\", \"context\", \"file\", \"push\", \"tags\"])"
expect "the step after the build moves :edge to the built digest of the pushed commit" \
  "$job.steps as \$steps | (\$steps | map(.id) | index(\"build\")) as \$i
    | \$steps[\$i].uses == $build[0].uses and \$steps[\$i + 1] == {
      \"name\": \"Move :edge\",
      \"env\": {\"DIGEST\": \"\${{ steps.build.outputs.digest }}\"},
      \"run\": \"script/tag-edge $image \\\"\$GITHUB_SHA\\\" \\\"\$DIGEST\\\"\"
    }"

# The deploy job: after the publish, the checkout of the pushed commit, then script/deploy-staging.
job='.jobs.deploy'
expect "the deploy job runs after the publish, on every push: it has no condition" \
  "$job.needs == \"publish\" and ($job | has(\"if\") | not)"
expect "the deploy job sets nothing but its name, needs, runner, permissions, environment, timeout and
    steps" \
  "$job | keys == [\"environment\", \"name\", \"needs\", \"permissions\", \"runs-on\", \"steps\",
    \"timeout-minutes\"]"
expect "the deploy job runs in the environment $environment" "$job.environment == \"$environment\""
expect "the deploy job runs on ubuntu-latest" "$job[\"runs-on\"] == \"ubuntu-latest\""
expect "the deploy job: the checkout, then the deploy" \
  "[$job.steps[] | .uses // .name | sub(\"@.*\"; \"\")] == [\"actions/checkout\", \"Deploy\"]"
expect "the deploy deploys the published digest of the pushed commit with the environment's secrets" \
  "$job.steps[1] == {
    \"name\": \"Deploy\",
    \"env\": {
      \"DIGEST\": \"\${{ needs.publish.outputs.digest }}\",
      \"STAGING_SSH_KEY\": \"\${{ secrets.STAGING_SSH_KEY }}\",
      \"STAGING_SSH_HOST_KEY\": \"\${{ secrets.STAGING_SSH_HOST_KEY }}\",
      \"STAGING_SSH_DESTINATION\": \"\${{ secrets.STAGING_SSH_DESTINATION }}\"
    },
    \"run\": \"script/deploy-staging \\\"\$GITHUB_SHA\\\" \\\"\$DIGEST\\\"\"
  }"

# No other workflow uses the environment or its secrets.
for file in "$root"/.github/workflows/*.yml "$root"/.github/workflows/*.yaml; do
  [[ -f $file && $file != "$workflow" ]] || continue
  if ! jq --exit-status --arg env "$environment" '[.jobs[]? | .environment
    | if type == "object" then .name else . end] | all(. != $env)' <<<"$(to_json "$file")" \
    >/dev/null; then
    fail "${file#"$root"/} uses the environment $environment"
  fi
  if grep -qE 'secrets\.STAGING_' "$file"; then
    fail "${file#"$root"/} reads the secrets of the environment $environment"
  fi
done

if [[ $failures -ne 0 ]]; then
  echo "edge-workflow-test: $failures case(s) failed" >&2
  exit 1
fi
echo "edge-workflow-test: all cases passed"
