#!/usr/bin/env bash
# Builds the web app of a release, web/ with the packages installed there, and writes into <dir>
# its archive, skald-web.tar.gz, and the archive's checksum, skald-web.tar.gz.sha256, as sha256sum
# writes it. The archive holds the build's files at its root and, in licenses/, skald's licenses and
# those of the packages and fonts the build bundles: every package that web/package-lock.json
# installs other than for development. Its index.html names the commit it was built from, HEAD:
# <meta name="skald-commit" content="<commit>">. It leaves the working tree as it was.
# The release workflow runs it after `npm ci` in web/ (docs/dev/infrastructure.md, "Release").
# Usage: script/release-web <dir>
set -euo pipefail

if [[ $# -ne 1 || -z $1 ]]; then
  echo "usage: $0 <dir>" >&2
  exit 2
fi
root=$(cd "$(dirname "$0")/.." && pwd)
web=skald-web.tar.gz
if [[ ! -d $root/web/node_modules ]]; then
  echo "release-web: web/node_modules is missing; install it first: cd web && npm ci" >&2
  exit 1
fi
commit=$(git -C "$root" rev-parse --verify HEAD)
mkdir -p "$1"
out=$(cd "$1" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
build=$tmp/build

# The build, outside the working tree.
(cd "$root/web" && npm run build -- --outDir "$build" --emptyOutDir) >&2

# The commit, in the head of index.html.
node -e '
  const fs = require("fs");
  const [file, commit] = process.argv.slice(1);
  const html = fs.readFileSync(file, "utf8");
  if ((html.match(/<head>/g) ?? []).length !== 1) throw new Error(`${file} has no single <head>`);
  fs.writeFileSync(file, html.replace("<head>", `<head>\n    <meta name="skald-commit" content="${commit}" />`));
' "$build/index.html" "$commit"

# The licenses.
mkdir "$build/licenses"
cp "$root/LICENSE-MIT" "$root/LICENSE-APACHE" "$build/licenses/"
node -e '
  const fs = require("fs");
  const path = require("path");
  const [web, file] = process.argv.slice(1);
  const lock = JSON.parse(fs.readFileSync(path.join(web, "package-lock.json"), "utf8"));
  const parts = [];
  for (const [key, p] of Object.entries(lock.packages ?? {})) {
    if (!key.startsWith("node_modules/") || p.dev || p.devOptional || p.optional || p.link) continue;
    const name = key.slice(key.lastIndexOf("node_modules/") + "node_modules/".length);
    const dir = path.join(web, key);
    const licenses = fs.readdirSync(dir).filter((f) => /^(licen[cs]e|copying)(\.(md|txt))?$/i.test(f)).sort();
    if (licenses.length === 0) throw new Error(`${key} has no license file, LICENSE or COPYING`);
    for (const license of licenses) {
      parts.push(`${name} ${p.version} (${p.license ?? "no license field"}), ${license}:\n\n${fs.readFileSync(path.join(dir, license), "utf8").trim()}\n`);
    }
  }
  fs.writeFileSync(file, parts.join("\n" + "-".repeat(80) + "\n\n"));
' "$root/web" "$build/licenses/THIRD-PARTY.txt"

# The archive, its files at its root, and its checksum. COPYFILE_DISABLE: macOS's tar adds no
# AppleDouble files.
rm -f "$out/$web" "$out/$web.sha256"
(cd "$build" && COPYFILE_DISABLE=1 tar -cf - .) | gzip -n -9 >"$tmp/$web"
mv "$tmp/$web" "$out/$web"
if command -v sha256sum >/dev/null; then
  (cd "$out" && sha256sum "$web" >"$web.sha256")
else
  (cd "$out" && shasum -a 256 "$web" >"$web.sha256")
fi
