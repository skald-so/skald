#!/usr/bin/env bash
# Builds the workspace and runs every check. Exits 0 only if all of them pass.
# SKALD_TEST_PARTS limits the run to some of its parts; CI sets it from script/changed-parts.
#   rust     build, fmt, clippy, tests with PostgreSQL, cargo-deny
#   tooling  tests of the scripts in script/, Renovate config validation
#   web      web UI lint, tests (with the kit page screenshots against their references) and build
set -euo pipefail

cd "$(dirname "$0")/.."
source script/lib/postgres.sh

parts=' '
for part in ${SKALD_TEST_PARTS:-}; do
  case $part in
    rust | tooling | web) parts+="$part " ;;
    *)
      echo "script/test: unknown part '$part' in SKALD_TEST_PARTS; parts: rust tooling web" >&2
      exit 2
      ;;
  esac
done
[[ $parts != ' ' ]] || parts=' rust tooling web '
# checks <part>: this run includes <part>.
checks() { [[ $parts == *" $1 "* ]]; }
echo "script/test: checking$parts"

if checks rust && ! command -v cargo-deny >/dev/null; then
  echo "script/test: cargo-deny is missing; install it: cargo install cargo-deny --locked" >&2
  exit 1
fi
if checks tooling && ! command -v cargo-mutants >/dev/null; then
  echo "script/test: cargo-mutants is missing; install it: cargo install cargo-mutants --locked" >&2
  exit 1
fi
if { checks rust || checks tooling || checks web; } && ! command -v docker >/dev/null; then
  echo "script/test: docker is missing; the integration tests run PostgreSQL and the kit page screenshots run Chrome in containers" >&2
  exit 1
fi
if { checks web || checks tooling; } && ! command -v npm >/dev/null; then
  echo "script/test: npm is missing; the web UI and the Renovate config check need Node.js: https://nodejs.org" >&2
  exit 1
fi

if checks rust; then
  # PostgreSQL for the integration tests starts while the workspace builds; removed on exit.
  trap postgres_stop EXIT
  postgres_start

  cargo build --workspace --all-targets --locked
  cargo fmt --all --check
  cargo clippy --workspace --all-targets --locked -- -D warnings

  postgres_wait
  cargo test --workspace --locked

  cargo deny --locked check advisories licenses
  script/deny-test
fi

if checks tooling; then
  script/check-pr-title-test
  script/changed-parts-test
  script/mutants-test
  # A pinned version: a newer Renovate can deprecate options and fail --strict on an unchanged config.
  npx --yes --package renovate@44.225.1 -- renovate-config-validator --strict --no-global renovate.json
fi

# Web UI: lint, tests (including the check that the API client is generated from the spec and the
# kit page screenshots against web/kit-references/) and build. A failed screenshot saves a diff image
# to web/kit-diff/.
if checks web; then
  (
    cd web
    npm ci --no-audit --no-fund
    npm run lint
    npm test
    npm run build
  )
fi
