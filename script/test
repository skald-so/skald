#!/usr/bin/env bash
# Builds the workspace and runs every check. Exits 0 only if all of them pass.
# SKALD_TEST_PARTS limits the run to some of its parts; CI sets it from script/changed-parts, one
# part per job. SKALD_TEST_SINCE=<base> limits it to the parts that the changes from where HEAD
# branched off <base> to the working tree touch, by script/changed-parts --since; with none, or when
# that cannot tell, it checks every part.
#   workspace  build, fmt, clippy and tests of the crates in crates/, with PostgreSQL and a local
#              S3-compatible server, those of script/check-github-sign-in and
#              script/check-google-sign-in among them, and, for the server's GitHub sign-in and the
#              client's sign-in, Chrome Headless Shell
#   wasm       clippy of skald-proto and skald-crypto in WASM, the tests of skald-crypto and
#              skald-proto's of ID generation there (script/wasm-test)
#   image      the skald-server image, built and tested with PostgreSQL in containers
#              (script/image-test)
#   mls        the MLS prototypes in prototypes/mls and their benchmarks' smoke run, natively and in
#              WASM
#   agents     the delivery prototypes in prototypes/agents
#   edits      the edit comparison prototype in prototypes/edits
#   repository copied code in crates/ and prototypes/ (script/duplicates); cargo-deny; the Release
#              PR and the release tags on fixture repositories, with git-cliff, and the CHANGELOG
#              section of v0.1.0 from the history
#   tooling    copied code in script/; tests of the scripts in script/, the staging deploy's against a
#              local sshd and the staging status check's on recorded GitHub API responses, of the CI
#              workflow, of the edge image and staging deploy workflow, of the Release PR workflow and
#              its release tags, of the release workflow, its release notes, the attestations of its
#              files and its image, its npm package, the move of main to a stable release, on fixture
#              repositories too, and of the installers in installers/ and the npm package on this
#              machine; of the release check and its jobs, against stand-ins for a release and the
#              verification commands; Renovate config validation
#   web        copied code in web/; web UI lint, tests (with the kit page screenshots against their
#              references) and build
set -euo pipefail

cd "$(dirname "$0")/.."
source script/lib/postgres.sh
source script/lib/s3.sh

all='workspace wasm image mls agents edits repository tooling web'
rust='workspace wasm image mls agents edits repository'
selected=${SKALD_TEST_PARTS:-}
if [[ -n ${SKALD_TEST_SINCE:-} ]]; then
  if [[ -n $selected ]]; then
    echo "script/test: SKALD_TEST_PARTS and SKALD_TEST_SINCE are both set; set one of them" >&2
    exit 2
  fi
  if ! changed=$(script/changed-parts --since "$SKALD_TEST_SINCE"); then
    echo "script/test: cannot tell what changed since $SKALD_TEST_SINCE; checking every part" >&2
  else
    selected=$(sed -n 's/=true$//p' <<<"$changed")
    [[ -n $selected ]] || echo "script/test: no part changed since $SKALD_TEST_SINCE; checking every part" >&2
  fi
fi
parts=' '
for part in $selected; do
  case " $all " in
    *" $part "*) parts+="$part " ;;
    *)
      echo "script/test: unknown part '$part'; parts: $all" >&2
      exit 2
      ;;
  esac
done
[[ $parts != ' ' ]] || parts=" $all "
# checks <part>: this run includes <part>.
checks() { [[ $parts == *" $1 "* ]]; }
# checks_any <part>...: this run includes one of the <part>s.
checks_any() {
  local part
  for part in "$@"; do
    if checks "$part"; then return 0; fi
  done
  return 1
}
echo "script/test: checking$parts"

# $rust unquoted: one word per part.
if checks_any $rust tooling && ! command -v cargo >/dev/null; then
  echo "script/test: cargo is missing; install Rust: https://rustup.rs" >&2
  exit 1
fi
if checks_any $rust tooling && ! command -v git >/dev/null; then
  echo "script/test: git is missing; the image labels and the tests of the scripts and the edit prototype run it: https://git-scm.com" >&2
  exit 1
fi
if checks repository && ! command -v cargo-deny >/dev/null; then
  echo "script/test: cargo-deny is missing; install it: cargo install cargo-deny --locked" >&2
  exit 1
fi
if checks_any wasm mls; then
  # The WASM tests of the workspace and of the MLS prototypes run in Node.js with one wasm-bindgen,
  # that of the prototypes' Cargo.lock (script/wasm-test checks the workspace's).
  wasm_bindgen=$(awk '$0 == "name = \"wasm-bindgen\"" { getline; gsub(/"/, "", $3); print $3 }' \
    prototypes/mls/Cargo.lock)
  if [[ ! -d $(rustc --print sysroot)/lib/rustlib/wasm32-unknown-unknown ]]; then
    echo "script/test: the WASM target is missing; install it: rustup target add wasm32-unknown-unknown" >&2
    exit 1
  fi
  if [[ $(wasm-bindgen-test-runner --version 2>/dev/null) != "wasm-bindgen-test-runner $wasm_bindgen" ]]; then
    echo "script/test: wasm-bindgen-test-runner $wasm_bindgen is missing; install it:" \
      "cargo install wasm-bindgen-cli --version $wasm_bindgen --locked" >&2
    exit 1
  fi
  if ! command -v node >/dev/null; then
    echo "script/test: node is missing; the WASM tests run in Node.js: https://nodejs.org" >&2
    exit 1
  fi
fi
if checks edits; then
  if ! python3 -c 'import ensurepip, venv' 2>/dev/null; then
    echo "script/test: python3 with its venv and ensurepip modules is missing; the edit comparison" \
      "prototype's tests install a package with pip in a virtual environment: https://www.python.org" \
      "(Debian and Ubuntu: the python3-venv package)" >&2
    exit 1
  fi
  # The edit comparison prototype reads the conflicts of `git merge-tree --write-tree -z`, git 2.39,
  # and the attributes of a commit with `git check-attr --source`, git 2.40.
  IFS=. read -r git_major git_minor _ <<<"$(git version | awk '{ print $3 }')"
  if ((git_major < 2 || (git_major == 2 && git_minor < 40))); then
    echo "script/test: git 2.40 or newer is missing; the edit comparison prototype runs git merge-tree" \
      "and git check-attr --source: https://git-scm.com" >&2
    exit 1
  fi
fi
if checks tooling; then
  for tool in ssh ssh-add ssh-agent ssh-keygen sshd; do
    if ! command -v "$tool" >/dev/null && [[ ! -x /usr/sbin/$tool ]]; then
      echo "script/test: $tool is missing; the staging deploy's test runs a local sshd: https://www.openssh.com" \
        "(Debian and Ubuntu: the openssh-client and openssh-server packages)" >&2
      exit 1
    fi
  done
fi
if checks tooling && ! command -v cargo-mutants >/dev/null; then
  echo "script/test: cargo-mutants is missing; install it: cargo install cargo-mutants --locked" >&2
  exit 1
fi
if ! command -v jq >/dev/null; then
  echo "script/test: jq is missing; the copied code check, the license policy test, the edge workflow test, script/check-github-sign-in and script/check-google-sign-in read JSON with it: https://jqlang.org" >&2
  exit 1
fi
if checks_any $rust tooling && ! command -v curl >/dev/null; then
  echo "script/test: curl is missing; the image test and the staging status check call the server's health check with it, the attachment storage tests sign requests to the S3-compatible server with it, the server's tests run script/check-github-sign-in and script/check-google-sign-in, the release tag test script/release-pr-merged, and script/install-git-cliff downloads git-cliff: https://curl.se" >&2
  exit 1
fi
if checks_any $rust tooling web && ! command -v docker >/dev/null; then
  echo "script/test: docker is missing; the integration tests run PostgreSQL and an S3-compatible server and the kit page screenshots run Chrome in containers" >&2
  exit 1
fi
if ! command -v npm >/dev/null; then
  echo "script/test: npm is missing; the copied code check, the web UI and the Renovate config check need Node.js: https://nodejs.org" >&2
  exit 1
fi
if checks_any $rust && ! command -v openssl >/dev/null; then
  echo "script/test: openssl is missing; the server's sign-in tests and the client's update and HTTPS tests make TLS certificates with it: https://openssl.org" >&2
  exit 1
fi
if checks_any $rust && ! command -v tar >/dev/null; then
  echo "script/test: tar is missing; the client's update tests pack a stand-in release's archives with it" >&2
  exit 1
fi

# web_packages: installs the packages of web/ from its lockfile, once per run, and the Chrome Headless
# Shell of its playwright-core, unless SKALD_CHROME names another browser: CONTRIBUTING.md. The web UI
# needs them, and so do the server's and the client's sign-in tests.
web_packages() {
  if [[ -z ${web_installed:-} ]]; then
    (cd web && npm ci --no-audit --no-fund)
    if [[ -z ${SKALD_CHROME:-} ]]; then
      node web/node_modules/playwright-core/cli.js install chromium-headless-shell
    fi
    web_installed=1
  fi
}

if checks repository; then
  script/duplicates crates prototypes
fi

if checks workspace; then
  # PostgreSQL and the S3-compatible server for the integration tests start while the workspace
  # builds; removed on exit.
  trap 'postgres_stop; s3_stop' EXIT
  postgres_start
  s3_start

  cargo build --workspace --all-targets --locked
  cargo fmt --all --check
  cargo clippy --workspace --all-targets --locked -- -D warnings

  web_packages
  postgres_wait
  s3_wait
  cargo test --workspace --locked
fi

if checks wasm; then
  # The code only WASM builds: skald-proto's clock, for one.
  cargo clippy --target wasm32-unknown-unknown -p skald-proto -p skald-crypto --all-targets --locked \
    -- -D warnings
  script/wasm-test
fi

if checks repository; then
  script/deny check advisories licenses
  script/deny-test
fi

if checks image; then
  script/image-test
fi

if checks mls; then
  # The MLS prototypes: a workspace of their own, apart from the product crates (script/deny-test).
  # They never ship, so cargo-deny does not check them.
  prototypes=(--manifest-path prototypes/mls/Cargo.toml)
  cargo build "${prototypes[@]}" --workspace --all-targets --locked
  cargo fmt "${prototypes[@]}" --all --check
  cargo clippy "${prototypes[@]}" --workspace --all-targets --locked -- -D warnings
  cargo test "${prototypes[@]}" --workspace --locked
  # The prototypes in WASM: the scenario suite and the benchmarks' smoke run run in Node.js, the
  # test runner that prototypes/mls/.cargo/config.toml sets. Cargo reads that config only from its
  # directory.
  (
    cd prototypes/mls
    cargo clippy --target wasm32-unknown-unknown --workspace --all-targets --locked -- -D warnings
    cargo test --target wasm32-unknown-unknown -p mls-proto-openmls -p mls-proto-mls-rs \
      --test scenarios --locked
    cargo test --target wasm32-unknown-unknown -p mls-bench --test smoke --locked
  )
fi

if checks agents; then
  # The delivery prototypes: a workspace of their own, like the MLS prototypes. Their live checks
  # run the installed agent CLIs, so script/test does not run them.
  prototypes=(--manifest-path prototypes/agents/Cargo.toml)
  cargo build "${prototypes[@]}" --workspace --all-targets --locked
  cargo fmt "${prototypes[@]}" --all --check
  cargo clippy "${prototypes[@]}" --workspace --all-targets --locked -- -D warnings
  cargo test "${prototypes[@]}" --workspace --locked
fi

if checks edits; then
  # The edit comparison prototype: a workspace of its own, like the MLS prototypes. Its tests run git.
  edits=(--manifest-path prototypes/edits/Cargo.toml)
  cargo build "${edits[@]}" --workspace --all-targets --locked
  cargo fmt "${edits[@]}" --all --check
  cargo clippy "${edits[@]}" --workspace --all-targets --locked -- -D warnings
  cargo test "${edits[@]}" --workspace --locked
fi

if checks tooling; then
  script/duplicates script
  script/duplicates-test
  script/check-pr-title-test
  script/changed-parts-test
  script/mutants-test
  script/tag-edge-test
  script/deploy-staging-test
  script/staging-status-test
  script/ci-workflow-test
  script/edge-workflow-test
  script/release-pr-workflow-test
  script/install-git-cliff-test
  # A pinned version: a newer Renovate can deprecate options and fail --strict on an unchanged config.
  npx --yes --package renovate@44.225.1 -- renovate-config-validator --strict --no-global renovate.json
fi

# The Release PR on fixture repositories, with git-cliff.
if checks repository; then
  script/release-pr-test
fi

# Web UI: lint, tests (including the check that the API client is generated from the spec and the
# kit page screenshots against web/kit-references/) and build. A failed screenshot saves a diff image
# to web/kit-diff/.
if checks web; then
  script/duplicates web
  web_packages
  (
    cd web
    npm run lint
    npm test
    npm run build
  )
fi

# The release tags: the tagging workflow, and the tags on fixture repositories.
if checks tooling; then
  script/release-tag-workflow-test
  script/release-tag-step-test
fi
if checks repository; then
  script/release-tag-test
fi

# The release workflow: what it publishes to GitHub Releases, on which events and with which rules;
# its publishing step, the release notes, the attestations of the release files and how to verify
# them, the release image and how to verify it, the npm package and how to verify it, the move of
# main to a stable release, on fixture repositories too, and the installers and the npm package
# against a stand-in release; the release check's jobs, and the release check against stand-ins for
# a release and the verification commands.
if checks tooling; then
  script/release-workflow-test
  script/release-jobs-test
  script/release-step-test
  script/release-notes-test
  script/release-attest-test
  script/release-image-test
  script/installers-test
  script/npm-package-test
  script/release-npm-workflow-test
  script/move-main-workflow-test
  script/move-main-test
  script/release-check-workflow-test
  script/release-check-test
  script/release-check-steps-test
fi
