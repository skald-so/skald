#!/usr/bin/env bash
# Builds the workspace and runs every check. Exits 0 only if all of them pass.
# SKALD_TEST_PARTS limits the run to some of its parts; CI sets it from script/changed-parts.
#   rust     build, fmt, clippy, tests with PostgreSQL, cargo-deny
#   tooling  tests of the CI scripts, Renovate config validation
#   web      web UI lint, tests and build
set -euo pipefail

cd "$(dirname "$0")/.."

parts=' '
for part in ${SKALD_TEST_PARTS:-}; do
  case $part in
    rust | tooling | web) parts+="$part " ;;
    *)
      echo "script/test: unknown part '$part' in SKALD_TEST_PARTS; parts: rust tooling web" >&2
      exit 2
      ;;
  esac
done
[[ $parts != ' ' ]] || parts=' rust tooling web '
# checks <part>: this run includes <part>.
checks() { [[ $parts == *" $1 "* ]]; }
echo "script/test: checking$parts"

if checks rust && ! command -v cargo-deny >/dev/null; then
  echo "script/test: cargo-deny is missing; install it: cargo install cargo-deny --locked" >&2
  exit 1
fi
if checks rust && ! command -v docker >/dev/null; then
  echo "script/test: docker is missing; the integration tests run PostgreSQL in a container" >&2
  exit 1
fi
if { checks web || checks tooling; } && ! command -v npm >/dev/null; then
  echo "script/test: npm is missing; the web UI and the Renovate config check need Node.js: https://nodejs.org" >&2
  exit 1
fi

if checks rust; then
  # PostgreSQL for the integration tests, removed on exit. 19rc1 until PostgreSQL 19.0 is released.
  postgres=$(docker run --detach --rm --env POSTGRES_PASSWORD=skald --publish 127.0.0.1::5432 \
    postgres:19rc1 -c fsync=off)
  trap 'docker rm --force "$postgres" >/dev/null' EXIT

  cargo build --workspace --all-targets --locked
  cargo fmt --all --check
  cargo clippy --workspace --all-targets --locked -- -D warnings

  # The image's init scripts run on a server without TCP; the final server listens on TCP.
  for _ in $(seq 120); do
    docker exec "$postgres" pg_isready --quiet --host 127.0.0.1 --username postgres && break
    sleep 0.5
  done
  if ! docker exec "$postgres" pg_isready --quiet --host 127.0.0.1 --username postgres; then
    echo "script/test: PostgreSQL did not start" >&2
    docker logs "$postgres" >&2
    exit 1
  fi
  SKALD_TEST_DATABASE_URL="postgres://postgres:skald@$(docker port "$postgres" 5432/tcp | head -n 1)" \
    cargo test --workspace --locked

  cargo deny --locked check advisories licenses
  script/deny-test
fi

if checks tooling; then
  script/check-pr-title-test
  script/changed-parts-test
  # A pinned version: a newer Renovate can deprecate options and fail --strict on an unchanged config.
  npx --yes --package renovate@44.225.1 -- renovate-config-validator --strict --no-global renovate.json
fi

# Web UI: lint, tests (including the check that the API client is generated from the spec) and build.
if checks web; then
  (
    cd web
    npm ci --no-audit --no-fund
    npm run lint
    npm test
    npm run build
  )
fi
