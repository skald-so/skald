#!/usr/bin/env bash
# Tests script/mutants on a scratch Cargo workspace: it passes when the tests catch every mutant of the
# code changed since the base, fails naming the survivors otherwise, never mutates unchanged code,
# runs the tests with cargo-nextest and PostgreSQL and removes PostgreSQL afterwards, compiles
# through sccache when it is on PATH, fails naming a mutant whose tests run past 3 times the
# unmutated tree's test time, checks each prototype workspace with the tests of all its crates, fails
# when cargo-mutants cannot list the mutants, and leaves the working tree clean.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0

fail() {
  echo "mutants-test: $*" >&2
  failures=$((failures + 1))
}

# script/mutants starts its own PostgreSQL: a database of the caller, e.g. script/test, must not hide it.
unset SKALD_TEST_DATABASE_URL
# The fixture's survivors are expected: no GitHub annotations for them in CI.
unset GITHUB_ACTION

# run <base>: runs script/mutants <base>, setting $status and $output.
run() {
  status=0
  output=$("$root/script/mutants" "$1" 2>&1) || status=$?
}

# expect_clean <case>: the run left the working tree and the index as they were.
expect_clean() {
  local changes
  changes=$(git status --porcelain --ignored --untracked-files=all)
  [[ -z $changes ]] || fail "$1: the working tree changed:"$'\n'"$changes"
}

# expect_postgres_removed <case>: the fixture's tests reached PostgreSQL, which is now gone.
expect_postgres_removed() {
  local url
  url=$(cat "$tmp/postgres-url" 2>/dev/null) || {
    fail "$1: the tests did not reach PostgreSQL"
    return
  }
  rm "$tmp/postgres-url"
  local addr=${url##*@}
  if (exec 3<>"/dev/tcp/${addr%:*}/${addr##*:}") 2>/dev/null; then
    fail "$1: PostgreSQL at $addr still runs"
  fi
}

# A scratch repository, isolated from the user's git config.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
mkdir "$tmp/repo"
cd "$tmp/repo"
git init --quiet --initial-branch dev

# A workspace like this one: a virtual manifest and crates/*. `untested` has no test and is never
# changed; `postgres_is_reachable` records the database it reached for expect_postgres_removed, and
# `records_its_runner` whether cargo-nextest runs it.
mkdir -p crates/calc/src
printf '[workspace]\nmembers = ["crates/*"]\nresolver = "3"\n' >Cargo.toml
printf '[package]\nname = "calc"\nversion = "0.1.0"\nedition = "2024"\n' >crates/calc/Cargo.toml
cat >crates/calc/src/lib.rs <<RUST
pub fn double(x: u32) -> u32 {
    x * 2
}

pub fn untested(x: u32) -> u32 {
    x + 1
}

#[cfg(test)]
mod tests {
    #[test]
    fn double() {
        assert_eq!(super::double(3), 6);
    }

    #[test]
    fn postgres_is_reachable() {
        let url = std::env::var("SKALD_TEST_DATABASE_URL").expect("SKALD_TEST_DATABASE_URL is set");
        let addr = url.rsplit('@').next().expect("an address");
        std::net::TcpStream::connect(addr).expect("connect to PostgreSQL");
        std::fs::write(r"$tmp/postgres-url", url).expect("record the database");
    }

    #[test]
    fn records_its_runner() {
        let runner = if std::env::var_os("NEXTEST").is_some() { "nextest" } else { "cargo test" };
        std::fs::write(r"$tmp/runner", runner).expect("record the test runner");
    }
}
RUST
echo /target >.gitignore
echo '# calc' >README.md
cargo generate-lockfile --quiet --offline
git add --all
git commit --quiet --message base
git branch base

# A covered change: every mutant is caught. A later change of `untested` in the base branch
# is not part of the diff, and neither is the rest of the file.
git checkout --quiet -b covered
sed -i.bak 's/x \* 2/x << 1/' crates/calc/src/lib.rs && rm crates/calc/src/lib.rs.bak
git commit --quiet --all --message covered
git checkout --quiet dev
sed -i.bak 's/x + 1/x + 2/' crates/calc/src/lib.rs && rm crates/calc/src/lib.rs.bak
git commit --quiet --all --message 'change untested'
git checkout --quiet covered
# A stand-in for sccache on PATH, which records each compile and runs it.
mkdir "$tmp/bin"
printf '#!/usr/bin/env bash\necho "$*" >>%q\nexec "$@"\n' "$tmp/compiles" >"$tmp/bin/sccache"
chmod +x "$tmp/bin/sccache"
PATH="$tmp/bin:$PATH" run dev
[[ $status -eq 0 ]] || fail "covered: exit code $status, want 0:"$'\n'"$output"
[[ $output != *untested* ]] || fail "covered: mutated unchanged code:"$'\n'"$output"
[[ $(cat "$tmp/runner" 2>/dev/null) == nextest ]] || fail "covered: cargo-nextest did not run the tests"
grep -q -- '--crate-name calc ' "$tmp/compiles" 2>/dev/null || fail "covered: calc was not compiled through sccache"
expect_clean covered
expect_postgres_removed covered

# A new function tested only by another crate, next to a covered change, in a moved crate, and a new
# crate without tests: the run fails and names only the survivors in the changed lines. Only the
# mutated crate's tests count; a crate's run of no tests catches no mutant.
git checkout --quiet -b uncovered base
git mv crates/calc crates/math
sed -i.bak 's/x \* 2/x << 1/' crates/math/src/lib.rs && rm crates/math/src/lib.rs.bak
printf '\npub fn triple(x: u32) -> u32 {\n    x * 3\n}\n' >>crates/math/src/lib.rs
mkdir -p crates/report/src
printf '[package]\nname = "report"\nversion = "0.1.0"\nedition = "2024"\n\n[dependencies]\n%s\n' \
  'calc = { path = "../math" }' >crates/report/Cargo.toml
printf '#[test]\nfn triple() {\n    assert_eq!(calc::triple(2), 6);\n}\n' >crates/report/src/lib.rs
mkdir -p crates/label/src
printf '[package]\nname = "label"\nversion = "0.1.0"\nedition = "2024"\n' >crates/label/Cargo.toml
printf 'pub fn label(x: u32) -> String {\n    format!("#{x}")\n}\n' >crates/label/src/lib.rs
cargo generate-lockfile --quiet --offline
git add --all
git commit --quiet --message uncovered
run base
[[ $status -ne 0 ]] || fail "uncovered: exit code 0, want non-zero:"$'\n'"$output"
[[ $output =~ crates/math/src/lib\.rs:[0-9]+:[0-9]+:\ replace\ triple\ -\>\ u32\ with\ 0 ]] ||
  fail "uncovered: the survivor is not named:"$'\n'"$output"
[[ $output =~ crates/label/src/lib\.rs:[0-9]+:[0-9]+:\ replace\ label\ -\>\ String\ with\ String::new\(\) ]] ||
  fail "uncovered: the survivor in the crate without tests is not named:"$'\n'"$output"
[[ $output != *untested* && $output != *double* ]] ||
  fail "uncovered: names mutants outside the changed lines or caught ones:"$'\n'"$output"
expect_clean uncovered
expect_postgres_removed uncovered

# A change whose mutants `-=` to `+=` and to `/=` make its test loop forever: the run fails and names
# them as timeouts, which come at 3 times the unmutated tree's test time, not at cargo-mutants' 5
# times. A test of 3 s sets that time, under cargo-mutants' minimum timeout of 20 s, which this case
# lowers to 1 s. cargo-mutants prints whole seconds: an unmutated time of 3 s is under 4 s.
git checkout --quiet -b hangs base
cat >>crates/calc/src/lib.rs <<'RUST'

pub fn steps(mut x: u64) -> u64 {
    let mut n = 0;
    while x != 0 {
        x -= 1;
        n += 1;
    }
    n
}
RUST
mkdir crates/calc/tests
printf '#[test]\nfn steps() {\n    assert_eq!(calc::steps(3), 3);\n}\n\n#[test]\nfn three_seconds() {\n    %s\n}\n' \
  'std::thread::sleep(std::time::Duration::from_secs(3));' >crates/calc/tests/steps.rs
git add --all
git commit --quiet --message hangs
CARGO_MUTANTS_MINIMUM_TEST_TIMEOUT=1 run base
[[ $status -ne 0 ]] || fail "hangs: exit code 0, want non-zero:"$'\n'"$output"
for op in '+=' '/='; do
  grep '^TIMEOUT .*crates/calc/src/lib\.rs:' <<<"$output" | grep -qF ": replace -= with $op in steps" ||
    fail "hangs: the timeout of -= to $op is not named:"$'\n'"$output"
done
if [[ $output =~ Unmutated\ baseline\ in\ [0-9]+s\ build\ \+\ ([0-9]+)s\ test ]]; then
  unmutated=${BASH_REMATCH[1]}
  if [[ $output =~ Auto-set\ test\ timeout\ to\ ([0-9]+)s ]]; then
    ((BASH_REMATCH[1] <= 3 * (unmutated + 1))) ||
      fail "hangs: a timeout of ${BASH_REMATCH[1]} s, past 3 times the unmutated tree's ${unmutated} s:"$'\n'"$output"
  else
    fail "hangs: no test timeout:"$'\n'"$output"
  fi
else
  fail "hangs: no unmutated tree's test time:"$'\n'"$output"
fi
expect_clean hangs
expect_postgres_removed hangs

# Changes only in two prototype workspaces, each apart from the others: in each, code tested only by
# another of its crates is covered, and an untested function is named as a survivor.
git checkout --quiet -b prototypes base
# prototype <dir> <shared crate> <testing crate> <tested fn> <untested fn>: a prototype workspace in
# prototypes/<dir>; the testing crate tests only the tested function of the shared crate.
prototype() {
  local dir=prototypes/$1 shared=$2 testing=$3 tested=$4 untested=$5
  mkdir -p "$dir/$shared/src" "$dir/$testing/src"
  printf '[workspace]\nmembers = ["%s", "%s"]\nresolver = "3"\n' "$shared" "$testing" >"$dir/Cargo.toml"
  printf '[package]\nname = "%s"\nversion = "0.1.0"\nedition = "2024"\n' "$shared" >"$dir/$shared/Cargo.toml"
  printf 'pub fn %s(x: u32) -> u32 {\n    x / 2\n}\n\npub fn %s(x: u32) -> u32 {\n    x / 4\n}\n' \
    "$tested" "$untested" >"$dir/$shared/src/lib.rs"
  printf '[package]\nname = "%s"\nversion = "0.1.0"\nedition = "2024"\n\n[dependencies]\n%s = { path = "../%s" }\n' \
    "$testing" "$shared" "$shared" >"$dir/$testing/Cargo.toml"
  printf '#[test]\nfn %s() {\n    assert_eq!(%s::%s(6), 3);\n}\n' "$tested" "$shared" "$tested" \
    >"$dir/$testing/src/lib.rs"
  (cd "$dir" && cargo generate-lockfile --quiet --offline)
}
prototype mls scenario proto half quarter
prototype agents source live halve fourth
git add --all
git commit --quiet --message prototypes
run base
[[ $status -ne 0 ]] || fail "prototypes: exit code 0, want non-zero:"$'\n'"$output"
[[ $output =~ scenario/src/lib\.rs:[0-9]+:[0-9]+:\ replace\ quarter\ -\>\ u32\ with\ 0 ]] ||
  fail "prototypes: the survivor in prototypes/mls is not named:"$'\n'"$output"
[[ $output =~ source/src/lib\.rs:[0-9]+:[0-9]+:\ replace\ fourth\ -\>\ u32\ with\ 0 ]] ||
  fail "prototypes: the survivor in prototypes/agents is not named:"$'\n'"$output"
[[ $output != *half* && $output != *halve* ]] || fail "prototypes: names a caught mutant:"$'\n'"$output"
expect_clean prototypes

# A change only in the edit comparison prototype's workspace, prototypes/edits: code tested only by
# another of its crates is covered, and an untested function there is named.
git checkout --quiet -b edits base
prototype edits overlap harness halved quartered
git add --all
git commit --quiet --message edits
run base
[[ $status -ne 0 ]] || fail "edits: exit code 0, want non-zero:"$'\n'"$output"
[[ $output =~ overlap/src/lib\.rs:[0-9]+:[0-9]+:\ replace\ quartered\ -\>\ u32\ with\ 0 ]] ||
  fail "edits: the survivor is not named:"$'\n'"$output"
[[ $output != *halved* ]] || fail "edits: names a caught mutant:"$'\n'"$output"
expect_clean edits

# A cargo-mutants config it rejects: listing the mutants fails, and so does the run, testing nothing.
git checkout --quiet -b bad-config prototypes
mkdir prototypes/mls/.cargo
echo 'exclude_re = ["("]' >prototypes/mls/.cargo/mutants.toml
git add --all
git commit --quiet --message 'bad config'
run base
[[ $status -ne 0 && $output != *'no mutants'* && $output != *MISSED* ]] ||
  fail "bad config: exit code $status, want non-zero without testing:"$'\n'"$output"
expect_clean bad-config

# No Rust changes: nothing to mutate, PostgreSQL is not needed.
git checkout --quiet -b docs base
echo 'A calculator.' >>README.md
git commit --quiet --all --message docs
run base
[[ $status -eq 0 && $output == *'no mutants'* ]] || fail "docs: exit code $status, want 0:"$'\n'"$output"
[[ ! -e $tmp/postgres-url ]] || fail "docs: the tests ran"

# Uncommitted changes: the diff would not describe the mutated tree.
echo '// draft' >>crates/calc/src/lib.rs
run base
[[ $status -ne 0 && $output == *commit* ]] || fail "dirty: exit code $status, want non-zero:"$'\n'"$output"
[[ $(git status --porcelain) == ' M crates/calc/src/lib.rs' ]] || fail "dirty: the changes were touched"
git checkout --quiet -- crates/calc/src/lib.rs

run no-such-ref
[[ $status -ne 0 ]] || fail "expected an error for an unknown base"
status=0
"$root/script/mutants" >/dev/null 2>&1 || status=$?
[[ $status -eq 2 ]] || fail "expected a usage error without arguments, got exit code $status"

if [[ $failures -ne 0 ]]; then
  echo "mutants-test: $failures case(s) failed" >&2
  exit 1
fi
echo "mutants-test: all cases passed"
