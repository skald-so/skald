#!/usr/bin/env bash
# Generates a formula from the latest stable release's verified archives.
# Usage: script/release-homebrew <vX.Y.Z> <new-formula-path>
set -euo pipefail

fail() { echo "release-homebrew: $*" >&2; exit 1; }
stable_tag='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

[[ $# == 2 && $1 =~ $stable_tag ]] || fail 'expected a stable tag and a new formula path'
tag=$1
formula=$2
[[ ! -e $formula && ! -L $formula ]] || fail "$formula already exists"

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
script/release-version "$tag" >/dev/null
repository=skald-so/skald
release=$(gh api "repos/$repository/releases/tags/$tag")
if ! jq -e --arg tag "$tag" '
  .tag_name == $tag and .draft == false and .prerelease == false and
    .immutable == true and (.published_at | type == "string")
' <<<"$release" >/dev/null; then
  fail "$tag is not a published immutable stable release"
fi
latest=$(gh api "repos/$repository/releases/latest" --jq .tag_name)
[[ $latest =~ $stable_tag ]] || fail 'GitHub has no latest stable release'
if [[ $latest != "$tag" ]]; then
  echo "release-homebrew: $tag is no longer the latest release ($latest)"
  exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
work=$tmp/work
dist_dir=$work/target/distrib
mkdir -p "$dist_dir"
cp Cargo.toml Cargo.lock dist-workspace.toml "$work/"
ln -s "$root/crates" "$work/crates"
git init --quiet "$work"
targets=(
  aarch64-apple-darwin x86_64-apple-darwin
  aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu
)
verified=(--repo "$repository" --signer-workflow "$repository/.github/workflows/release.yml" --source-ref "refs/tags/$tag")
patterns=()
for target in "${targets[@]}"; do
  archive=skald-client-$target.tar.gz
  patterns+=(--pattern "$archive" --pattern "$archive.sha256")
done
gh release download "$tag" --repo "$repository" --dir "$tmp" "${patterns[@]}"

# dist merges artifact checksums from the per-target manifests for a global build.
for target in "${targets[@]}"; do
  archive=skald-client-$target.tar.gz
  [[ -s $tmp/$archive && -s $tmp/$archive.sha256 ]] || fail "$tag is missing $archive or its checksum"
  read -r checksum name <"$tmp/$archive.sha256"
  [[ $checksum =~ ^[0-9a-f]{64}$ && $name == "*$archive" ]] || fail "$archive has an invalid checksum"
  actual=$(shasum -a 256 "$tmp/$archive")
  [[ ${actual%% *} == "$checksum" ]] || fail "$archive does not match its checksum"
  gh attestation verify "$tmp/$archive" "${verified[@]}" >/dev/null
  gh attestation verify "$tmp/$archive.sha256" "${verified[@]}" >/dev/null
  jq -n --arg tag "$tag" --arg archive "$archive" --arg checksum "$checksum" '
    {announcement_tag: $tag, artifacts: {($archive): {kind: "executable-zip", checksums: {sha256: $checksum}}}}
  ' >"$dist_dir/$target-dist-manifest.json"
done

(cd "$work" && dist build --tag="$tag" --artifacts=global --target="$(IFS=,; echo "${targets[*]}")")
generated=$dist_dir/skald.rb
for target in "${targets[@]}"; do
  archive=skald-client-$target.tar.gz
  read -r checksum _ <"$tmp/$archive.sha256"
  url=https://github.com/$repository/releases/download/$tag/$archive
  if ! awk -v url="\"$url\"" -v checksum="\"$checksum\"" '
    $1 == "url" && $2 == url { getline; if ($1 == "sha256" && $2 == checksum) found = 1 }
    END { exit !found }
  ' "$generated"; then
    fail "the generated formula has no verified URL and checksum for $target"
  fi
done
cp "$generated" "$formula"
