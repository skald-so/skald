#!/usr/bin/env bash
# Fails when Rust, TypeScript or shell code under <path>s has a block of 50 or more tokens copied
# from elsewhere under them, unless script/duplicates-known lists that clone, and when that list has
# a clone between files under <path>s that is no longer found. A clone's key is its two files and
# the number of tokens copied, so it stays known when its lines move, the text around it changes
# or, in TypeScript, a comment in it; a key found more often than listed is new. Prints each new
# clone as `<file>:<first line>-<last line> <file>:<first line>-<last line> <tokens>`, each clone
# gone as its key.
# Runs jscpd, pinned in script/jscpd/package.json.
# Usage: script/duplicates <path>..., in the repository root.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: $0 <path>..." >&2
  exit 2
fi

jscpd=$(cd "$(dirname "$0")/jscpd" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

npm ci --prefix "$jscpd" --no-audit --no-fund --loglevel=error

options=(
  # Lockfiles (TOML, JSON) and the recorded hook inputs (JSON) are not in these formats.
  --format rust,typescript,tsx,bash
  # Tokens alone decide, jscpd's default of 50: rustfmt and Prettier wrap one copied block into
  # different numbers of lines.
  --min-lines 0
  # Generated by Orval from the OpenAPI spec.
  --ignore 'web/src/api/**'
)
"$jscpd/node_modules/.bin/jscpd" "${options[@]}" --absolute --no-tips --silent \
  --reporters json --output "$tmp" "$@" >/dev/null

# Each clone as `<key>\t<printed line>`, its key its two files in order, paths relative to the
# repository root, and the number of tokens copied.
jq -r --arg root "$(pwd -P)/" '.duplicates[]
  | ([.firstFile, .secondFile] | map([(.name | ltrimstr($root)), .start, .end]) | sort) as $files
  | "\($files | map(.[0]) | join(" ")) \(.tokens)\t\($files | map("\(.[0]):\(.[1])-\(.[2])")
    | join(" ")) \(.tokens)"' "$tmp/jscpd-report.json" >"$tmp/found"
cut -f1 "$tmp/found" | sort >"$tmp/found-keys"

# The listed keys whose two files are under <path>s.
in_paths() {
  local path
  for path in "${@:2}"; do
    if [[ $1 == "${path%/}/"* ]]; then return 0; fi
  done
  return 1
}
awk '!/^#/ && NF' script/duplicates-known >"$tmp/listed"
while read -r first second tokens; do
  if in_paths "$first" "$@" && in_paths "$second" "$@"; then echo "$first $second $tokens"; fi
done <"$tmp/listed" | sort >"$tmp/known"

# comm pairs repeated lines one to one, so it compares the counts of each key.
comm -23 "$tmp/found-keys" "$tmp/known" | sort -u >"$tmp/new-keys"
new=$(awk -F '\t' 'NR == FNR { new[$0]; next } $1 in new { print $2 }' "$tmp/new-keys" "$tmp/found")
gone=$(comm -13 "$tmp/found-keys" "$tmp/known")

if [[ -n $new ]]; then
  echo "script/duplicates: copied code; move it into a shared helper:" >&2
  echo "$new" >&2
fi
if [[ -n $gone ]]; then
  echo "script/duplicates: listed clones not found; delete their lines from script/duplicates-known:" >&2
  echo "$gone" >&2
fi
[[ -z $new && -z $gone ]]
