#!/usr/bin/env bash
# Tests the Release PR release-plz keeps open and the tag it gives a Release PR's merge, on fixture
# repositories: copies of this working tree, released as 0.40.5 and tagged v0.40.5, with PRs
# squash-merged after the tag, their titles their commits. release-plz runs with the repository's
# own config and without GitHub: the Release PR and the tag go to a stand-in for the GitHub API,
# script/lib/github-api-stub.mjs.
#   - The Release PR sets one version for every crate of the workspace, in Cargo.toml and
#     Cargo.lock, and adds the titles of the PRs merged since the last release tag, whatever they
#     change, to one CHANGELOG.md in the root, once each.
#   - A 0.x version: a breaking change (`!`) bumps the minor version, any other PR the patch version.
#   - A beta, vX.Y.Z-beta.N: a PR sets its version in [workspace.package] of Cargo.toml, and the
#     Release PR keeps it.
#   - The Release PR targets dev and its title passes script/check-pr-title; a later push updates the
#     open Release PR and opens no other.
#   - The merge of a Release PR gets one tag, vX.Y.Z or vX.Y.Z-beta.N, on its commit; a push of any
#     other PR, one that sets a version among them, and a version already tagged get none. No GitHub
#     Release is created.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/script/lib/release.sh"
failures=0

fail() {
  echo "release-plz-test: $*" >&2
  failures=$((failures + 1))
}

if [[ $(release-plz --version 2>/dev/null) != "release-plz $release_plz_version" ]]; then
  echo "release-plz-test: release-plz $release_plz_version is missing; install it:" \
    "cargo install release-plz --version $release_plz_version --locked" >&2
  exit 1
fi

tmp=$(mktemp -d)
stub=
trap '[[ -z $stub ]] || { kill "$stub" && wait "$stub"; } 2>/dev/null || true; rm -rf "$tmp"' EXIT

# The fixtures' commits, isolated from the user's git config.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

# The working tree as script/test sees it: tracked and new files, without ignored ones.
mkdir "$tmp/tree"
(
  cd "$root"
  git ls-files -z --cached --others --exclude-standard | while IFS= read -r -d '' path; do
    if [[ -e $path || -L $path ]]; then printf '%s\0' "$path"; fi
  done | tar --null -T - -cf -
) | tar -C "$tmp/tree" -xf -

# The workspace's crates, one name per line.
crates() {
  cargo metadata --no-deps --offline --format-version 1 --manifest-path "$1/Cargo.toml" |
    jq -r '.packages[].name' | sort
}
members=$(crates "$tmp/tree")
[[ -n $members ]] || fail "the workspace has no crates"

# set_version <dir> <version>: sets the workspace version in [workspace.package] of Cargo.toml and
# the version of every crate in Cargo.lock, as a PR that sets a beta's version does.
set_version() {
  awk -v version="$2" '
    /^\[/ { section = $0 }
    section == "[workspace.package]" && /^version *=/ { $0 = "version = \"" version "\""; set = 1 }
    { print }
    END { exit !set }
  ' "$1/Cargo.toml" >"$tmp/Cargo.toml" || fail "Cargo.toml has no version in [workspace.package]"
  mv "$tmp/Cargo.toml" "$1/Cargo.toml"
  awk -v version="$2" -v members="$(paste -sd , - <<<"$members")" '
    BEGIN { n = split(members, names, ","); for (i = 1; i <= n; i++) crate["name = \"" names[i] "\""] }
    $0 in crate { print; getline; $0 = "version = \"" version "\"" }
    { print }
  ' "$1/Cargo.lock" >"$tmp/Cargo.lock"
  mv "$tmp/Cargo.lock" "$1/Cargo.lock"
}
set_version "$tmp/tree" 0.40.5

# merge <dir> <title> <path>: squash-merges a PR titled <title> that changes <path>.
merge() {
  case $3 in
    *.rs | *.ts | *.tsx) printf '\n// %s\n' "$2" ;;
    *.md) printf '\n%s\n' "$2" ;;
    *) printf '\n# %s\n' "$2" ;;
  esac >>"$1/$3"
  git -C "$1" add --all
  git -C "$1" commit --quiet --message "$2"
}

# merge_release <dir> <version>: squash-merges the Release PR of <version> in <dir>, from a branch
# of release-plz, as the stand-in for the GitHub API tells.
merge_release() {
  git -C "$1" add --all
  git -C "$1" commit --quiet --allow-empty --message "chore: release v$2 (#$((++pr)))"
  echo "$(git -C "$1" rev-parse HEAD) release-plz-2026-01-01T00-00-00Z" >>"$tmp/merges"
}

# release <dir> <version>: merges the Release PR in <dir> and tags it v<version>.
release() {
  merge_release "$1" "$2"
  git -C "$1" tag "v$2"
}

# fixture <name>: sets $dir to a new fixture repository on dev: the tree with a PR merged before
# the release v0.40.5.
pr=100
fixture() {
  dir=$tmp/$1
  cp -R "$tmp/tree" "$dir"
  git -C "$dir" init --quiet --initial-branch dev
  git -C "$dir" add --all
  git -C "$dir" commit --quiet --message "chore: import the repository (#$((++pr)))"
  merge "$dir" "feat(client): add the change before the release (#$((++pr)))" crates/client/src/main.rs
  release "$dir" 0.40.5
}

# update <case>: runs release-plz update in $dir, as the Release PR does. Fails the case on an error.
update() {
  if ! (cd "$dir" && release-plz update) >"$tmp/release-plz.log" 2>&1; then
    fail "$1: release-plz update failed: $(tail -n 20 "$tmp/release-plz.log")"
    return 1
  fi
}

# expect_version <case> <version>: every crate in $dir is at <version>, in Cargo.toml and Cargo.lock.
expect_version() {
  local expected found locked
  expected=$(sed "s/\$/ $2/" <<<"$members")
  found=$(cargo metadata --no-deps --offline --format-version 1 --manifest-path "$dir/Cargo.toml" |
    jq -r '.packages[] | "\(.name) \(.version)"' | sort)
  [[ $found == "$expected" ]] || fail "$1: the crates are not all at $2: $(tr '\n' ',' <<<"$found")"
  locked=$(awk '$1 == "name" { name = $3 } $1 == "version" && name { print name, $3; name = "" }' \
    "$dir/Cargo.lock" | tr -d '"' | grep -E "^($(paste -sd '|' - <<<"$members")) " | sort)
  [[ $locked == "$expected" ]] ||
    fail "$1: Cargo.lock does not have every crate at $2: $(tr '\n' ',' <<<"$locked")"
}

# expect_files <case>: release-plz changed in $dir only Cargo.toml files, Cargo.lock and the
# CHANGELOG.md in the root, and it changed CHANGELOG.md.
expect_files() {
  local changed
  changed=$(git -C "$dir" status --porcelain --untracked-files=all | cut -c4-)
  grep -qx CHANGELOG.md <<<"$changed" || fail "$1: CHANGELOG.md in the root is unchanged"
  if grep -vxE '(.*/)?Cargo\.toml|Cargo\.lock|CHANGELOG\.md' <<<"$changed" >"$tmp/other"; then
    fail "$1: it changed other files, one CHANGELOG.md per crate among them: $(tr '\n' ' ' <"$tmp/other")"
  fi
}

# heading <version>: an ERE for the CHANGELOG.md heading of <version>, not of a longer version.
heading() {
  echo "^## (.*[^0-9.])?${1//./\\.}([^0-9A-Za-z.+-].*)?\$"
}

# expect_section <case> <version> <summary>...: CHANGELOG.md in $dir has one section for <version>
# and it lists each PR of <summary>; the file lists each of them once.
expect_section() {
  local summary count
  count=$(grep -cE "$(heading "$2")" "$dir/CHANGELOG.md" 2>/dev/null || true)
  if [[ $count != 1 ]]; then
    fail "$1: CHANGELOG.md has ${count:-no} sections for $2"
    return
  fi
  awk -v heading="$(heading "$2")" '/^## / { inside = $0 ~ heading } inside' "$dir/CHANGELOG.md" \
    >"$tmp/section"
  for summary in "${@:3}"; do
    grep -qiF -- "$summary" "$tmp/section" || fail "$1: the section of $2 does not list '$summary'"
    count=$(grep -ciF -- "$summary" "$dir/CHANGELOG.md" || true)
    [[ $count -le 1 ]] || fail "$1: CHANGELOG.md lists '$summary' $count times"
  done
}

# expect_not_in_section <case> <version> <summary>...: the section of <version> lists none of them.
expect_not_in_section() {
  local summary
  awk -v heading="$(heading "$2")" '/^## / { inside = $0 ~ heading } inside' "$dir/CHANGELOG.md" \
    >"$tmp/section" 2>/dev/null || true
  for summary in "${@:3}"; do
    if grep -qiF -- "$summary" "$tmp/section"; then
      fail "$1: the section of $2 lists '$summary', merged before the last release"
    fi
  done
}

# Every type of PR since the release tag, in crates and elsewhere, none of them breaking: the patch
# version.
fixture every-type
merge "$dir" "feat(client): add the change alpha (#$((++pr)))" crates/client/src/main.rs
merge "$dir" "fix(server): fix the change bravo (#$((++pr)))" crates/server/src/main.rs
merge "$dir" "perf(proto): speed up the change charlie (#$((++pr)))" crates/proto/src/lib.rs
merge "$dir" "refactor(crypto): simplify the change delta (#$((++pr)))" crates/crypto/src/lib.rs
merge "$dir" "test(mcp): cover the change echo (#$((++pr)))" crates/mcp/src/lib.rs
merge "$dir" "build(adapters): build the change foxtrot (#$((++pr)))" crates/adapters/Cargo.toml
merge "$dir" "chore(deps): update the change golf (#$((++pr)))" crates/server/Cargo.toml
merge "$dir" "style(proto): format the change hotel (#$((++pr)))" crates/proto/src/lib.rs
merge "$dir" "revert: revert the change india (#$((++pr)))" crates/client/src/main.rs
merge "$dir" "feat(web): show the change juliet (#$((++pr)))" web/src/App.tsx
merge "$dir" "docs(protocol): describe the change kilo (#$((++pr)))" docs/protocol/README.md
merge "$dir" "ci: check the change lima (#$((++pr)))" .github/workflows/ci.yml
case="every PR type since v0.40.5"
if update "$case"; then
  expect_version "$case" 0.40.6
  expect_files "$case"
  expect_section "$case" 0.40.6 "add the change alpha" "fix the change bravo" \
    "speed up the change charlie" "simplify the change delta" "cover the change echo" \
    "build the change foxtrot" "update the change golf" "format the change hotel" \
    "revert the change india" "show the change juliet" "describe the change kilo" \
    "check the change lima"
  expect_not_in_section "$case" 0.40.6 "add the change before the release"
fi

# A breaking change: the minor version, for the crates it does not change too.
fixture breaking
merge "$dir" "fix(client): fix the change mike (#$((++pr)))" crates/client/src/main.rs
merge "$dir" "feat(proto)!: change the change november (#$((++pr)))" crates/proto/src/lib.rs
case="a breaking change since v0.40.5"
if update "$case"; then
  expect_version "$case" 0.41.0
  expect_files "$case"
  expect_section "$case" 0.41.0 "fix the change mike" "change the change november"
fi

# Two releases: the second Release PR lists only the PRs since the second tag.
fixture two-releases
merge "$dir" "fix(client): fix the change oscar (#$((++pr)))" crates/client/src/main.rs
case="the first of two releases"
if update "$case"; then
  expect_version "$case" 0.40.6
  release "$dir" 0.40.6
  merge "$dir" "fix(server): fix the change papa (#$((++pr)))" crates/server/src/main.rs
  case="a PR since v0.40.6, the last of two release tags"
  if update "$case"; then
    expect_version "$case" 0.40.7
    expect_files "$case"
    expect_section "$case" 0.40.7 "fix the change papa"
    expect_not_in_section "$case" 0.40.7 "fix the change oscar" "add the change before the release"
    expect_section "$case" 0.40.6 "fix the change oscar"
  fi
fi

# Betas: each keeps the version a PR set for it.
fixture beta
merge "$dir" "feat(client): add the change quebec (#$((++pr)))" crates/client/src/main.rs
set_version "$dir" 0.41.0-beta.1
git -C "$dir" commit --quiet --all --message "chore: set the version of a beta (#$((++pr)))"
case="a beta's version set since v0.40.5"
if update "$case"; then
  expect_version "$case" 0.41.0-beta.1
  expect_files "$case"
  expect_section "$case" 0.41.0-beta.1 "add the change quebec"
  release "$dir" 0.41.0-beta.1
  merge "$dir" "fix(proto): fix the change romeo (#$((++pr)))" crates/proto/src/lib.rs
  set_version "$dir" 0.41.0-beta.2
  git -C "$dir" commit --quiet --all --message "chore: set the version of the next beta (#$((++pr)))"
  case="the next beta's version set since v0.41.0-beta.1"
  if update "$case"; then
    expect_version "$case" 0.41.0-beta.2
    expect_files "$case"
    expect_section "$case" 0.41.0-beta.2 "fix the change romeo"
  fi
fi

# The Release PR through the stand-in for the GitHub API: opened, then updated by a later push.
: >"$tmp/requests.log"
node "$root/script/lib/github-api-stub.mjs" "$tmp/requests.log" "$tmp/pulls.json" "$tmp/port" \
  "$tmp/merges" &
stub=$!
for _ in $(seq 100); do
  [[ ! -s $tmp/port ]] || break
  sleep 0.1
done
[[ -s $tmp/port ]] || {
  echo "release-plz-test: the stand-in for the GitHub API did not start" >&2
  exit 1
}
api=http://127.0.0.1:$(cat "$tmp/port")

# release_pr <case>: runs release-plz release-pr in $dir against the stand-in, as the workflow does.
release_pr() {
  if ! (cd "$dir" && release-plz release-pr --forge github --repo-url "$api/skald-so/skald" \
    --git-token fixture-token) >"$tmp/release-plz.log" 2>&1; then
    fail "$1: release-plz release-pr failed: $(tail -n 20 "$tmp/release-plz.log")"
    return 1
  fi
}

# expect_pr <case> <version> <summary>: the stand-in has one open PR, into dev, titled to pass
# script/check-pr-title; the last commit on its branch sets the workspace version to <version> and
# lists <summary> in CHANGELOG.md.
expect_pr() {
  local title files
  if [[ $(jq '[.[] | select(.state == "open")] | length' "$tmp/pulls.json") != 1 ]]; then
    fail "$1: not one open Release PR: $(jq -c '[.[] | {number, state, title}]' "$tmp/pulls.json")"
    return
  fi
  [[ $(jq -r '.[0].base.ref' "$tmp/pulls.json") == dev ]] ||
    fail "$1: the Release PR is not into dev: $(jq -r '.[0].base.ref' "$tmp/pulls.json")"
  title=$(jq -r '.[0].title' "$tmp/pulls.json")
  "$root/script/check-pr-title" "$title" 2>/dev/null ||
    fail "$1: the Release PR's title fails script/check-pr-title: $title"
  # The commits release-plz made on the PR's branch, or on a branch it then moves the PR's to.
  jq -sr --arg head "$(jq -r '.[0].head.ref' "$tmp/pulls.json")" '
    [.[] | select(.url == "/api/graphql") | .body | fromjson | .variables.input
      | select(.branch.branchName | startswith($head))] | last | .fileChanges.additions // []
      | map({(.path): (.contents | @base64d)}) | add // {}' "$tmp/requests.log" >"$tmp/files.json"
  files=$(jq -r 'keys | join(" ")' "$tmp/files.json")
  jq -r '.["Cargo.toml"] // ""' "$tmp/files.json" | awk -v version="version = \"$2\"" '
    /^\[/ { section = $0 } section == "[workspace.package]" && $0 == version { found = 1 }
    END { exit !found }' ||
    fail "$1: the Release PR's commit does not set the workspace version to $2; it changes: $files"
  jq -r '.["CHANGELOG.md"] // ""' "$tmp/files.json" | grep -qiF -- "$3" ||
    fail "$1: the Release PR's CHANGELOG.md does not list '$3'; it changes: $files"
}

fixture release-pr
merge "$dir" "fix(client): fix the change sierra (#$((++pr)))" crates/client/src/main.rs
case="the Release PR opened after a push"
if release_pr "$case"; then
  expect_pr "$case" 0.40.6 "fix the change sierra"
  head=$(jq -r '.[0].head.ref' "$tmp/pulls.json")
  : >"$tmp/requests.log"
  merge "$dir" "feat(proto)!: change the change tango (#$((++pr)))" crates/proto/src/lib.rs
  case="the open Release PR after a later push"
  if release_pr "$case"; then
    expect_pr "$case" 0.41.0 "change the change tango"
    grep -q '"method":"POST","url":"/api/v3/repos/skald-so/skald/pulls"' "$tmp/requests.log" &&
      fail "$case: release-plz opened another PR"
    jq -se --arg ref "/api/v3/repos/skald-so/skald/git/refs/heads/$head" \
      'any(.[]; .method == "PATCH" and .url == $ref)' "$tmp/requests.log" >/dev/null ||
      fail "$case: the branch of the open Release PR, $head, did not move"
  fi
fi

# tag <case>: runs release-plz release in $dir against the stand-in, as the workflow does on a push
# to dev, with a new request log.
tag() {
  : >"$tmp/requests.log"
  if ! (cd "$dir" && release-plz release --forge github --repo-url "$api/skald-so/skald" \
    --git-token fixture-token) >"$tmp/release-plz.log" 2>&1; then
    fail "$1: release-plz release failed: $(tail -n 20 "$tmp/release-plz.log")"
    return 1
  fi
}

# writes: the requests to the stand-in that change something, one per line.
writes() {
  jq -c 'select(.method != "GET") | {method, url, body}' "$tmp/requests.log"
}

# expect_tag <case> <tag>: release-plz changed nothing on GitHub but creating the annotated tag
# <tag> on the last commit of $dir and its ref: no other tag, no GitHub Release.
expect_tag() {
  jq -se --arg tag "$2" --arg head "$(git -C "$dir" rev-parse HEAD)" '
    map(select(.method != "GET")) | length == 2
    and (.[0] | .method == "POST" and .url == "/api/v3/repos/skald-so/skald/git/tags"
      and (.body | fromjson | .tag == $tag and .object == $head and .type == "commit"))
    and (.[0].response.sha as $object | .[1] | .method == "POST"
      and .url == "/api/v3/repos/skald-so/skald/git/refs"
      and (.body | fromjson | .ref == "refs/tags/\($tag)" and .sha == $object))' \
    "$tmp/requests.log" >/dev/null ||
    fail "$1: not just the tag $2 on the last commit; the changes: $(writes | tr '\n' ' ')"
}

# expect_no_tag <case>: release-plz changed nothing on GitHub.
expect_no_tag() {
  [[ -z $(writes) ]] || fail "$1: release-plz tagged or changed: $(writes | tr '\n' ' ')"
}

# A Release PR merged: its tag. Run again once the tag is fetched, as a rerun of the workflow: none.
fixture tag
merge "$dir" "fix(client): fix the change uniform (#$((++pr)))" crates/client/src/main.rs
case="the merge of the Release PR of 0.40.6"
if update "$case"; then
  merge_release "$dir" 0.40.6
  tag "$case" && expect_tag "$case" v0.40.6
  git -C "$dir" tag v0.40.6
  case="the merge of the Release PR of 0.40.6, tagged already"
  tag "$case" && expect_no_tag "$case"
fi
# Pushes that are no Release PR merge: none, also when the PR sets a version.
merge "$dir" "fix(server): fix the change victor (#$((++pr)))" crates/server/src/main.rs
echo "$(git -C "$dir" rev-parse HEAD) fix-the-change-victor" >>"$tmp/merges"
case="the merge of a PR that is no Release PR"
tag "$case" && expect_no_tag "$case"
merge "$dir" "fix(proto): fix the change whiskey (#$((++pr)))" crates/proto/src/lib.rs
case="a push of a commit that no PR merged"
tag "$case" && expect_no_tag "$case"
set_version "$dir" 0.41.0-beta.1
git -C "$dir" commit --quiet --all --message "chore: set the version of a beta (#$((++pr)))"
echo "$(git -C "$dir" rev-parse HEAD) set-the-version-of-a-beta" >>"$tmp/merges"
case="the merge of a PR that sets a beta's version"
tag "$case" && expect_no_tag "$case"
# The beta's Release PR merged: its beta tag.
case="the merge of the Release PR of 0.41.0-beta.1"
if update "$case"; then
  merge_release "$dir" 0.41.0-beta.1
  tag "$case" && expect_tag "$case" v0.41.0-beta.1
fi

# Before the first release, with no tag yet: a push that is no Release PR merge gets none.
fixture first-release
git -C "$dir" tag -d v0.40.5 >/dev/null
merge "$dir" "fix(client): fix the change xray (#$((++pr)))" crates/client/src/main.rs
echo "$(git -C "$dir" rev-parse HEAD) fix-the-change-xray" >>"$tmp/merges"
case="the merge of a PR that is no Release PR, before the first release"
tag "$case" && expect_no_tag "$case"

if [[ $failures -ne 0 ]]; then
  echo "release-plz-test: $failures case(s) failed" >&2
  exit 1
fi
echo "release-plz-test: all cases passed"
