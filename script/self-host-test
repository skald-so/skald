# --- spa: the web app on the domain. The stack's directory keeps it; the domain serves it at any of
# its pages and the spec's paths to the server. A new person signs up there in one click, a machine
# signs in by device flow, and the person sees the machine linked, the personal space with themselves
# as its admin, and no limits; the machine's CLI session, ended in Access, loses access at once.
scenario spa release files web-files web env github :before_up up :wait_https
if run_scenario spa <<<"$github_secret"; then
  [[ -n $(web_unpacked spa "$work/web/hashes" | grep -x index.html) ]] ||
    fail "spa: the stack's directory does not keep this commit's web app, unpacked"
  spa_served spa "the guide's install"
  routes_to_server spa "the guide's install"
  spa_pages spa "the guide's install" / /machines "/self-host-test/no-such-page"
  if spa_sign_in spa "the guide's install" && sign_in spa ada-machine GitHub; then
    creates_spaces spa ada-machine
    if spa_sign_in spa "the machine's sign-in" Machines Members Usage; then
      shown=$(section_shows Machines text)
      [[ $shown == *ada-machine* && $shown == *Linked* ]] ||
        fail "spa: Machines does not show ada-machine as linked:"$'\n'"$shown"
      shown=$(section_shows Members text)
      [[ $shown == *"$github_login"* && $shown == *Admin* ]] ||
        fail "spa: Members does not show $github_login as the personal space's admin:"$'\n'"$shown"
      shown=$(section_shows Usage text)
      shown=$(tr '[:upper:]' '[:lower:]' <<<"$shown")
      [[ $shown == *"no limit"* || $shown == *unlimited* ]] ||
        fail "spa: on a self-hosted server, Usage does not say no limit applies:"$'\n'"$shown"
      bars=$(section_shows Usage bars)
      [[ $bars == 0 ]] || fail "spa: on a self-hosted server, Usage shows ${bars:-no count of} limit bars"
    fi
    if said=$(person revoke GitHub "https://$github_host/_stand-in/sign-in?user=$github_user" \
      "https://$domain/" ada-machine 2>&1); then
      if said=$(m /self-host/run/spa/ada-machine/skald devices 2>&1); then
        fail "spa: ada-machine's CLI session, ended in Access, still lists devices:"$'\n'"$said"
      fi
    else
      fail "spa: the person cannot end ada-machine's CLI session in Access:"$'\n'"$said"
    fi
  fi
fi
check_env spa
stack_down spa

# --- The proxy variant, in its three forms.
# check_proxied <scenario> <loopback|none>: the stack's ports are published only on loopback, or not
# at all, and do not answer on the machine's address; /health and skald status answer through the
# proxy.
check_proxied() {
  local ports id port ip host_port
  ports=$(published "$1")
  if [[ $2 == loopback ]]; then
    [[ -n $ports ]] || fail "$1: the stack publishes no port for the proxy on the machine"
    while read -r id port ip host_port; do
      [[ -n $id ]] || continue
      [[ $ip == 127.0.0.1 || $ip == ::1 ]] || fail "$1: $port is published on '$ip', not on loopback"
      if answers "$address" "$host_port"; then fail "$1: port $host_port answers on the machine's address"; fi
    done <<<"$ports"
  else
    [[ -z $ports ]] || fail "$1: the stack publishes ports:"$'\n'"$ports"
  fi
  if answers "$address" 8080; then fail "$1: port 8080 answers on the machine's address"; fi
  check_https "$1"
}

# The loopback form also signs in with both providers: their checks pass through the proxy.
# Each form serves the web app through the proxy, and a person signs in to it there.
scenario proxy-host release files web-files web env github google proxy-host :before_up up proxy-host-site \
  :proxy_on_host :wait_https :trust_acme status :trust_checks github-check google-check :trust_system
if run_scenario proxy-host <<<"$providers"; then
  check_proxied proxy-host loopback
  no_secret_in_logs proxy-host
  spa_through proxy-host "the guide's install"
fi
check_env proxy-host
stack_down proxy-host

# check_proxy_route <scenario>: the proxy's default route goes through its own network's gateway.
# Its network's name sorts after the stack's `skald`, which would otherwise take the route.
check_proxy_route() {
  local gateway route
  gateway=$(m docker network inspect -f '{{(index .IPAM.Config 0).Gateway}}' "$proxy_network")
  route=$(m docker exec "$proxy_container" ip route | grep '^default ' || true)
  [[ -n $gateway && $route == "default via $gateway "* ]] ||
    fail "$1: the proxy's default route left its own network ($gateway): '$route'"
}

scenario proxy-join release files web-files web env github proxy-join :before_up up proxy-container-site \
  ":proxy_in_container network" proxy-join-connect :wait_https :trust_acme status :trust_system
if run_scenario proxy-join <<<"$github_secret"; then
  check_proxied proxy-join none
  check_proxy_route proxy-join
  spa_through proxy-join "the guide's install"
fi
stack_down proxy-join

scenario proxy-network release files web-files web env github proxy-network :before_up proxy-container-site \
  ":proxy_in_container network" up :wait_https :trust_acme status :trust_system
if run_scenario proxy-network <<<"$github_secret"; then
  check_proxied proxy-network none
  spa_through proxy-network "the guide's install"
fi
stack_down proxy-network

