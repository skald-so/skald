# --- The guide's archive check refuses, unpacking nothing: an archive that does not match its
# checksum; this commit's archive with its checksum and an attestation of nothing. Once the last
# release has the web app's archive, it passes that archive, and refuses it checked as another
# release's or against another workflow; until then, the part names it skipped.
scenario web-mismatch release ":web mismatch" files :here web-files web-check web
refused_before web-mismatch - web
unpacked=$(web_unpacked web-mismatch "$work/web/hashes")
[[ -z $unpacked ]] || fail "web-mismatch: the refused archive is unpacked:"$'\n'"$unpacked"
stack_down web-mismatch
scenario web-unattested release files :here web-files web-check web
refused_before web-unattested web-check web
unpacked=$(web_unpacked web-unattested "$work/web/hashes")
[[ -z $unpacked ]] || fail "web-unattested: the refused archive is unpacked:"$'\n'"$unpacked"
stack_down web-unattested
if [[ -n $release_web ]]; then
  mkdir -p "$work/release-web/files"
  if curl --fail --silent --show-error --location --retry 3 --output "$work/release-web/$web_archive" \
    "$release_web/$web_archive" && tar -xzf "$work/release-web/$web_archive" -C "$work/release-web/files"; then
    (cd "$work/release-web/files" && find . -type f -size +0 | sort | while read -r file; do
      echo "$(sha256 <"$file") ${file#./}"
    done) >"$work/release-web/hashes"
    scenario web-release release :last_release files :here web-files web-check web
    if run_scenario web-release </dev/null; then
      [[ -n $(web_unpacked web-release "$work/release-web/hashes") ]] ||
        fail "web-release: the guide's steps leave v$version's web app packed"
    fi
    stack_down web-release
    scenario web-other-release release :last_release files :here web-files web-check web
    edit_script web-other-release 's|^self_host_last_release$|self_host_last_release; SKALD_VERSION=0.0.1|'
    refused_before web-other-release web-check web
    unpacked=$(web_unpacked web-other-release "$work/release-web/hashes")
    [[ -z $unpacked ]] || fail "web-other-release: the refused archive is unpacked:"$'\n'"$unpacked"
    stack_down web-other-release
    scenario web-other-workflow release :last_release files :here web-files web-check web
    edit_script web-other-workflow 's|/\.github/workflows/release\.yml@|/.github/workflows/edge.yml@|g'
    if grep -qF '/.github/workflows/edge.yml@' "$work/run/web-other-workflow/script.sh"; then
      refused_before web-other-workflow web-check web
      unpacked=$(web_unpacked web-other-workflow "$work/release-web/hashes")
      [[ -z $unpacked ]] || fail "web-other-workflow: the refused archive is unpacked:"$'\n'"$unpacked"
    else
      fail "$guide: the step web-check does not pin the release workflow, .github/workflows/release.yml@"
    fi
    stack_down web-other-workflow
  else
    fail "web-release: cannot get $release_web/$web_archive"
  fi
else
  echo "self-host-test: skipped the guide's archive check of the last release: v$version has no $web_archive"
fi

# --- Backup and restore, of the stack of a machine that signed in and created spaces.
backups=/self-host/backups
m mkdir -p "$backups"

# with_backup <scenario> <path>: the scenario's script with <path> for `<backup file>`.
with_backup() { edit_script "$1" "s|<backup file>|$2|g"; }

# run_pasted <scenario>: runs the scenario's script as pasted into a shell with one more command
# after it: through `bash -s`, without errexit, so that command runs after a refusal too. Fails
# unless it runs: a guide's command that reads standard input would take it.
run_pasted() {
  { sed '1s/^set -eo pipefail$/set -o pipefail/' "$work/run/$1/script.sh"; echo 'echo self-host-test: pasted after'; } |
    mi env HOME=/root sh -c 'cd /root && timeout 1500 bash -s' >"$work/run/$1/output" 2>&1 || true
  grep -qx 'self-host-test: pasted after' "$work/run/$1/output" ||
    fail "$1: a command pasted after the guide's blocks does not run; the output's end:"$'\n'"$(tail -n 20 "$work/run/$1/output")"
}

# run_refused <scenario> <step>: runs the scenario's script on the machine, as run_scenario does,
# where it ends with the guide's <step>; fails unless the script reaches <step> and exits non-zero.
run_refused() {
  local status=0
  run_script "$1" 1500 </dev/null || status=$?
  if ! grep -qx "self-host-test: step $2" "$work/run/$1/output"; then
    fail "$1: the script does not reach the guide's $2; its output's end:"$'\n'"$(tail -n 40 "$work/run/$1/output")"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    fail "$1: the guide's $2 succeeds; its output's end:"$'\n'"$(tail -n 20 "$work/run/$1/output")"
    return 1
  fi
}

# in_volume <scenario> <command>: self_host_in_volume in the scenario's stack.
in_volume() { in_stack "$1" self_host_in_volume "$2"; }

# put_attachments <scenario> <directory> <text>: files in the stack's attachments volume, the
# server's user's: <directory>/note with <text>, <directory>/blob with 2 MB of random bytes.
put_attachments() {
  in_volume "$1" "mkdir -p /a/$2 && echo '$3' >/a/$2/note && head -c 2097152 /dev/urandom >/a/$2/blob &&
    chown -R 65532:65532 /a/$2" || fail "$1: cannot put files into the attachments volume"
}

# attachment_files <scenario>: what the stack's attachments volume holds: `<owner> <type> <path>
# [<SHA-256>]` lines, the digest of each file.
attachment_files() {
  in_volume "$1" 'cd /a && find . | sort | while read -r path; do
      if [ -f "$path" ]; then echo "$(stat -c "%u %F" "$path") $path $(sha256sum <"$path" | cut -d " " -f 1)"
      else echo "$(stat -c "%u %F" "$path") $path"; fi
    done'
}

# postgres_up <scenario>: starts the stack's PostgreSQL, if it does not run; prints its container's
# ID.
postgres_up() {
  in_stack "$1" docker compose up --detach --wait postgres >/dev/null 2>&1 || return 1
  container "$1" "$postgres_image"
}

# database_print <scenario>: a digest of the stack's database, PostgreSQL started for it.
database_print() {
  local id
  id=$(postgres_up "$1") || return 1
  m sh -c "docker exec $id sh -c 'pg_dump --username \"\$POSTGRES_USER\" --dbname \"\$POSTGRES_DB\"' |
    grep -vE '^.(un)?restrict ' | sha256sum"
}

# database_tables <scenario>: the number of tables in the stack's database outside PostgreSQL's
# own schemas, PostgreSQL started for it.
database_tables() {
  local id
  id=$(postgres_up "$1") || return 1
  sql "$id" "SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema')"
}

# listing <scenario>/<machine>: what skald devices and skald spaces show on the machine of
# new_machine, their output, errors included, and exit codes.
listing() {
  local dir=/self-host/run/$1
  m sh -c "$dir/skald devices 2>&1; echo \"devices: exit code \$?\"; $dir/skald spaces 2>&1;
    echo \"spaces: exit code \$?\""
}

# listed_cleanly <scenario> <listing>...: fails for each listing of `listing` that shows an error.
listed_cleanly() {
  local listed
  for listed in "${@:2}"; do
    if grep -q '^skald:' <<<"$listed"; then fail "$1: a machine lists with errors:"$'\n'"$listed"; fi
  done
}

# lists_as_before <scenario> <scenario>/<machine> <when> <listing>: after <when>, the machine lists
# the same devices and spaces as <listing>.
lists_as_before() {
  local now
  now=$(listing "$2")
  [[ $now == "$4" ]] ||
    fail "$1: after $3, $2 lists other devices or spaces:"$'\n'"before:"$'\n'"$4"$'\n'"after:"$'\n'"$now"
}

# backup_private <scenario> <backup>: the backup is a file of root, the user who made it, that no
# one else may read.
backup_private() {
  local owner mode
  if ! read -r owner mode < <(m stat -c '%u %a' "$2" 2>/dev/null); then
    fail "$1: the guide's backup writes no file at $2"
    return 1
  fi
  m test -f "$2" || fail "$1: the backup $2 is not a file"
  [[ $owner == 0 ]] || fail "$1: the backup belongs to the user $owner, not to root, who made it"
  ((8#$mode & 8#077)) && fail "$1: the backup has mode $mode: others than its owner may read it"
  return 0
}

# backup_holds <scenario> <backup> <setup scenario> [<label>=<text>]...: sets holds to what the backup
# holds of each <text> and of the secret values of the setup scenario's .env (backup_finds), and
# fails unless it checked the database password and two secrets more.
backup_holds() {
  local scenario=$1 file=$2 setup=$3 found secrets
  shift 3
  found=$(in_stack "$setup" backup_finds "$file" "/self-host/run/$setup/env" "$@") ||
    fail "$scenario: cannot read the backup $file"
  holds=$(sed -n 's/^holds //p' <<<"$found")
  secrets=$(grep -cE '^checked [A-Z_]*(PASSWORD|SECRET)' <<<"$found" || true)
  grep -qx 'checked SKALD_DATABASE_PASSWORD' <<<"$found" && ((secrets >= 3)) ||
    fail "$scenario: the .env of $setup gives too few secrets to look for:"$'\n'"$(grep '^checked ' <<<"$found")"
  return 0
}

# no_secret_held <scenario>: the backup of backup_holds holds no secret value of .env.
no_secret_held() {
  local label
  for label in $(grep -E '(PASSWORD|SECRET)' <<<"$holds" || true); do
    fail "$1: the backup holds the value of $label in .env"
  done
}

# started <scenario>: when the stack's running server started.
started() {
  local id
  id=$(container "$1" "$server_image") || return 1
  m docker inspect --format '{{.State.StartedAt}}' "$id"
}

marker=self-host-test-attachment-$(openssl rand -hex 8)
backup_file=$backups/skald-backup

# backup: the stack of two signed-in machines with spaces and files in the attachments volume.
scenario backup release files web-files web env github google :before_up up :wait_https
backup_ok=
if run_scenario backup <<<"$providers"; then
  backup_ok=1
  if sign_in backup ada-machine GitHub; then creates_spaces backup ada-machine gale hollow; else backup_ok=; fi
  if sign_in backup grace-machine Google; then creates_spaces backup grace-machine isle juniper; else backup_ok=; fi
fi
check_env backup
if [[ -n $backup_ok ]]; then
  put_attachments backup notes "$marker"
  files_before=$(attachment_files backup)
  ada_before=$(listing backup/ada-machine)
  grace_before=$(listing backup/grace-machine)
  listed_cleanly backup "$ada_before" "$grace_before"

  # The guide's backup.
  started_before=$(started backup || true)
  scenario backup-run ":resume backup" backup
  with_backup backup-run "$backup_file"
  if run_scenario backup-run </dev/null && backup_private backup-run "$backup_file"; then
    backup_holds backup-run "$backup_file" backup "attachments=$marker"
    grep -qx attachments <<<"$holds" || fail "backup-run: the backup does not hold the attachments volume's files"
    no_secret_held backup-run
  else
    backup_ok=
  fi
  answers_health backup "the guide's backup" || true
  started_after=$(started backup || true)
  [[ -n $started_before && -n $started_after && $started_after != "$started_before" ]] ||
    fail "backup: the guide's backup does not restart the server: started '$started_before', then '$started_after'"
  lists_as_before backup backup/ada-machine "the guide's backup" "$ada_before"
  lists_as_before backup backup/grace-machine "the guide's backup" "$grace_before"

  # The guide's backup, pasted with a command after it.
  scenario backup-pasted ":resume backup" backup
  with_backup backup-pasted "$backup_file-pasted"
  run_pasted backup-pasted
  m rm -f "$backup_file-pasted"
  answers_health backup "the guide's backup, pasted" || true

  # A backup that fails: its disk full.
  m sh -c 'mkdir -p /self-host/full && mount -t tmpfs -o size=4k tmpfs /self-host/full'
  scenario backup-full ":resume backup" backup
  with_backup backup-full /self-host/full/skald-backup
  run_refused backup-full backup || true
  left=$(m find /self-host/full -mindepth 1)
  [[ -z $left ]] || fail "backup-full: the backup that fails leaves files:"$'\n'"$left"
  answers_health backup "a backup that fails" || true
  lists_as_before backup backup/ada-machine "a backup that fails" "$ada_before"
  lists_as_before backup backup/grace-machine "a backup that fails" "$grace_before"
  m umount /self-host/full

  # A restore into a stack whose database holds data, its attachments volume empty.
  if [[ -n $backup_ok ]]; then
    in_stack backup docker compose down >/dev/null 2>&1 || fail "backup: docker compose down fails"
    in_volume backup 'find /a -mindepth 1 -maxdepth 1 -exec rm -rf {} +' || fail "backup: cannot empty the attachments volume"
    database=$(database_print backup) || fail "backup: cannot read the database"
    files=$(attachment_files backup)
    in_stack backup docker compose down >/dev/null 2>&1 || fail "backup: docker compose down fails"
    scenario restore-data ":resume backup" restore
    with_backup restore-data "$backup_file"
    run_refused restore-data restore || true
    # The refused restore, pasted with a command after it.
    scenario restore-data-pasted ":resume backup" restore
    with_backup restore-data-pasted "$backup_file"
    run_pasted restore-data-pasted
    [[ $(database_print backup || true) == "$database" ]] ||
      fail "restore-data: the refused restore changes the stack's database"
    [[ $(attachment_files backup) == "$files" ]] ||
      fail "restore-data: the refused restore changes the stack's attachments volume"
  fi
fi
stack_down backup

# restore-files: a new stack whose attachments volume holds files, its database none.
if [[ -n $backup_ok ]]; then
  scenario restore-files release files web-files web env github google :before_up
  if run_scenario restore-files <<<"$providers"; then
    in_stack restore-files docker compose create >/dev/null 2>&1 || fail "restore-files: docker compose create fails"
    put_attachments restore-files kept "self-host-test-kept-$(openssl rand -hex 8)"
    in_stack restore-files docker compose down >/dev/null 2>&1 || fail "restore-files: docker compose down fails"
    files=$(attachment_files restore-files)
    scenario restore-files-run ":resume restore-files" restore
    with_backup restore-files-run "$backup_file"
    run_refused restore-files-run restore || true
    [[ $(attachment_files restore-files) == "$files" ]] ||
      fail "restore-files: the refused restore changes the stack's attachments volume"
    tables=$(database_tables restore-files || true)
    [[ $tables == 0 ]] || fail "restore-files: after the refused restore, the database holds tables: '$tables'"
  fi
  check_env restore-files
  stack_down restore-files
fi

# restored: the backup in a new stack with new volumes.
if [[ -n $backup_ok ]]; then
  scenario restored release files web-files web env github google :before_up restore up :wait_https
  with_backup restored "$backup_file"
  if run_scenario restored <<<"$providers"; then
    lists_as_before restored backup/ada-machine "the restore into a new stack" "$ada_before"
    lists_as_before restored backup/grace-machine "the restore into a new stack" "$grace_before"
    [[ $(attachment_files restored) == "$files_before" ]] ||
      fail "restored: the new stack's attachments volume does not hold the backup's files:"$'\n'"$(attachment_files restored)"
    creates_spaces backup ada-machine kestrel
    creates_spaces backup grace-machine linden
  fi
  check_env restored
  stack_down restored
fi

# bucket-backup, bucket-restored: with the bucket, the backup holds the database only.
bucket_marker=self-host-test-bucket-$(openssl rand -hex 8)
volume_marker=self-host-test-volume-$(openssl rand -hex 8)
bucket_backup=$backups/skald-bucket-backup
scenario bucket-backup release files web-files web env bucket github :before_up up :wait_https
bucket_backup_ok=
if run_scenario bucket-backup <<<"$bucket_secret"$'\n'"$github_secret"; then
  if sign_in bucket-backup ada-machine GitHub; then
    creates_spaces bucket-backup ada-machine moss
    bucket_backup_ok=1
  fi
fi
check_env bucket-backup
if [[ -n $bucket_backup_ok ]]; then
  put_attachments bucket-backup notes "$volume_marker"
  m docker exec self-host-bucket sh -c "echo '$bucket_marker' >/data/$bucket_name/self-host-test-object" ||
    fail "bucket-backup: cannot put an object into the bucket"
  bucket_ada_before=$(listing bucket-backup/ada-machine)
  scenario bucket-backup-run ":resume bucket-backup" backup
  with_backup bucket-backup-run "$bucket_backup"
  if run_scenario bucket-backup-run </dev/null && backup_private bucket-backup-run "$bucket_backup"; then
    backup_holds bucket-backup-run "$bucket_backup" bucket-backup "volume=$volume_marker" "bucket=$bucket_marker"
    grep -qx volume <<<"$holds" && fail "bucket-backup-run: with the bucket, the backup holds the attachments volume's files"
    grep -qx bucket <<<"$holds" && fail "bucket-backup-run: the backup holds the bucket's objects"
    no_secret_held bucket-backup-run
  else
    bucket_backup_ok=
  fi
  [[ $(m docker exec self-host-bucket cat "/data/$bucket_name/self-host-test-object" || true) == "$bucket_marker" ]] ||
    fail "bucket-backup-run: after the backup, the bucket's object is gone"
  answers_health bucket-backup "the guide's backup" || true
  lists_as_before bucket-backup bucket-backup/ada-machine "the guide's backup" "$bucket_ada_before"
fi
stack_down bucket-backup
if [[ -n $bucket_backup_ok ]]; then
  scenario bucket-restored release files web-files web env bucket github :before_up restore up :wait_https
  with_backup bucket-restored "$bucket_backup"
  if run_scenario bucket-restored <<<"$bucket_secret"$'\n'"$github_secret"; then
    lists_as_before bucket-restored bucket-backup/ada-machine "the restore into a new stack" "$bucket_ada_before"
    [[ $(attachment_files bucket-restored) != *" ./"* ]] ||
      fail "bucket-restored: the new stack's attachments volume holds files:"$'\n'"$(attachment_files bucket-restored)"
  fi
  check_env bucket-restored
  stack_down bucket-restored
fi

# --- Upgrades from the last release: its stack, upgraded by the guide to this commit and rolled back.
release_tag=v$version
release_skald=/self-host/release/skald
release_image=skald-server:last-release
upgrade_backup=$backups/skald-upgrade-backup
upgrade_tests='last-release upgrade upgrade-client rollback-refused rollback-missing rollback-broken'
upgrade_tests+=' rollback-no-database rollback upgrade-restored proxy-last-release proxy-upgrade'
upgrade_tests+=' proxy-upgrade-web'
ran=
# The web app's steps for the last release's stack: none while it has no archive.
last_web_steps=
if [[ -n $release_web ]]; then last_web_steps='web-files web-check web'; fi
# The last release's guide's blocks, from its tag: $work/release-blocks, by extract_blocks.
if git show "$release_tag:$guide" >"$work/release-guide.md" 2>/dev/null; then
  extract_blocks "$work/release-guide.md" "$work/release-blocks"
else
  fail "upgrade: $release_tag has no $guide"
  mkdir -p "$work/release-blocks"
  touch "$work/release-blocks/list"
fi

# guide_section <step>: the lines of the guide's level-2 section that holds the block of <step>.
guide_section() {
  awk -v step="$1" '
    /^ *(```|~~~)/ {
      fence = !fence
      if (fence && $0 ~ ("self-host=" step "([ \t]|$)")) { found = 1 }
    }
    !fence && /^## / { if (found) { exit }; lines = "" }
    { lines = lines $0 "\n" }
    END { if (found) { printf "%s", lines } }
  ' "$guide"
}

# section_anchors: the anchors of the headings in the Markdown on standard input, outside code
# blocks, as GitHub makes them, one per line.
section_anchors() {
  awk '
    /^ *(```|~~~)/ { fence = !fence; next }
    !fence && /^#+ / {
      heading = tolower($0)
      sub(/^#+ +/, "", heading)
      gsub(/[^a-z0-9 _-]/, "", heading)
      gsub(/ /, "-", heading)
      print heading
    }
  '
}

guide_section rollback | grep -qF '](dev/infrastructure.md#' ||
  fail "$guide: the section of the step rollback does not link to infrastructure.md"
# The guide's upgrade: the backup first, then the step's block, then Start.
order=$(guide_section upgrade | awk '
  /\]\(#backup-and-restore\)/ && !backup { backup = NR }
  /self-host=upgrade/ && !block { block = NR }
  /\]\(#start\)/ && !start { start = NR }
  END { print (backup && block && start && backup < block && block < start) ? "ok" : "not" }
')
[[ $order == ok ]] ||
  fail "$guide: the section of the step upgrade does not name the backup, then its block, then Start"
# The guide's upgrade and rollback put their release's web app in place: they link to the heading
# above the block of the step web. The upgrade says what to replace in the override and site block
# of the proxy variant: it links to a heading of its section.
web_heading=
if grep -qE '^ *(```|~~~).*self-host=web([[:space:]]|$)' "$guide"; then
  web_heading=$(awk '/^ *(```|~~~)/ && /self-host=web([ \t]|$)/ { exit } { print }' "$guide" | section_anchors |
    tail -n 1)
fi
for step in upgrade rollback; do
  [[ -n $web_heading ]] && guide_section "$step" | grep -qF "](#$web_heading)" ||
    fail "$guide: the section of the step $step does not link to the web app's step, #${web_heading:-none}"
done
proxy_linked=
for anchor in $(guide_section proxy-host | section_anchors); do
  if guide_section upgrade | grep -qF "](#$anchor)"; then proxy_linked=1; fi
done
[[ -n $proxy_linked ]] ||
  fail "$guide: the section of the step upgrade does not link to the proxy variant's, for its override and site block"

# The last release's compose file and Caddy config, from its tag, or this commit's when it has none;
# this commit's compose file on the PostgreSQL release candidate that it first pinned.
mkdir -p "$work/release-files" "$work/rc-files"
if git cat-file -e "$release_tag:docker-compose.yml" 2>/dev/null; then
  for file in docker-compose.yml Caddyfile; do
    git show "$release_tag:$file" >"$work/release-files/$file" || fail "upgrade: $release_tag has no $file"
  done
else
  cp docker-compose.yml Caddyfile "$work/release-files/"
  # Copies that differ from this commit's files, so that the tests tell which ones a stack has.
  for file in docker-compose.yml Caddyfile; do
    echo "# self-host-test: the last release's copy" >>"$work/release-files/$file"
  done
fi
postgres_rc=postgres:19rc2@sha256:3c5f322ffe97481b51a1ebee693f58d0c081514d2bc3026500a9400b7428bea9
postgres_pinned=$(sed -nE 's/^ *image: (postgres:[^ ]+)$/\1/p' docker-compose.yml | head -n 1)
sed -E "s|^( *image: )postgres:[^ ]+\$|\\1$postgres_rc|" docker-compose.yml >"$work/rc-files/docker-compose.yml"
cp Caddyfile "$work/rc-files/"
for file in docker-compose.yml Caddyfile; do
  echo "# self-host-test: the copy with PostgreSQL's release candidate" >>"$work/rc-files/$file"
done
docker cp "$work/release-files" "$machine:/self-host/release-files"
docker cp "$work/rc-files" "$machine:/self-host/rc-files"
release_dockerfile=$(git show "$release_tag:crates/server/Dockerfile" 2>/dev/null || true)
release_attachments=prepare
if [[ $release_dockerfile == *var/lib/skald/attachments* ]]; then release_attachments=image; fi
mi sh -c 'cat >>/self-host/params' <<EOF
self_host_release_files=file:///self-host/release-files
self_host_release_web=$release_web
self_host_release_image=$release_image
self_host_release_platform=linux/amd64
self_host_release_attachments=$release_attachments
self_host_rc_files=file:///self-host/rc-files
EOF
# This commit's migrations that the last release lacks.
new_migrations=$(comm -13 <(git ls-tree --name-only "$release_tag:crates/server/migrations" 2>/dev/null | sort) \
  <(ls crates/server/migrations | sort))

# The last release's image, by its digest, on the machine under a local name; its skald for the
# machine's architecture from GitHub Releases, checked against its checksum.
release_ready=1
if ! said=$(m docker pull --quiet --platform linux/amd64 "ghcr.io/skald-so/skald-server@$release_digest" 2>&1) ||
  ! said=$(m docker tag "ghcr.io/skald-so/skald-server@$release_digest" "$release_image" 2>&1); then
  fail "upgrade: cannot pull ghcr.io/skald-so/skald-server@$release_digest: $said"
  release_ready=
fi
archive=skald-client-$(m uname -m)-unknown-linux-gnu.tar.gz
if ! said=$(m sh -ec "mkdir -p /self-host/release/download && cd /self-host/release/download
  for file in '$archive' '$archive.sha256'; do
    curl --fail --silent --show-error --location --retry 3 --output \"\$file\" \
      \"https://github.com/skald-so/skald/releases/download/$release_tag/\$file\"
  done
  sha256sum --check --strict '$archive.sha256'
  tar -xzf '$archive'
  cp \"\$(find . -type f -name skald | head -n 1)\" $release_skald
  $release_skald --version" 2>&1); then
  fail "upgrade: cannot get skald $release_tag from GitHub Releases:"$'\n'"$said"
  release_ready=
elif [[ $said != *"$version"* ]]; then
  fail "upgrade: the skald of $release_tag says another version:"$'\n'"$said"
  release_ready=
fi

# machine_copy <scenario>/<machine> <scenario>/<machine> [<skald>]: a copy of the first machine's home
# and state as the second, with its host name, run by this commit's skald or <skald>.
machine_copy() {
  m mkdir -p "/self-host/run/${2%/*}"
  m cp -a "/self-host/run/$1" "/self-host/run/$2"
  host_name=${1#*/} client_bin=${3:-skald} new_machine "${2%/*}" "${2#*/}"
}

# lists_names <scenario> <scenario>/<machine> <when> <name>...: after <when>, skald devices and skald
# spaces on the machine succeed, list it as this device, linked, and name each <name>.
lists_names() {
  local scenario=$1 path=$2 when=$3 listed name
  shift 3
  listed=$(listing "$path")
  if grep -q '^skald:' <<<"$listed" || ! grep -qx 'devices: exit code 0' <<<"$listed" ||
    ! grep -qx 'spaces: exit code 0' <<<"$listed"; then
    fail "$scenario: after $when, $path lists with errors:"$'\n'"$listed"
    return
  fi
  [[ $listed == *"this device"* && $listed != *"not linked"* ]] ||
    fail "$scenario: after $when, $path does not list itself as this device, linked:"$'\n'"$listed"
  for name in "$@"; do
    grep -qw -- "$name" <<<"$listed" || fail "$scenario: after $when, $path does not list $name:"$'\n'"$listed"
  done
}

# runs_server <scenario> <image> <when>: after <when>, the stack's server runs from <image>.
runs_server() {
  container "$1" "$2" >/dev/null || fail "$1: after $3, the stack's server does not run from $2"
}

# has_files <scenario> <directory> <when>: after <when>, the stack's compose file and Caddy config
# are those in <directory> on the machine.
has_files() {
  local file
  for file in docker-compose.yml Caddyfile; do
    in_stack "$1" cmp -s "$file" "$2/$file" || fail "$1: after $3, the stack's $file is not the one in $2"
  done
}

# caddy_restarted <scenario> <when>: after <when>, the stack's Caddy runs and started after its
# Caddyfile was last written.
caddy_restarted() {
  local id started written
  if ! id=$(container "$1" "$caddy_image"); then
    fail "$1: after $2, the stack's Caddy does not run"
    return
  fi
  started=$(m date -d "$(m docker inspect --format '{{.State.StartedAt}}' "$id")" +%s%N)
  written=$(in_stack "$1" date -r Caddyfile +%s%N)
  ((started > written)) || fail "$1: after $2, Caddy runs since before its Caddyfile was written"
}

# boundaries_crossed <list>: the links of the entries of the list of upgrade boundaries <list> whose
# condition holds, one per line.
boundaries_crossed() {
  local link condition
  while read -r link condition; do
    if [[ -z $link || $link == \#* ]]; then continue; fi
    if last_release=$release_tag bash -c "$condition" </dev/null >/dev/null 2>&1; then echo "$link"; fi
  done <"$1"
}

# new_stack <label>: what the part does across an upgrade boundary: a new stack of this commit,
# the scenario <label>-new-stack.
new_stack() {
  scenario "$1-new-stack" release files web-files web env github :before_up up :wait_https :trust_acme status :trust_system
  if run_scenario "$1-new-stack" <<<"$github_secret"; then check_https "$1-new-stack"; fi
  check_env "$1-new-stack"
  stack_down "$1-new-stack"
}

# upgrade_down: removes the stack of last-release, upgrade and rollback.
upgrade_down() {
  local name
  for name in rollback upgrade last-release; do stack_down "$name"; done
}

# upgrade_from_last_release: the upgrade tests.
upgrade_from_last_release() {
  local ok=1 ada kai files database database_upgraded files_upgraded status said bad pages
  scenario last-release release :last_release files $last_web_steps env github :before_up_release \
    :prepare_attachments up :wait_https
  ran+=' last-release'
  run_scenario last-release <<<"$github_secret" || ok=
  check_env last-release
  [[ -n $ok ]] || return 0
  runs_server last-release "$release_image" "its first up"
  has_files last-release /self-host/release-files "its first up"
  # What the last release's stack answers at the web app's pages.
  pages=$(spa_get /; spa_get /machines)
  if client_bin=$release_skald sign_in last-release ada-machine GitHub; then
    creates_spaces last-release ada-machine oak pine
  else
    ok=
  fi
  if github_user=$github_other_user client_bin=$release_skald sign_in last-release kai-machine GitHub; then
    creates_spaces last-release kai-machine quill reed
  else
    ok=
  fi
  [[ -n $ok ]] || return 0
  put_attachments last-release notes "self-host-test-upgrade-$(openssl rand -hex 8)"
  files=$(attachment_files last-release)
  ada=$(listing last-release/ada-machine)
  kai=$(listing last-release/kai-machine)
  listed_cleanly last-release "$ada" "$kai"
  m sh -c 'mkdir -p /self-host/run/snapshot && cp -a /self-host/run/last-release/ada-machine \
    /self-host/run/last-release/kai-machine /self-host/run/snapshot/'
  database=$(database_print last-release) || fail "last-release: cannot read the database"

  # The guide's upgrade to this commit.
  scenario upgrade ":resume last-release" release image-check web-files backup web upgrade :before_up up \
    :wait_https
  with_backup upgrade "$upgrade_backup"
  ran+=' upgrade'
  ok=1
  run_scenario upgrade </dev/null || ok=
  check_env upgrade
  [[ -n $ok ]] || return 0
  runs_server upgrade "$server_image" "the guide's upgrade"
  has_files upgrade /self-host/files "the guide's upgrade"
  caddy_restarted upgrade "the guide's upgrade"
  spa_served upgrade "the guide's upgrade"
  backup_private upgrade "$upgrade_backup" || true
  [[ $(attachment_files upgrade) == "$files" ]] ||
    fail "upgrade: after the guide's upgrade, the attachments volume holds other files:"$'\n'"$(attachment_files upgrade)"
  lists_as_before upgrade last-release/ada-machine "the guide's upgrade" "$ada"
  lists_as_before upgrade last-release/kai-machine "the guide's upgrade" "$kai"
  creates_spaces last-release kai-machine sedge

  # upgrade-client: this commit's skald on a copy of the last release's skald's state.
  ran+=' upgrade-client'
  machine_copy last-release/ada-machine upgrade/ada-machine
  lists_names upgrade-client upgrade/ada-machine "the guide's upgrade" ada-machine oak pine
  creates_spaces upgrade ada-machine tamarack

  # rollback-refused: the last release's server on the upgraded database.
  if [[ -n $new_migrations ]]; then
    ran+=' rollback-refused'
    in_stack upgrade docker compose stop skald-server >/dev/null 2>&1 ||
      fail "rollback-refused: docker compose stop skald-server fails"
    database_upgraded=$(database_print upgrade) || fail "rollback-refused: cannot read the database"
    files_upgraded=$(attachment_files upgrade)
    status=0
    said=$(in_stack upgrade env SKALD_IMAGE="$release_image" DOCKER_DEFAULT_PLATFORM=linux/amd64 \
      timeout 120 docker compose run --rm --no-deps -T skald-server 2>&1) || status=$?
    if [[ $status -eq 0 ]]; then
      fail "rollback-refused: the last release's server runs on the upgraded database:"$'\n'"$said"
    elif [[ $status -eq 124 ]]; then
      fail "rollback-refused: the last release's server on the upgraded database does not exit within 120 s"
    elif ! grep -qi 'migrat' <<<"$said"; then
      fail "rollback-refused: the last release's server exits for another reason than the database's migrations:"$'\n'"$said"
    fi
    [[ $(database_print upgrade || true) == "$database_upgraded" ]] ||
      fail "rollback-refused: the last release's server changes the upgraded database"
    [[ $(attachment_files upgrade) == "$files_upgraded" ]] ||
      fail "rollback-refused: the last release's server changes the attachments volume"
  else
    echo "self-host-test: skipped rollback-refused: this commit has no migration that $release_tag lacks"
  fi

  # rollback-<bad>: the guide's rollback with a backup it cannot restore changes nothing.
  database_upgraded=$(database_print upgrade) || fail "rollback: cannot read the upgraded database"
  files_upgraded=$(attachment_files upgrade)
  m sh -ec "head -c 65536 $upgrade_backup >$backups/skald-broken-backup
    mkdir -p /tmp/no-database && echo note >/tmp/no-database/note
    tar -czf $backups/skald-no-database-backup -C /tmp/no-database note" ||
    fail "rollback: cannot make the backups it cannot restore"
  for bad in missing broken no-database; do
    scenario "rollback-$bad" ":resume upgrade" release :last_release rollback
    with_backup "rollback-$bad" "$backups/skald-$bad-backup"
    ran+=" rollback-$bad"
    run_refused "rollback-$bad" rollback || true
    [[ $(database_print upgrade || true) == "$database_upgraded" ]] ||
      fail "rollback-$bad: the guide's rollback with the $bad backup changes the database"
    [[ $(attachment_files upgrade) == "$files_upgraded" ]] ||
      fail "rollback-$bad: the guide's rollback with the $bad backup changes the attachments volume"
  done

  # The guide's rollback to the last release, with the backup from the upgrade.
  scenario rollback ":resume upgrade" release :last_release rollback $last_web_steps :before_up_release \
    restore
  with_backup rollback "$upgrade_backup"
  ran+=' rollback'
  ok=1
  run_scenario rollback </dev/null || ok=
  check_env rollback
  [[ -n $ok ]] || return 0
  has_files rollback /self-host/release-files "the guide's rollback"
  [[ $(database_print rollback || true) == "$database" ]] ||
    fail "rollback: after the guide's rollback, the database is not the one from before the upgrade"
  [[ $(attachment_files rollback) == "$files" ]] ||
    fail "rollback: after the guide's rollback, the attachments volume holds other files:"$'\n'"$(attachment_files rollback)"
  scenario rollback-up ":resume rollback" up :wait_https
  run_scenario rollback-up </dev/null || return 0
  runs_server rollback "$release_image" "the guide's rollback"
  [[ $(spa_get /; spa_get /machines) == "$pages" ]] ||
    fail "rollback: after the guide's rollback, the web app's pages answer otherwise than before the upgrade"
  lists_as_before rollback last-release/ada-machine "the guide's rollback" "$ada"
  creates_spaces last-release ada-machine umber
  upgrade_down

  # upgrade-restored: the backup from the upgrade, of the last release's stack, in a new stack of this
  # commit.
  scenario upgrade-restored release files web-files web env github :before_up restore up :wait_https
  with_backup upgrade-restored "$upgrade_backup"
  ran+=' upgrade-restored'
  if run_scenario upgrade-restored <<<"$github_secret"; then
    runs_server upgrade-restored "$server_image" "the restore"
    [[ $(attachment_files upgrade-restored) == "$files" ]] ||
      fail "upgrade-restored: the new stack's attachments volume does not hold the backup's files:"$'\n'"$(attachment_files upgrade-restored)"
    machine_copy snapshot/ada-machine upgrade-restored/ada-machine
    machine_copy snapshot/kai-machine upgrade-restored/kai-machine
    lists_names upgrade-restored upgrade-restored/ada-machine "the restore" ada-machine oak pine
    lists_names upgrade-restored upgrade-restored/kai-machine "the restore" kai-machine quill reed
    creates_spaces upgrade-restored ada-machine vetch
  fi
  check_env upgrade-restored
  stack_down upgrade-restored
}

# proxy_upgrade_from_last_release: the last release's stack behind the admin's proxy on the machine,
# with the override and site block of that release's guide, upgraded by the guide to this commit,
# serves the API through the proxy; with this commit's override and site block, also the web app.
proxy_upgrade_from_last_release() {
  scenario proxy-last-release release :last_release files $last_web_steps env github proxy-host@last \
    :before_up_release :prepare_attachments up proxy-host-site@last :proxy_on_host :wait_https
  ran+=' proxy-last-release'
  run_scenario proxy-last-release <<<"$github_secret" || return 0
  check_env proxy-last-release
  runs_server proxy-last-release "$release_image" "its first up"

  scenario proxy-upgrade ":resume proxy-last-release" release image-check web-files backup web upgrade \
    :before_up up :wait_https
  with_backup proxy-upgrade "$backups/skald-proxy-upgrade-backup"
  ran+=' proxy-upgrade'
  run_scenario proxy-upgrade </dev/null || return 0
  check_env proxy-upgrade
  runs_server proxy-upgrade "$server_image" "the guide's upgrade"
  check_https proxy-upgrade

  # This commit's override and site block, as the guide's upgrade section says; the proxy restarted
  # with that site block.
  m sh -c 'kill "$(cat /self-host/run/proxy-last-release/proxy/pid)"' || true
  for _ in $(seq 20); do
    if ! answers 127.0.0.1 443; then break; fi
    sleep 0.5
  done
  scenario proxy-upgrade-web ":resume proxy-upgrade" :here proxy-host :override up proxy-host-site \
    :proxy_on_host :wait_https
  ran+=' proxy-upgrade-web'
  run_scenario proxy-upgrade-web </dev/null || return 0
  runs_server proxy-upgrade-web "$server_image" "this commit's override and site block"
  check_https proxy-upgrade-web
  spa_served proxy-upgrade-web "this commit's override and site block"
  routes_to_server proxy-upgrade-web "this commit's override and site block"
}

# upgrades <list> <label>: the upgrade tests, unless the list of upgrade boundaries <list> has an
# entry whose condition holds: then a new stack, and a line naming the upgrade tests it skips.
upgrades() {
  local links name
  links=$(boundaries_crossed "$1")
  if [[ -n $links ]]; then
    new_stack "$2"
    echo "self-host-test: $2: across the upgrade boundaries $(paste -sd ' ' - <<<"$links"), a new stack;" \
      "skipped the upgrade tests: $upgrade_tests"
    return
  fi
  upgrade_from_last_release
  upgrade_down
  proxy_upgrade_from_last_release
  for name in proxy-upgrade-web proxy-upgrade proxy-last-release; do stack_down "$name"; done
}

# The list of upgrade boundaries: each entry's link is to a heading of the guide's upgrade section.
boundary_list=script/lib/self-host/upgrade-boundaries
upgrade_anchors=$(guide_section upgrade | section_anchors)
if [[ ! -f $boundary_list ]]; then
  fail "no list of upgrade boundaries: $boundary_list"
  : >"$work/no-boundaries"
  boundary_list=$work/no-boundaries
fi
while read -r link condition; do
  if [[ -z $link || $link == \#* ]]; then continue; fi
  [[ -n $condition ]] || fail "$boundary_list: the entry $link has no condition"
  if [[ $link != docs/self-host.md#* ]] || ! grep -qxF -- "${link#*#}" <<<"$upgrade_anchors"; then
    fail "$boundary_list: $link is not a heading of the guide's upgrade section"
  fi
done <"$boundary_list"
fake_link=docs/self-host.md#$(head -n 1 <<<"$upgrade_anchors")
{
  cat "$boundary_list"
  echo "$fake_link true"
} >"$work/boundaries-hold"
{
  cat "$boundary_list"
  echo "$fake_link false"
} >"$work/boundaries-not"

if [[ -n $release_ready ]]; then
  # A fake boundary whose condition holds: a new stack, the upgrade tests skipped and named.
  upgrades "$work/boundaries-hold" boundary >"$work/boundary-output"
  said=$(cat "$work/boundary-output")
  [[ $said == *"$fake_link"* ]] || fail "boundary: across a fake boundary, the part does not name it:"$'\n'"$said"
  for test in $upgrade_tests; do
    [[ $said == *"skipped the upgrade tests: "*"$test"* ]] ||
      fail "boundary: across a fake boundary, the part does not name the skipped upgrade test $test:"$'\n'"$said"
  done
  [[ -z $ran ]] || fail "boundary: across a fake boundary, the part runs upgrade tests:$ran"
  # A fake boundary whose condition does not hold: the upgrade tests run.
  [[ $(boundaries_crossed "$work/boundaries-not") == "$(boundaries_crossed "$boundary_list")" ]] ||
    fail "upgrade: a boundary whose condition does not hold counts"
  upgrades "$work/boundaries-not" upgrade
  if [[ -z $(boundaries_crossed "$boundary_list") && " $ran " != *" last-release "* ]]; then
    fail "upgrade: with a fake boundary whose condition does not hold, the upgrade tests do not run"
  fi
fi

# --- postgres-rc: a stack on the PostgreSQL release candidate the compose file first pinned, moved by
# the guide's upgrade to the compose file's PostgreSQL.
# postgres_runs <scenario> <image> <when>: after <when>, the stack's PostgreSQL runs from <image>.
postgres_runs() {
  local id image
  if ! id=$(container "$1" "$postgres_image"); then
    fail "$1: after $3, PostgreSQL does not run"
    return
  fi
  image=$(m docker inspect --format '{{.Config.Image}}' "$id")
  [[ $image == "$2" ]] || fail "$1: after $3, PostgreSQL runs from $image, not $2"
}
scenario postgres-rc release :rc_files files web-files web env github :before_up up :wait_https
rc_ok=
if run_scenario postgres-rc <<<"$github_secret"; then
  postgres_runs postgres-rc "$postgres_rc" "its first up"
  if sign_in postgres-rc ada-machine GitHub; then
    creates_spaces postgres-rc ada-machine willow
    rc_ok=1
  fi
fi
check_env postgres-rc
if [[ -n $rc_ok ]]; then
  put_attachments postgres-rc notes "self-host-test-rc-$(openssl rand -hex 8)"
  rc_files=$(attachment_files postgres-rc)
  rc_listing=$(listing postgres-rc/ada-machine)
  scenario postgres-rc-upgrade ":resume postgres-rc" release image-check web-files backup web upgrade :before_up up \
    :wait_https
  with_backup postgres-rc-upgrade "$backups/skald-rc-backup"
  if run_scenario postgres-rc-upgrade </dev/null; then
    postgres_runs postgres-rc-upgrade "$postgres_pinned" "the guide's upgrade"
    has_files postgres-rc-upgrade /self-host/files "the guide's upgrade"
    caddy_restarted postgres-rc-upgrade "the guide's upgrade"
    lists_as_before postgres-rc-upgrade postgres-rc/ada-machine "the move to $postgres_pinned" "$rc_listing"
    [[ $(attachment_files postgres-rc-upgrade) == "$rc_files" ]] ||
      fail "postgres-rc-upgrade: after the move to $postgres_pinned, the attachments volume holds other files"
  fi
  check_env postgres-rc-upgrade
fi
stack_down postgres-rc-upgrade
stack_down postgres-rc

finish
