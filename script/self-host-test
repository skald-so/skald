# This commit's web app, as a release holds it: its archive and checksum by script/release-web, in
# $work/machine/web/build, with an attestation that attests nothing, `{}`; in
# $work/machine/web/mismatch, the same with a checksum of other bytes. The archive's files, unpacked,
# in $work/web/files; the SHA-256 of each that is not empty, `<SHA-256> <path>` lines in
# $work/web/hashes.
mkdir -p "$work/machine/web/build" "$work/machine/web/mismatch" "$work/web/files"
if ! said=$(script/release-web "$work/machine/web/build" 2>&1); then
  echo "self-host-test: script/release-web cannot build this commit's web app:"$'\n'"$said" >&2
  exit 1
fi
echo '{}' >"$work/machine/web/build/$web_archive.sigstore.json"
cp "$work/machine/web/build/$web_archive" "$work/machine/web/build/$web_archive.sigstore.json" \
  "$work/machine/web/mismatch/"
echo "$(printf 'other bytes' | sha256)  $web_archive" >"$work/machine/web/mismatch/$web_archive.sha256"
tar -xzf "$work/machine/web/build/$web_archive" -C "$work/web/files"
(cd "$work/web/files" && find . -type f -size +0 | sort | while read -r file; do
  echo "$(sha256 <"$file") ${file#./}"
done) >"$work/web/hashes"
web_index=$(sed -n 's/ index\.html$//p' "$work/web/hashes")
web_asset=$(grep -m 1 ' assets/' "$work/web/hashes" || true)
if [[ -z $web_index || -z $web_asset ]]; then
  echo "self-host-test: this commit's web app has no index.html or no file in assets/:"$'\n'"$(cat "$work/web/hashes")" >&2
  exit 1
fi
cat >"$work/machine/params" <<EOF
self_host_domain=$domain
self_host_image=skald-server:self-host-test
self_host_version=$version
self_host_digest=$release_digest
self_host_files=file:///self-host/files
