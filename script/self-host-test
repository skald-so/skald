#!/usr/bin/env bash
# Tests self-hosting by the guide, docs/self-host.md, on a clean machine: a disposable privileged
# container from script/lib/self-host/machine.Dockerfile, Debian with Docker and a dockerd of its own,
# where the stack takes ports 80 and 443 and the test's domain is in /etc/hosts. The machine runs this
# commit's skald, built for Linux by script/lib/self-host/client.Dockerfile, and this commit's
# skald-server image. The person signing in is a test in headless Chrome on the machine,
# script/lib/self-host/person.mjs.
#
# The guide's commands are in marked code blocks, fenced with the info string `<language>
# self-host=<step>`. The part extracts them and runs each scenario's steps in its order, in one bash
# with errexit and pipefail, in root's home directory; a step's blocks run in the guide's order. A
# marked block of a step no scenario runs fails it; so does a step without a block, whose scenarios
# still run without it. The steps:
#   release              the release values, in one place: SKALD_VERSION (X.Y.Z), SKALD_DIGEST
#                        (sha256:<hex>, the image's), SKALD_FILES (the address of the directory
#                        with the release's compose file and Caddy config) and SKALD_WEB (the address
#                        of the directory with the web app's archive skald-web.tar.gz, its
#                        skald-web.tar.gz.sha256 and skald-web.tar.gz.sigstore.json: for X.Y.Z,
#                        https://github.com/skald-so/skald/releases/download/vX.Y.Z); the part sets
#                        them after it
#   files                gets the compose file and Caddy config from $SKALD_FILES into the stack's
#                        directory, with curl
#   web-files            gets the web app's archive, its checksum and its attestation from $SKALD_WEB
#                        into the stack's directory
#   web-check            checks the archive against its checksum and its attestation, in a container,
#                        pinned to the release workflow .github/workflows/release.yml at the tag
#                        v$SKALD_VERSION; fails for any other archive
#   web                  puts the checked archive's web app in place in the stack's directory, which
#                        keeps it and from which the stack serves it
#   image-check          checks the image ghcr.io/skald-so/skald-server@$SKALD_DIGEST of the release
#                        $SKALD_VERSION, with the commands of infrastructure.md, "Trust in builds"
#   env                  writes .env, naming the image ghcr.io/skald-so/skald-server@$SKALD_DIGEST
#   bucket               adds the bucket's settings to .env; its secret key read from standard input
#   github               adds the GitHub OAuth App's client ID and secret to .env; the secret read
#                        from standard input
#   google               adds the Google OAuth client's ID and secret to .env; the secret read from
#                        standard input
#   sign-up              closes sign-up in .env: SKALD_SIGN_UP=closed and the lists of who may sign
#                        up, SKALD_SIGN_UP_GITHUB_LOGINS, SKALD_SIGN_UP_GOOGLE_EMAILS and
#                        SKALD_SIGN_UP_GOOGLE_DOMAINS, comma-separated
#   github-check         checks the server's GitHub sign-in with script/check-github-sign-in, after
#                        `up`
#   google-check         checks the server's Google sign-in with script/check-google-sign-in, after
#                        `up`
#   up                   starts the stack
#   status               checks the server with skald status
#   backup               backs the stack up into `<backup file>`, in the stack's directory, after `up`
#   restore              restores `<backup file>` into a new stack, in its directory, before its first
#                        `up`
#   upgrade              upgrades the stack, in its directory, to the release of the values of
#                        `release`, which runs before it: gets its compose file and Caddy config from
#                        $SKALD_FILES, names its image ghcr.io/skald-so/skald-server@$SKALD_DIGEST in
#                        .env and restarts the stack's Caddy, if it runs; after image-check,
#                        web-files, backup and web, then up
#   rollback             rolls the upgraded stack back, in its directory, to the release of the values
#                        of `release`, which runs before it: puts its compose file and Caddy config from
#                        $SKALD_FILES and its image ghcr.io/skald-so/skald-server@$SKALD_DIGEST in place
#                        and leaves the stack ready for `restore` of the backup from the upgrade, or
#                        stops, changing nothing, unless that backup is a gzip tar archive holding
#                        database.sql; then, for a release with the web app's archive, web-files,
#                        web-check and web, then restore and up
#   proxy-host           the proxy variant's .env for a proxy on the machine
#   proxy-host-site      the site block of a Caddy on the machine (Caddyfile)
#   proxy-join           the proxy variant's .env for a proxy in a container that joins the stack's
#                        network
#   proxy-join-connect   connects the proxy's container to the stack's network, after `up`; the
#                        proxy's default route stays on its own network
#   proxy-network        the proxy variant's .env for a proxy in a container on a network .env names
#   proxy-container-site the site block of a Caddy in a container (Caddyfile)
# The part substitutes only these, in every block: SKALD_VERSION, SKALD_DIGEST and SKALD_FILES, to
# the last release's version and image digest and this commit's files at the repository root, with
# the sign-in checks at their paths in script/; SKALD_WEB, to this commit's web app built by
# script/release-web, with an attestation of nothing, `{}`, so its stacks skip web-check, and for the
# last release's stack to its GitHub Release; in .env, this commit's image for
# ghcr.io/skald-so/skald-server@$SKALD_DIGEST; for the last release's stack and its rollback,
# SKALD_FILES, the last release's compose file and Caddy config from its tag, or this commit's with a
# comment line added when the tag has none, and in .env that release's image, pulled by its digest for linux/amd64, under a
# local name; for the stack on PostgreSQL's release candidate, SKALD_FILES, this commit's compose file
# with that PostgreSQL and its Caddy config, each with a comment line added; the test's domain for skald.example.com; the
# stand-ins' values for `<bucket endpoint>`, `<bucket region>`, `<bucket name>` and `<bucket access
# key ID>`, and its secret key on standard input; the stand-ins' client IDs for `<GitHub client ID>`
# and `<Google client ID>`, and their secrets on standard input, a line each, GitHub's first; the
# proxy's container for `<proxy container>`, its network for `<proxy network>`; the listed stand-in
# GitHub login for `<GitHub logins>`, the Google stand-in's email for `<Google emails>` and a domain
# no stand-in account has for `<Google domains>`. Before the sign-in
# checks, it exports GITHUB_URL and GOOGLE_ISSUER, the stand-ins' addresses, and SSL_CERT_FILE, the
# roots of the local ACME server and the test CA, and puts jq, which the checks need, on PATH.
#
# The stand-ins for the internet: Pebble, the local ACME server, a process on the machine with one
# root for the whole run, its random nonce refusals and validation delays off, behind a stand-in for
# Let's Encrypt's addresses; an S3-compatible server for the bucket; the GitHub stand-in and the OIDC
# stand-in, which plays Google, processes on the machine behind GitHub's and Google's stand-in
# addresses, github.self-host.test and oidc.self-host.test, the latter the issuer, with the callbacks
# on the domain. They serve HTTPS with certificates of a test CA. An override, added to COMPOSE_FILE
# before `up`, only gives the server's and Caddy's services that CA in SSL_CERT_FILE and the
# stand-ins' network, and the server the stand-ins' addresses in SKALD_GITHUB_URL,
# SKALD_GITHUB_API_URL and SKALD_GOOGLE_ISSUER; the compose file runs unchanged.
#
# Scenarios and checks:
#   main: release, files, image-check (the last release), env, up, status. .env has mode 0600 and the
#     output shows none of its secret values; `docker compose up` without any one of its values fails,
#     naming it, and starts no container. /health answers ok over HTTPS with the ACME server's
#     certificate for the domain, HTTP redirects to HTTPS, and skald status passes trusting only that
#     ACME server's root and fails trusting another CA. Only the Caddy container publishes ports, 80
#     and 443; the ports of PostgreSQL and the server do not answer on the machine's address, Caddy
#     does not reach PostgreSQL, and PostgreSQL does not reach the machine's address. The server's
#     container has a read-only root, no capabilities, no new privileges and a non-root user; a
#     volume at /var/lib/skald/attachments. PostgreSQL is 19; the images other than the server's are
#     pinned by digest; every container restarts unless stopped and rotates its logs with a size cap.
#     After `docker compose down` and `up`, and after the daemon restarts, the stack runs with the
#     same certificate and keeps its database and attachments.
#   bucket: release, files, env, bucket, up, status. The bucket's stand-in sees the server's check:
#     a write, a read and a delete in the bucket; the attachments volume stays empty; the output does
#     not show the secret key.
#   proxy-host, proxy-join, proxy-network: the proxy variant behind a stand-in for the admin's proxy,
#     Caddy with the guide's site block and a certificate from the ACME server: on the machine for the
#     loopback form; in a container on a network of its own, sorting after `skald`, that the guide's
#     command joins to the stack's network, its default route staying on its own network; in a
#     container on a network that exists before the stack. The stack publishes ports only on
#     loopback in the first form and not at all in the others, and port 8080 does not answer on the
#     machine's address; /health and skald status answer through the proxy. The stack's own Caddy
#     may run, to serve the web app behind the proxy.
#   backup: release, files, env, github, google, up. Machines sign in by device flow, one's person
#     with GitHub and another's with Google, and create spaces; files go into the attachments volume.
#     The guide's backup, the part's path for `<backup file>`, writes one file readable only by its
#     owner, holding the files and none of the secret values of .env; the server restarts for it;
#     after it, /health answers and the machines list the same devices and spaces. A backup to a full
#     disk fails, leaves no file there, and after it too.
#     With the attachments volume emptied, the guide's restore into that stack, whose database holds
#     data, fails and changes neither its database nor its volume.
#     Pasted into a shell through `bash -s` with a command after them, the backup and the refused
#     restore leave that command to the shell, which runs it.
#   restore-files: release, files, env, github, google; the stack's containers created and removed,
#     files in its attachments volume. The guide's restore fails, leaves the volume as it was and
#     the database without a table.
#   restored: release, files, env, github, google, restore of the backup, up. The machines, still
#     signed in, list the same devices and spaces, the attachments volume holds the same files, and
#     each machine creates a space and lists it.
#   bucket-backup, bucket-restored: as backup and restored with the bucket and GitHub: the backup
#     holds neither a file of the attachments volume nor an object of the bucket, the object stays,
#     and the restored stack's machine lists the same devices and spaces, its volume without a file.
#   The .env of each has mode 0600, and the output shows no secret value of it.
#   image: release and image-check with :edge's digest fail for its missing signature.
#   sign-in: release, files, env, github, google, up, github-check, google-check. Machines sign in
#     with this commit's skald by device flow, one's person with GitHub and another's with Google:
#     each account's first machine says it created the master key and holds its certificate, and
#     lists itself as this device, linked; each creates three team spaces, more than an account owns
#     in the cloud (architecture.md, "Cloud limits"), and lists them. The stack's containers' logs
#     show neither client secret.
#   github, google: release, files, env, the one provider's step, up, its check. The verification
#     page without a session offers sign-in with that provider only.
#   proxy-host also runs github and google before `up`, and github-check and google-check after it,
#     through the proxy; the stack's containers' logs show neither client secret.
#   The sign-in scenario's .env leaves sign-up open, the default: the server's log warns of it.
#   sign-up: release, files, env, github, sign-up, up, github-check. The listed GitHub login signs a
#     machine in by device flow; another GitHub user's sign-up is refused on the verification page,
#     whose callback answers 403 with a page naming https://skald.so/problems/sign-up-closed, and
#     that machine's skald sign-in ends within 30 s, failing and saying sign-up is closed. The
#     server's log has no warning of open sign-up, and the containers' logs show no client secret.
#   The .env of each of these has mode 0600, and the output shows no secret value of it.
#   Upgrades from the last release, the newest vX.Y.Z tag, whose image comes from GHCR and whose
#   skald for the machine comes from GitHub Releases, checked against its .sha256:
#   last-release: release (the last release's files), files, env, github, up; for a release whose
#     image has no attachments directory, the attachments volume made as this commit's image makes
#     it, owned by 65532 with mode 0700. Two machines sign in with the last release's skald, its
#     persons with two GitHub users, and create spaces; files go into the attachments volume.
#   upgrade: in that stack, release, image-check, backup, upgrade, up. This commit's server runs, the
#     stack has this commit's compose file and Caddy config, its Caddy started after the upgrade wrote
#     them, the backup is a file readable only by its owner, the volume holds the same files, the last
#     release's skald lists the same devices and spaces and creates a space. The guide's section of
#     the step upgrade names the backup before the step's block, and that before Start.
#   upgrade-client: this commit's skald, on a copy of the state of the last release's, lists that
#     machine as this device, linked, and its spaces, and creates a space.
#   rollback-refused, when this commit has a migration the last release lacks: the last release's
#     server, run on the upgraded database, exits with an error about migrations and changes neither
#     the database nor the volume.
#   rollback-missing, rollback-broken, rollback-no-database: in that stack, release (the last
#     release's files), rollback with a backup that is missing, truncated, or a gzip tar archive
#     without database.sql: the rollback fails and changes neither the database nor the volume.
#   rollback: in that stack, release (the last release's files), rollback, restore of the backup from
#     the upgrade, up. The stack has the last release's compose file and Caddy config; the database
#     and the volume are as before the upgrade; the last release's
#     server runs; the last release's skald, on its state that this commit's skald never opened,
#     lists the same devices and spaces and creates a space.
#   upgrade-restored: the backup from the upgrade restored into a new stack of this commit: the
#     volume holds the same files; this commit's skald, on copies of the machines' states from before
#     the upgrade, lists them and their spaces and creates a space.
#   Upgrade boundaries, script/lib/self-host/upgrade-boundaries: entries `<link> <condition>`, the
#     link `docs/self-host.md#<anchor>` to a heading of the guide's section of the step upgrade, the
#     condition a bash command run in the repository root with $last_release, the last release's
#     tag, holding when it exits 0. Across an entry whose condition holds, the part brings up a new
#     stack of this commit, release, files, env, github, up, status, and names the upgrade tests it
#     skips. With a fake entry whose condition holds, it does so and runs none of them; with one whose
#     condition does not hold, they run.
#   postgres-rc: release (this commit's compose file with the PostgreSQL release candidate it first
#     pinned), files, env, github, up; a machine signs in with this commit's skald and creates spaces,
#     files in the volume. postgres-rc-upgrade: release, image-check, backup, upgrade, up: the stack
#     has this commit's compose file and Caddy config, PostgreSQL runs the compose file's image, the
#     machine lists the same devices and spaces, the volume holds
#     the same files.
#   The .env of each has mode 0600, and the output shows no secret value of it.
# infrastructure.md's "Deployment" no longer says migrations are backward compatible only and says
# how a rollback goes; the guide's section of the step rollback links to infrastructure.md.
# README's "Self-hosting" and infrastructure.md's "Self-host" link to the guide. The guide names the
# GitHub and Google callbacks on the domain.
#
# The web app: every stack of this commit runs web-files and web after files. Where the part checks
# it, the domain serves this commit's web app over HTTPS, its index page at its pages and at an
# unknown path, and its files, each with a Content-Security-Policy that admits only its own origin
# and no framing; GET of every path of the OpenAPI spec answers as the server does, never with the
# web app.
#   spa: release, files, web-files, web, env, github, up. The stack's directory keeps the web app;
#     the person, in headless Chrome, opens its pages without a session and gets the sign-in page,
#     breaking no rule of the policy; signs up in one click with GitHub; a machine signs in by device
#     flow; the cabinet's Machines shows it linked, Members the person as the personal space's
#     admin, Usage no limit; Revoke on the machine's CLI session in Access, and skald devices there
#     fails.
#   proxy-host, proxy-join, proxy-network: also web-files, web and github; through the proxy, the
#     web app and the spec's paths as above, and the person signs in to the web app. The guide's site
#     blocks serve no file.
#   web-mismatch, web-unattested: release, files, web-files, web-check, web with this commit's
#     archive and a checksum of other bytes, or its checksum and the attestation of nothing: the steps
#     fail before web, the latter at web-check, and the stack's directory holds no file of the
#     archive. Once the last release has the archive, web-release: these steps pass for it and unpack
#     it; web-other-release, web-other-workflow: they fail at web-check for it checked as v0.0.1's,
#     or against .github/workflows/edge.yml, unpacking nothing. Until then, the part names the check
#     skipped.
#   The upgrade tests also: after upgrade, the stack serves this commit's web app; after rollback, /
#     and /machines answer as before the upgrade. proxy-last-release: the last release's stack in
#     the proxy variant's loopback form, with its guide's proxy-host and proxy-host-site; proxy-upgrade:
#     the guide's upgrade, after which the API answers through the proxy; proxy-upgrade-web: this
#     commit's proxy-host and proxy-host-site, after which the web app and the API do.
#   The guide's sections of the steps upgrade and rollback link to the heading above the block of
#     the step web; that of upgrade also to a heading of the proxy variant's section.
#   architecture.md's "Components": its Frontend item says a self-hosted server serves the web app.
#
# The image check reaches ghcr.io and Sigstore; the upgrades, ghcr.io and GitHub Releases. Removes the containers, images and files it creates.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
# The bucket's S3-compatible server: the image of the attachment storage tests.
source script/lib/s3.sh

guide=docs/self-host.md
# The web app's archive in a release.
web_archive=skald-web.tar.gz
domain=skald.self-host.test
bucket_endpoint=https://s3.self-host.test
bucket_region=us-east-1
bucket_name=skald-attachments
bucket_key_id=SELFHOSTTESTKEY
bucket_secret=$(openssl rand -hex 20)
proxy_container=skald-self-host-proxy
proxy_network=skald-self-host-proxy-network
# The stand-ins of GitHub and Google: their addresses, the clients registered with them, obviously
# fake, and the person each signs in.
github_host=github.self-host.test
google_host=oidc.self-host.test
github_client_id=Ov23li-self-host-stand-in
github_secret=$(openssl rand -hex 20)
google_client_id=self-host-stand-in.apps.googleusercontent.com
google_secret=$(openssl rand -hex 24)
github_user=4120711301
github_login=ada-self-host
# A second GitHub user, whose login no list names.
github_other_user=4120711302
github_other_login=bob-self-host
google_subject=110248495921238990301
google_email=grace.self-host@example.com
work=$(mktemp -d)
tag=self-host-test-$$
machine=
failures=0

cleanup() {
  if [[ -n $machine ]]; then
    docker rm --force --volumes "$machine" >/dev/null
  fi
  for image in "skald-server:$tag" "skald-self-host-machine:$tag" "skald-self-host-caddy:$tag" \
    "skald-self-host-browser:$tag"; do
    if docker image inspect "$image" >/dev/null 2>&1; then
      docker image rm "$image" >/dev/null
    fi
  done
  rm -rf "$work"
}
trap cleanup EXIT

fail() {
  echo "self-host-test: $*" >&2
  failures=$((failures + 1))
}

finish() {
  if [[ $failures -ne 0 ]]; then
    echo "self-host-test: $failures case(s) failed" >&2
    exit 1
  fi
  echo "self-host-test: all cases passed"
  exit 0
}

# sha256: the SHA-256 of standard input, in hex.
sha256() {
  if command -v sha256sum >/dev/null; then sha256sum; else shasum -a 256; fi | cut -d ' ' -f 1
}

# section <file> <heading>: the lines of <file> from the level-2 heading <heading> to the next one.
section() {
  awk -v heading="## $2" '
    $0 == heading { inside = 1; next }
    inside && /^## / { exit }
    inside { print }
  ' "$1"
}

# The links to the guide.
section README.md Self-hosting | grep -qF '](docs/self-host.md' ||
  fail "README's \"Self-hosting\" does not link to $guide"
section docs/dev/infrastructure.md Self-host | grep -qF '](../self-host.md' ||
  fail "infrastructure.md's \"Self-host\" does not link to $guide"
# The rule of migrations: infrastructure.md's "Deployment", its item and sub-items.
deployment=$(awk '/^- \*\*Deployment:\*\*/ { inside = 1; print; next } inside && /^- / { exit } inside { print }' \
  docs/dev/infrastructure.md)
[[ $deployment != *"backward compatible only"* ]] ||
  fail "infrastructure.md's \"Deployment\" still says migrations are backward compatible only"
grep -qiE 'roll ?back' <<<"$deployment" || fail "infrastructure.md's \"Deployment\" does not say how a rollback goes"

# extract_blocks <guide> <dir>: the guide's marked blocks: <dir>/<n>, in the guide's order, and
# their steps, `<n> <step>` lines in <dir>/list. A block in a list item drops its fence's indentation.
extract_blocks() {
  mkdir -p "$2"
  awk -v dir="$2" '
    !inside && /^ *(```|~~~)/ && /self-host/ {
      match($0, /^ */)
      indent = RLENGTH
      fence = substr($0, indent + 1, 3)
      step = ""
      words = split(substr($0, indent + 4), word, /[ \t]+/)
      for (i = 1; i <= words; i++) {
        if (word[i] ~ /^self-host=/) { step = substr(word[i], 11) }
      }
      n++
      file = sprintf("%s/%03d", dir, n)
      printf "" >file
      printf "%03d %s\n", n, (step == "" ? "?" : step) >(dir "/list")
      inside = 1
      next
    }
    inside && index($0, fence) && $0 ~ ("^ *" (fence == "```" ? "```" : "~~~") "[`~]* *$") {
      inside = 0
      close(file)
      next
    }
    inside {
      line = $0
      for (k = 0; k < indent && substr(line, 1, 1) == " "; k++) { line = substr(line, 2) }
      print line >>file
    }
  ' "$1"
  touch "$2/list"
}

if [[ ! -f $guide ]]; then
  fail "no self-host guide: $guide"
  finish
fi
for provider in github google; do
  grep -qF "https://skald.example.com/auth/$provider/callback" "$guide" ||
    fail "$guide does not name the callback https://skald.example.com/auth/$provider/callback"
done
extract_blocks "$guide" "$work/blocks"
before=$failures
steps='release files web-files web-check web image-check env bucket github google sign-up up status
  github-check google-check'
steps+=' proxy-host proxy-host-site proxy-join proxy-join-connect proxy-network proxy-container-site'
steps+=' backup restore'
steps+=' upgrade rollback'
while read -r n step; do
  # $steps unquoted: one word per step.
  # shellcheck disable=SC2086
  if [[ " $(echo $steps) " != *" $step "* ]]; then
    fail "$guide: a marked block of the step '$step', which the part does not run:"$'\n'"$(cat "$work/blocks/$n")"
  fi
done <"$work/blocks/list"
if [[ $failures -ne $before ]]; then
  finish
fi
# A step without a block fails the part; its scenarios still run, without it.
for step in $steps; do
  if ! grep -q " $step\$" "$work/blocks/list"; then
    fail "$guide: no block of the step $step"
  fi
done

# block_text <step> [<blocks>]: the guide's blocks of <step>, those of extract_blocks in <blocks>,
# this commit's guide's by default, with the part's substitutions.
block_text() {
  local n step text blocks=${2:-$work/blocks}
  while read -r n step; do
    if [[ $step == "$1" ]]; then
      text=$(cat "$blocks/$n")
      text=${text//skald.example.com/$domain}
      text=${text//"<bucket endpoint>"/$bucket_endpoint}
      text=${text//"<bucket region>"/$bucket_region}
      text=${text//"<bucket name>"/$bucket_name}
      text=${text//"<bucket access key ID>"/$bucket_key_id}
      text=${text//"<GitHub client ID>"/$github_client_id}
      text=${text//"<Google client ID>"/$google_client_id}
      text=${text//"<proxy container>"/$proxy_container}
      text=${text//"<proxy network>"/$proxy_network}
      text=${text//"<GitHub logins>"/$github_login}
      text=${text//"<Google emails>"/$google_email}
      text=${text//"<Google domains>"/no-account.self-host.test}
      printf '%s\n' "$text"
    fi
  done <"$blocks/list"
}

# The web app's release value: SKALD_WEB, the address of the directory with the release's archive,
# its checksum and its attestation, its GitHub Release's.
said=$(block_text release | sed "s|<version>|9.8.7|g" |
  bash -c 'eval "$(cat)" >/dev/null 2>&1; printf %s "${SKALD_WEB:-}"' 2>/dev/null || true)
[[ $said == https://github.com/skald-so/skald/releases/download/v9.8.7 ]] ||
  fail "$guide: the step release sets SKALD_WEB to '$said' for the release 9.8.7, not" \
    "https://github.com/skald-so/skald/releases/download/v9.8.7"
# The admin's proxy only passes requests to the stack: its site blocks serve no file.
for step in proxy-host-site proxy-container-site; do
  if block_text "$step" | grep -qE '^[[:space:]]*(root|file_server|try_files|templates)([[:space:]]|$)'; then
    fail "$guide: the proxy's site block of the step $step serves files:"$'\n'"$(block_text "$step")"
  fi
done
# architecture.md, "Components": the frontend's item says a self-hosted server serves it.
frontend=$(section docs/dev/architecture.md Components |
  awk '/^- \*\*Frontend\*\*/ { inside = 1; print; next } inside && /^- / { exit } inside { print }')
grep -qiE 'self-host' <<<"$frontend" ||
  fail "architecture.md's \"Components\" does not say a self-hosted server serves the web app on its domain"

# The last release, the image check's: the newest vX.Y.Z tag, its image's digest; and :edge's.
version=$(git tag --list 'v*' --sort=-version:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1 || true)
version=${version#v}
digest() {
  docker buildx imagetools inspect --format '{{json .Manifest}}' "ghcr.io/skald-so/skald-server:$1" |
    jq --raw-output --exit-status .digest
}
if [[ -z $version ]]; then
  fail "no release tag vX.Y.Z: fetch the tags"
  finish
fi
if ! release_digest=$(digest "$version") || ! edge_digest=$(digest edge); then
  fail "cannot read the digests of ghcr.io/skald-so/skald-server:$version and :edge"
  finish
fi
# The last release's web app: release_web, the address of its archive, checksum and attestation in
# its GitHub Release, when it has the archive; empty when it has none.
release_web=https://github.com/skald-so/skald/releases/download/v$version
status=$(curl --silent --location --retry 3 --output /dev/null --write-out '%{http_code}' --head \
  "$release_web/$web_archive" || true)
case $status in
  200) ;;
  404) release_web= ;;
  *)
    fail "cannot tell whether v$version has $web_archive: $release_web/$web_archive answers '$status'"
    finish
    ;;
esac

# This commit's server image and skald for Linux, the machine and the stand-ins.
docker build --quiet --file crates/server/Dockerfile --build-arg "REVISION=$(git rev-parse HEAD)" \
  --tag "skald-server:$tag" . >/dev/null
docker build --quiet --file script/lib/self-host/client.Dockerfile --output "$work/client" . >/dev/null
for target in machine caddy browser; do
  docker build --quiet --file script/lib/self-host/machine.Dockerfile --target "$target" \
    --tag "skald-self-host-$target:$tag" script/lib/self-host >/dev/null
done

# The test CA and the stand-ins' certificates: <name>.pem, <name>-key.pem in $work/machine/ca.
ca=$work/machine/ca
mkdir -p "$ca"
openssl req -new -newkey rsa:2048 -nodes -subj '/CN=skald self-host test CA' \
  -keyout "$ca/ca-key.pem" -out "$work/ca.csr" 2>/dev/null
printf 'basicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,cRLSign\nsubjectKeyIdentifier=hash\n' \
  >"$work/ca.ext"
openssl x509 -req -in "$work/ca.csr" -signkey "$ca/ca-key.pem" -days 2 -extfile "$work/ca.ext" \
  -out "$ca/ca.pem" 2>/dev/null
# certificate <name> <subjectAltName>: a server certificate of the test CA.
certificate() {
  openssl req -new -newkey rsa:2048 -nodes -subj "/CN=$1" -keyout "$ca/$1-key.pem" \
    -out "$work/$1.csr" 2>/dev/null
  printf 'subjectAltName=%s\nbasicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n' \
    "$2" >"$work/$1.ext"
  openssl x509 -req -in "$work/$1.csr" -CA "$ca/ca.pem" -CAkey "$ca/ca-key.pem" \
    -set_serial "0x$(openssl rand -hex 8)" -days 2 -extfile "$work/$1.ext" -out "$ca/$1.pem" 2>/dev/null
}
certificate pebble DNS:localhost,DNS:host.docker.internal,IP:127.0.0.1
certificate letsencrypt DNS:acme-v02.api.letsencrypt.org,DNS:acme-staging-v02.api.letsencrypt.org
certificate bucket "DNS:${bucket_endpoint#https://}"
certificate github "DNS:$github_host"
certificate google "DNS:$google_host"
chmod 0644 "$ca"/*.pem

