#!/usr/bin/env node
// Tests the job that deploys a stable release to production, the one job of all workflows that runs
// in the GitHub environment production, in .github/workflows/release.yml:
//   - it may run on a push of a stable release's tag, vX.Y.Z, and is skipped for a beta's,
//     vX.Y.Z-beta.N, for any other push, for a PR and for a manual run, on a tag ref too;
//   - it runs only after the release check, the job that calls release-check.yml, succeeds: when that
//     job fails, it is skipped;
//   - deploys run one at a time: the runs of every release share its concurrency group, and a running
//     deploy is never cancelled;
//   - its token, and that of every job it needs that the release check does not, has its permissions
//     set and writes nothing;
//   - it reads the environment's secrets, PRODUCTION_SSH_KEY (the private key, base64 on one line),
//     PRODUCTION_SSH_HOST_KEY (`<type> <base64>`) and PRODUCTION_SSH_DESTINATION
//     (ssh://<account>@<address>:<port>), and no other secret but GITHUB_TOKEN; it never reads all
//     secrets at once; no other job of any workflow reads them;
//   - the workflow names no connection detail: neither the job, the jobs it needs that the release
//     check does not, nor the scripts in script/ their steps run name an SSH URL, an account at a
//     host, an IP address, a host key or a host under skald.so but the public ones;
//   - its jobs, run as GitHub runs them with stand-ins for ssh and gh: with production set up
//     (GitHub's API, through gh, has the environment, and its secrets are set), a push of a stable
//     release's tag runs `ssh` once, from that job, to the destination as the key, pinning the host
//     key, with the command `deploy <X.Y.Z>`, and passes when the deploy passes; it fails when the
//     deploy fails or SSH does; its log shows the deploy's output, the version, the digest and the
//     health check result, and none of the secrets; while production is not set up (the API answers
//     404, and no secret is set), the job is skipped, nothing is deployed and the run passes; another
//     answer of the API fails the run and deploys nothing; a beta's tag and a manual run deploy
//     nothing.
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { reporter } from './lib/report.mjs';
import { commitAll, runJobs } from './lib/run-jobs.mjs';
import {
  allNeeds,
  commands,
  event,
  isUnknown,
  open,
  jobsFor,
  needsOf,
  permissions,
  readWorkflows,
  template,
  toText,
  unpublishedEvents,
  usesStatus,
  writes,
} from './lib/workflows.mjs';

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
const releaseFile = '.github/workflows/release.yml';
const environment = 'production';
const secretNames = ['PRODUCTION_SSH_DESTINATION', 'PRODUCTION_SSH_HOST_KEY', 'PRODUCTION_SSH_KEY'];
const { fail, done } = reporter('production-deploy-workflow-test');

const workflows = readWorkflows(root);
const release = workflows[releaseFile];
if (!release) {
  console.error(`production-deploy-workflow-test: ${releaseFile} is missing`);
  process.exit(1);
}
const jobs = release.jobs ?? {};
const envOf = (j) => (j?.environment && typeof j.environment === 'object' ? j.environment.name : j?.environment);
const everyJob = Object.entries(workflows).flatMap(([file, workflow]) =>
  Object.entries(workflow.jobs ?? {}).map(([key, job]) => ({ file, key, job })),
);

// The deploy job.
const deployers = everyJob.filter(({ job }) => {
  const name = envOf(job);
  return typeof name === 'string' && (name.toLowerCase() === environment || name.includes('${{'));
});
if (deployers.length !== 1 || deployers[0].file !== releaseFile || envOf(deployers[0].job) !== environment) {
  fail(
    `one job of all workflows runs in the environment ${environment}, a job of ${releaseFile}, not: ${
      deployers.map(({ file, key, job }) => `${file} job ${key} (${envOf(job)})`).join(', ') || 'none'
    }`,
  );
  done();
}
const key = deployers[0].key;
const job = jobs[key];

// The events it may run on.
for (const ref of ['refs/tags/v1.2.3', 'refs/tags/v0.10.0']) {
  if (jobsFor(release, event('push', ref))[key].skipped) fail(`a push of ${ref}, a stable release's tag, skips job ${key}`);
}
for (const [name, ref] of [
  ['push', 'refs/tags/v1.2.3-beta.1'],
  ['push', 'refs/tags/v0.41.0-beta.12'],
  ['workflow_dispatch', 'refs/heads/main'],
  ...unpublishedEvents,
]) {
  if (!jobsFor(release, event(name, ref))[key].skipped) fail(`a ${name} on ${ref} deploys nothing, but job ${key} may run`);
}

// After the release check: when it fails, every job that needs it is skipped, unless its condition
// calls a status function.
const checkers = Object.keys(jobs).filter((k) => String(jobs[k].uses ?? '') === './.github/workflows/release-check.yml');
if (checkers.length !== 1) fail(`one job of ${releaseFile} calls release-check.yml, not: ${checkers.join(', ') || 'none'}`);
const checker = checkers[0];
if (checker) {
  const needs = allNeeds(jobs, key);
  if (!needs.has(checker)) fail(`job ${key} does not need the release check, job ${checker}`);
  // The jobs between the release check and the deploy, and the deploy: when the check fails, each is
  // skipped if a job it needs failed or was skipped and its condition calls no status function.
  const outcome = { [checker]: 'failure' };
  const visit = (k) => {
    if (k in outcome) return outcome[k];
    const direct = needsOf(jobs[k]);
    const results = direct.map(visit);
    outcome[k] = !usesStatus(jobs[k].if) && results.some((r) => r === 'failure' || r === 'skipped') ? 'skipped' : 'may run';
    return outcome[k];
  };
  if (needs.has(checker) && visit(key) !== 'skipped') fail(`job ${key} may run when the release check, job ${checker}, fails`);
}

// One at a time: the same group for every release, known before the run; a running deploy stays.
const groups = new Set();
for (const ref of ['refs/tags/v1.2.3', 'refs/tags/v1.3.0', 'refs/tags/v2.0.0']) {
  const ev = event('push', ref);
  const state = jobsFor(release, ev)[key].scope;
  const scope = { ...state, contexts: { ...state.contexts, github: open({ ...ev.github, workflow: release.name }) } };
  const concurrency = job.concurrency ?? release.concurrency;
  const group = typeof concurrency === 'object' && concurrency !== null ? concurrency.group : concurrency;
  const value = group === undefined ? undefined : template(String(group), scope);
  if (value === undefined || isUnknown(value) || toText(value).trim() === '') {
    fail(`on a push of ${ref}, job ${key} has no concurrency group known before the run: ${JSON.stringify(group ?? null)}`);
    continue;
  }
  groups.add(toText(value));
  const cancel = typeof concurrency === 'object' && concurrency !== null ? concurrency['cancel-in-progress'] : undefined;
  const cancels = cancel === undefined ? false : template(String(cancel), scope);
  if (isUnknown(cancels) || !['false', ''].includes(toText(cancels))) {
    fail(`on a push of ${ref}, a newer deploy may cancel a running one: cancel-in-progress is ${JSON.stringify(cancel)}`);
  }
}
if (groups.size > 1) fail(`deploys of different releases run at once: their concurrency groups differ: ${[...groups].join(', ')}`);

// The token: the deploy job's, and that of every job it needs that the release check does not.
const own = [...allNeeds(jobs, key)].filter((k) => !checker || (k !== checker && !allNeeds(jobs, checker).has(k)));
for (const k of [key, ...own]) {
  const p = permissions(release, jobs[k]);
  if (p === null) fail(`job ${k}: its permissions are not set`);
  else if (p.all || writes(p).length > 0) fail(`job ${k}: its token writes ${p.all ? `${p.all}-all` : writes(p).join(', ')}, not nothing`);
}

// The secrets.
const named = (value) =>
  [...JSON.stringify(value ?? null).matchAll(/secrets\s*(?:\.\s*([A-Za-z0-9_]+)|\[\s*'([^']+)'\s*\])/gi)].map((m) => (m[1] ?? m[2]).toUpperCase());
const read = [...new Set(named(job))].filter((s) => s !== 'GITHUB_TOKEN').sort();
if (JSON.stringify(read) !== JSON.stringify(secretNames)) {
  fail(`job ${key} reads the secrets ${secretNames.join(', ')} and no other, not: ${read.join(', ') || 'none'}`);
}
const expressionsOf = (value) => [...JSON.stringify(value ?? null).matchAll(/\$\{\{([\s\S]*?)\}\}/g)].map((m) => m[1]);
const conditionsOf = (value) =>
  value && typeof value === 'object'
    ? Object.entries(value).flatMap(([k, v]) => (k === 'if' && typeof v === 'string' ? [v] : conditionsOf(v)))
    : [];
if (
  [...expressionsOf(job), ...conditionsOf(job)].some((e) =>
    /\bsecrets\b/i.test(e.replace(/\bsecrets\s*(?:\.\s*[A-Za-z0-9_]+|\[\s*'[^']+'\s*\])/gi, '')),
  )
) {
  fail(`job ${key} reads all secrets at once`);
}
for (const entry of everyJob) {
  if (entry.file === releaseFile && entry.key === key) continue;
  const others = named(entry.job).filter((s) => secretNames.includes(s));
  if (others.length > 0) fail(`${entry.file} job ${entry.key} reads ${others.join(', ')}; only job ${key} does`);
}

// No connection detail.
const publicHosts = new Set(['skald.so', 'api.skald.so', 'app.skald.so', 'docs.skald.so', 'dev.skald.so']);
const details = (text) => {
  const found = [];
  for (const [what, pattern] of [
    ['an SSH URL', /ssh:\/\/[A-Za-z0-9[]\S*/g],
    ['an account at a host', /\b[A-Za-z0-9._-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g],
    ['an IPv4 address', /(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])/g],
    ['an IPv6 address', /\b(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}\b/gi],
    ['a host key', /\b(?:ssh-(?:ed25519|rsa|dss)|ecdsa-sha2-nistp\d+|sk-[a-z0-9-]+@openssh\.com)\s+AAAA\S*/g],
  ]) {
    for (const m of text.matchAll(pattern)) found.push(`${what}: ${m[0]}`);
  }
  for (const m of text.matchAll(/\b(?:[a-z0-9-]+\.)+skald\.so\b/gi)) {
    if (!publicHosts.has(m[0].toLowerCase())) found.push(`a host: ${m[0]}`);
  }
  return found;
};
const withoutUses = (value) =>
  Array.isArray(value)
    ? value.map(withoutUses)
    : value && typeof value === 'object'
      ? Object.fromEntries(Object.entries(value).filter(([k]) => k !== 'uses').map(([k, v]) => [k, withoutUses(v)]))
      : value;
const scripts = new Set();
for (const k of [key, ...own]) {
  for (const found of details(JSON.stringify(withoutUses(jobs[k])))) fail(`job ${k} names a connection detail, ${found}`);
  for (const step of jobs[k].steps ?? []) {
    for (const line of commands(step.run)) for (const m of line.matchAll(/(?:^|[\s;&|("'/])(script\/[A-Za-z0-9._/-]+)/g)) scripts.add(m[1]);
  }
}
for (const script of scripts) {
  const file = path.join(root, script);
  if (!fs.existsSync(file) || !fs.statSync(file).isFile()) continue;
  for (const found of details(fs.readFileSync(file, 'utf8'))) fail(`${script}, which job ${key} or a job it needs runs, names a connection detail, ${found}`);
}

// The jobs, run.
const tmp = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'production-deploy-workflow-test.')));
process.on('exit', () => fs.rmSync(tmp, { recursive: true, force: true }));
const bin = path.join(tmp, 'bin');
const keys = path.join(tmp, 'keys');
const state = path.join(tmp, 'state.json');
const calls = path.join(tmp, 'calls.jsonl');
fs.mkdirSync(bin);
fs.mkdirSync(keys);
for (const name of ['client', 'host']) {
  execFileSync('ssh-keygen', ['-q', '-t', 'ed25519', '-N', '', '-C', name, '-f', path.join(keys, name)]);
}
const privateKey = fs.readFileSync(path.join(keys, 'client'), 'utf8');
const publicKey = fs.readFileSync(path.join(keys, 'client.pub'), 'utf8').split(' ').slice(0, 2).join(' ');
const hostKey = fs.readFileSync(path.join(keys, 'host.pub'), 'utf8').split(' ').slice(0, 2).join(' ');
const account = os.userInfo().username;
const address = '203.0.113.71';
const port = '2201';
const secrets = {
  PRODUCTION_SSH_KEY: Buffer.from(privateKey).toString('base64'),
  PRODUCTION_SSH_HOST_KEY: hostKey,
  PRODUCTION_SSH_DESTINATION: `ssh://${account}@${address}:${port}`,
};
const digest = `sha256:${'7c'.repeat(32)}`;

// ssh: records each call, as SSH would make it, to $calls: the job, the destination, the command,
// the options of -o and -F, and the contents, at the call, of the identity files and the known hosts
// files, and the keys of the agent; then answers as the deploy command over it would, or as a failed
// connection, as $state says.
fs.writeFileSync(
  path.join(bin, 'ssh'),
  `#!/usr/bin/env node
const fs = require('node:fs');
const { spawnSync } = require('node:child_process');
const state = JSON.parse(fs.readFileSync(${JSON.stringify(state)}, 'utf8'));
const args = process.argv.slice(2);
const withValue = 'BbcDEeFIiJLlmOoPpQRSWw';
const options = {};
const flags = [];
const identities = [];
let config = null;
let i = 0;
const set = (text) => {
  const m = text.match(/^\\s*([A-Za-z]+)\\s*(?:=|\\s)\\s*(.*?)\\s*$/);
  if (!m) return;
  const k = m[1].toLowerCase();
  if (k === 'identityfile') identities.push(m[2].replace(/^"(.*)"$/, '$1'));
  else if (!(k in options)) options[k] = m[2].replace(/^"(.*)"$/, '$1');
};
for (; i < args.length; i++) {
  const a = args[i];
  if (a === '--') { i++; break; }
  if (!a.startsWith('-') || a === '-') break;
  for (let j = 1; j < a.length; j++) {
    const f = a[j];
    if (withValue.includes(f)) {
      const v = j + 1 < a.length ? a.slice(j + 1) : args[++i];
      if (f === 'o') set(v);
      else if (f === 'i') identities.push(v);
      else if (f === 'F') config = v;
      else if (f === 'p') options.port ??= v;
      else if (f === 'l') options.user ??= v;
      else flags.push('-' + f + ' ' + v);
      break;
    }
    flags.push('-' + f);
  }
}
if (config && fs.existsSync(config)) {
  for (const line of fs.readFileSync(config, 'utf8').split('\\n')) {
    if (!/^\\s*(host|match)\\b/i.test(line) && !/^\\s*#/.test(line)) set(line);
  }
}
const destination = args[i];
const command = args.slice(i + 1).join(' ');
const read = (f) => { try { return fs.readFileSync(f.replace(/^~(?=\\/)/, process.env.HOME), 'utf8'); } catch { return null; } };
const knownHosts = (options.userknownhostsfile ?? '').split(/\\s+/).filter(Boolean).map(read);
let agent = '';
if (process.env.SSH_AUTH_SOCK) agent = spawnSync('ssh-add', ['-L'], { encoding: 'utf8' }).stdout ?? '';
fs.appendFileSync(${JSON.stringify(calls)}, JSON.stringify({
  job: process.env.GITHUB_JOB ?? null, destination, command, options, flags,
  identities: identities.map(read), knownHosts, agent,
}) + '\\n');
if (state.ssh === 'unreachable') process.exit(255);
const version = command.replace(/^deploy /, '');
console.log('deploy: version ' + version);
console.log('deploy: digest ${digest}');
if (state.ssh === 'fails') {
  console.log('deploy: health check: HTTP 502');
  console.log('deploy: FAILED: health check');
  process.exit(1);
}
console.log('deploy: health check: ok');
console.log('deploy: passed');
`,
  { mode: 0o755 },
);
// gh: GitHub's API on the environment production, or the list of environments, as $state says: set
// up, 404, or 500; --jq and -q filter the answer with jq. Anything else fails, recorded.
fs.writeFileSync(
  path.join(bin, 'gh'),
  `#!/usr/bin/env node
const fs = require('node:fs');
const { spawnSync } = require('node:child_process');
const state = JSON.parse(fs.readFileSync(${JSON.stringify(state)}, 'utf8'));
const args = process.argv.slice(2);
const record = (what) => fs.appendFileSync(${JSON.stringify(calls)}, JSON.stringify({ gh: args, what }) + '\\n');
let filter = null;
const rest = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--jq' || args[i] === '-q') filter = args[++i];
  else if (args[i].startsWith('--jq=')) filter = args[i].slice(5);
  else if (['-X', '--method'].includes(args[i])) { if (args[++i].toUpperCase() !== 'GET') rest.push('write'); }
  else if (['-H', '--header'].includes(args[i])) i++;
  else if (args[i] !== '--silent' && args[i] !== '--paginate') rest.push(args[i]);
}
const at = (rest[1] ?? '').replace(/^\\//, '').replace(/^https:\\/\\/api\\.github\\.com\\//, '').replace(/\\?.*$/, '');
const environment = {
  id: 1, name: 'production', can_admins_bypass: false,
  protection_rules: [
    { id: 1, type: 'required_reviewers', prevent_self_review: false, reviewers: [{ type: 'User', reviewer: { login: 'octocat', id: 1 } }] },
    { id: 2, type: 'branch_policy' },
  ],
  deployment_branch_policy: { protected_branches: false, custom_branch_policies: true },
};
const others = ['github-pages', 'move-main', 'npm', 'staging'].map((name, n) => ({ id: n + 2, name, protection_rules: [] }));
let answer;
if (rest[0] === 'api' && rest.length === 2 && at === 'repos/skald-so/skald/environments/production') answer = environment;
else if (rest[0] === 'api' && rest.length === 2 && at === 'repos/skald-so/skald/environments') {
  const list = state.gh === 'set-up' ? [...others, environment] : others;
  answer = { total_count: list.length, environments: list };
} else {
  record('unexpected');
  console.error('gh: unexpected: gh ' + args.join(' '));
  process.exit(2);
}
record(at);
if (state.gh === '500') { console.error('gh: Server Error (HTTP 500)'); process.exit(1); }
if (state.gh === '404' && answer === environment) { console.error('gh: Not Found (HTTP 404)'); process.exit(1); }
if (filter === null) { console.log(JSON.stringify(answer)); process.exit(0); }
const r = spawnSync('jq', ['-r', filter], { input: JSON.stringify(answer), encoding: 'utf8' });
process.stdout.write(r.stdout ?? '');
process.stderr.write(r.stderr ?? '');
process.exit(r.status ?? 1);
`,
  { mode: 0o755 },
);
// ssh-keyscan: a host key read from the network is not pinned; recorded, and fails.
fs.writeFileSync(
  path.join(bin, 'ssh-keyscan'),
  `#!/usr/bin/env bash\necho '{"keyscan":true}' >>${JSON.stringify(calls)}\nexit 1\n`,
  { mode: 0o755 },
);

// The jobs run: the deploy job and the jobs it needs that run nothing but scripts and the checkout,
// such as the plan; the others, the builds, the publishing and the release check, succeed.
const action = (step) => String(step?.uses ?? '').split('@')[0].toLowerCase();
const simple = (k) =>
  !jobs[k].strategy &&
  jobs[k].uses === undefined &&
  (jobs[k].steps ?? []).every((s) => s.uses === undefined || action(s) === 'actions/checkout') &&
  writes(permissions(release, jobs[k])).length === 0;
const order = [];
const visit = (k) => {
  if (order.includes(k)) return;
  needsOf(jobs[k]).forEach(visit);
  if (k === key || simple(k)) order.push(k);
};
visit(key);

// run <event> <ref> <version> <world>: the jobs on <event> at <ref>, the workspace at <version>, with
// world.gh the API's answer, world.ssh the deploy's (passes, fails, unreachable) and world.secrets
// the environment's secrets; {results, problems, calls, log}.
const run = (eventName, ref, version, world) => {
  fs.writeFileSync(state, JSON.stringify(world));
  fs.writeFileSync(calls, '');
  const dir = fs.mkdtempSync(path.join(tmp, 'run.'));
  const work = path.join(dir, 'work');
  const runner = path.join(dir, 'runner');
  const home = path.join(dir, 'home');
  for (const d of [work, runner, home]) fs.mkdirSync(d);
  fs.symlinkSync(path.join(root, 'script'), path.join(work, 'script'));
  fs.symlinkSync(path.join(root, '.github'), path.join(work, '.github'));
  fs.writeFileSync(path.join(work, 'Cargo.toml'), `[workspace.package]\nversion = "${version}"\n`);
  const sha = commitAll(work, ref.startsWith('refs/tags/') ? ref.slice('refs/tags/'.length) : undefined);
  const { results, problems } = runJobs(release, order, {
    eventName,
    ref,
    version,
    sha,
    work,
    bin,
    runner,
    env: { HOME: home, TMPDIR: dir, SSH_AUTH_SOCK: '' },
    secrets: world.secrets,
    action: ({ step }) => (action(step) === 'actions/checkout' ? {} : { passed: false, problem: `the test has no stand-in for ${step.uses}` }),
  });
  const recorded = fs.readFileSync(calls, 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l));
  const log = Object.values(results).map((r) => r.log ?? '').join('\n') + problems.join('\n');
  return { results, problems, calls: recorded, log };
};
const failed = (r) => Object.entries(r.results).filter(([, x]) => x.result === 'failure').map(([k]) => k);
const sshCalls = (r) => r.calls.filter((c) => 'destination' in c);
const setUp = (ssh) => ({ gh: 'set-up', ssh, secrets });

// Set up, a stable release: one deploy of its version over the access, the host key pinned.
{
  const r = run('push', 'refs/tags/v0.10.0', '0.10.0', setUp('passes'));
  if (r.problems.length > 0 || failed(r).length > 0) fail(`set up, a push of v0.10.0 fails: ${r.problems.join('; ') || failed(r).join(', ')}`);
  if (r.results[key]?.result !== 'success') fail(`set up, a push of v0.10.0: job ${key} is ${r.results[key]?.result}, not success`);
  const ssh = sshCalls(r);
  if (ssh.length !== 1) fail(`set up, a push of v0.10.0 runs ssh ${ssh.length} times, not once`);
  for (const c of ssh) {
    if (c.job !== key) fail(`ssh runs in job ${c.job}, not in job ${key}`);
    if (c.command !== 'deploy 0.10.0') fail(`ssh runs '${c.command}', not 'deploy 0.10.0'`);
    let user = c.options.user;
    let host = c.options.hostname;
    let p = c.options.port ?? '22';
    const url = String(c.destination ?? '').match(/^ssh:\/\/(?:([^@/]+)@)?([^:/]+)(?::(\d+))?\/?$/);
    const plain = String(c.destination ?? '').match(/^(?:([^@]+)@)?([^@:]+)$/);
    const parts = url ?? plain;
    if (parts) {
      user = parts[1] ?? user;
      host = host ?? parts[2];
      if (url && parts[3]) p = parts[3];
    }
    if (`${user}@${host}:${p}` !== `${account}@${address}:${port}`) {
      fail(`ssh connects to ${user}@${host}:${p}, not to PRODUCTION_SSH_DESTINATION's account, address and port`);
    }
    if (String(c.options.stricthostkeychecking).toLowerCase() !== 'yes') {
      fail(`ssh does not pin the host key: StrictHostKeyChecking is ${c.options.stricthostkeychecking ?? 'unset'}, not yes`);
    }
    const pinned = c.knownHosts.filter(Boolean).join('\n');
    if (!pinned.split('\n').some((line) => line.includes(hostKey))) fail('ssh does not check the host key of PRODUCTION_SSH_HOST_KEY: no known hosts file it reads has it');
    if (pinned.split('\n').some((line) => /\S/.test(line) && !line.startsWith('#') && !line.includes(hostKey))) {
      fail('the known hosts files ssh reads trust another key than PRODUCTION_SSH_HOST_KEY');
    }
    const asKey = c.identities.some((content) => content !== null && content.trim() === privateKey.trim()) || c.agent.includes(publicKey);
    if (!asKey) fail('ssh does not authenticate with PRODUCTION_SSH_KEY: neither an identity file nor the agent has it');
  }
  if (r.calls.some((c) => c.keyscan)) fail('the run reads the host key from the network with ssh-keyscan');
  if (r.calls.some((c) => c.what === 'unexpected')) fail(`the run calls gh other than for the environment: ${r.calls.filter((c) => c.what === 'unexpected').map((c) => c.gh.join(' ')).join('; ')}`);
  for (const line of ['deploy: version 0.10.0', `deploy: digest ${digest}`, 'deploy: health check: ok']) {
    if (!r.log.includes(line)) fail(`the job's log does not show the deploy's output: ${line}`);
  }
  // The secrets, and each part of them that is not public on its own.
  const secretParts = [
    ...Object.entries(secrets).map(([name, value]) => [name, value]),
    ['the private key', privateKey.trim()],
    ...privateKey.split('\n').filter((l) => l.length > 16 && !l.startsWith('-----')).map((l) => ['a line of the private key', l]),
    ['the host key', hostKey.split(' ')[1]],
    ['the address', address],
    ['the account at the address', `${account}@${address}`],
  ];
  for (const [what, value] of secretParts) if (r.log.includes(value)) fail(`the job's log shows ${what}`);
}

// Set up: a failed deploy or a failed connection fails the job.
for (const ssh of ['fails', 'unreachable']) {
  const r = run('push', 'refs/tags/v0.10.0', '0.10.0', setUp(ssh));
  if (sshCalls(r).length !== 1) fail(`set up, the deploy ${ssh}: ssh runs ${sshCalls(r).length} times, not once`);
  if (r.results[key]?.result !== 'failure') fail(`set up, the deploy ${ssh}: job ${key} is ${r.results[key]?.result}, not failure`);
}

// Not set up: the job is skipped, nothing is deployed, and the run passes.
{
  const r = run('push', 'refs/tags/v0.10.0', '0.10.0', { gh: '404', ssh: 'passes', secrets: {} });
  if (r.problems.length > 0 || failed(r).length > 0) fail(`with ${environment} not set up, a release's run fails: ${r.problems.join('; ') || failed(r).join(', ')}`);
  if (r.results[key]?.result !== 'skipped') fail(`with ${environment} not set up, job ${key} is ${r.results[key]?.result}, not skipped`);
  if (sshCalls(r).length > 0) fail(`with ${environment} not set up, the release is deployed`);
}
// Another answer of the API: the run fails, and nothing is deployed.
{
  const r = run('push', 'refs/tags/v0.10.0', '0.10.0', { gh: '500', ssh: 'passes', secrets });
  if (failed(r).length === 0) fail("with GitHub's API answering 500 on the environment, the run passes");
  if (sshCalls(r).length > 0) fail("with GitHub's API answering 500 on the environment, the release is deployed");
}

// A beta and a manual run deploy nothing.
for (const [name, ref, version] of [
  ['push', 'refs/tags/v0.11.0-beta.1', '0.11.0-beta.1'],
  ['workflow_dispatch', 'refs/tags/v0.10.0', '0.10.0'],
  ['workflow_dispatch', 'refs/heads/dev', '0.10.0'],
]) {
  const r = run(name, ref, version, setUp('passes'));
  if (sshCalls(r).length > 0) fail(`set up, a ${name} on ${ref} deploys`);
  if (r.results[key]?.result !== 'skipped') fail(`set up, a ${name} on ${ref}: job ${key} is ${r.results[key]?.result}, not skipped`);
}

done();
